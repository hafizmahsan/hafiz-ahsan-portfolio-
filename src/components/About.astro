---
/**
 * ============================================================
 * ABOUT / PROFESSIONAL PROFILE
 * ============================================================
 *
 * Presentation layer for the professional profile.
 *
 * Content is intentionally stored separately in:
 *
 *     src/data/about.ts
 *
 * This keeps the website easy to maintain for a non-technical
 * person.
 * ============================================================
 */

import SectionHeading from "./SectionHeading.astro";
import { about, aboutPrinciples } from "../data/about";
---

<section
  id="about"
  class="about-section section"
  aria-labelledby="about-title"
>
  <!-- ======================================================
       BACKGROUND
       ====================================================== -->

  <div
    class="about-background"
    aria-hidden="true"
  >
    <div class="about-grid"></div>

    <div class="about-glow about-glow-one"></div>
    <div class="about-glow about-glow-two"></div>

    <div class="about-particles">

      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>

    </div>
  </div>


  <div class="container">

    <SectionHeading
      eyebrow="03 / About"
      title="Engineering automation with a systems mindset."
      description="An RPA-focused technology professional building enterprise automation solutions while exploring the next generation of intelligent automation."
    />


    <!-- ====================================================
         PROFILE GRID
         ==================================================== -->

    <div class="about-layout">

      <!-- ==============================================
           PROFILE STATEMENT
           ============================================== -->

      <div class="about-profile">

        <div class="profile-terminal">

          <div class="terminal-header">

            <div class="terminal-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>

            <span class="terminal-title">
              profile.system
            </span>

            <span class="terminal-status">
              ONLINE
            </span>

          </div>


          <div class="terminal-body">

            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span>whoami</span>
            </div>


            <div class="terminal-output">
              {about.identity}
            </div>


            <div class="terminal-line terminal-line-spaced">
              <span class="terminal-prompt">$</span>
              <span>specialization</span>
            </div>


            <div class="terminal-output terminal-accent">
              {about.specialization}
            </div>


            <div class="terminal-line terminal-line-spaced">
              <span class="terminal-prompt">$</span>
              <span>experience</span>
            </div>


            <div class="terminal-output">
              {about.experience}
            </div>


            <div class="terminal-line terminal-line-spaced">
              <span class="terminal-prompt">$</span>
              <span>current_focus</span>
            </div>


            <div class="terminal-output terminal-accent">
              {about.currentFocus}
            </div>


            <span class="terminal-cursor"></span>

          </div>

        </div>


        <div class="about-description">

          {
            about.paragraphs.map((paragraph) => (
              <p>
                {paragraph}
              </p>
            ))
          }

        </div>

      </div>


      <!-- ==============================================
           PRINCIPLES / CAPABILITIES
           ============================================== -->

      <div class="about-principles">

        {
          aboutPrinciples.map((principle, index) => (
            <article class="principle-card">

              <div class="principle-number">
                {String(index + 1).padStart(2, "0")}
              </div>


              <div class="principle-content">

                <div class="principle-icon" aria-hidden="true">
                  <span></span>
                </div>


                <h3>
                  {principle.title}
                </h3>


                <p>
                  {principle.description}
                </p>

              </div>

            </article>
          ))
        }

      </div>

    </div>


    <!-- ====================================================
         SPECIALIZATION STRIP
         ==================================================== -->

    <div class="specialization-strip">

      <div class="strip-label">
        CORE ENGINEERING STACK
      </div>


      <div class="strip-items">

        <span>RPA</span>
        <span>AUTOMATION</span>
        <span>APIs</span>
        <span>SOLUTION ARCHITECTURE</span>
        <span>ENTERPRISE SYSTEMS</span>
        <span>GENAI</span>

      </div>

    </div>

  </div>
</section>


<style>
  /* ========================================================
     SECTION
     ======================================================== */

  .about-section {
    position:
      relative;

    overflow:
      hidden;
  }


  .about-background {
    position:
      absolute;

    inset:
      0;

    z-index:
      -1;

    pointer-events:
      none;
  }


  .about-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.2;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      65px 65px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 15%,
        black 80%,
        transparent
      );
  }


  .about-glow {
    position:
      absolute;

    width:
      32rem;

    height:
      32rem;

    border-radius:
      50%;

    filter:
      blur(140px);
  }


  .about-glow-one {
    top:
      10%;

    right:
      -20%;

    background:
      rgba(34, 211, 238, 0.035);
  }


  .about-glow-two {
    bottom:
      5%;

    left:
      -20%;

    background:
      rgba(139, 92, 246, 0.025);
  }


  /* ========================================================
     PARTICLES
     ======================================================== */

  .about-particles {
    position:
      absolute;

    top:
      18%;

    right:
      8%;

    width:
      180px;

    height:
      180px;

    opacity:
      0.4;
  }


  .about-particles span {
    position:
      absolute;

    width:
      3px;

    height:
      3px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 10px rgba(34, 211, 238, 0.5);

    animation:
      particle-float 5s ease-in-out infinite;
  }


  .about-particles span:nth-child(1) {
    top:
      10%;

    left:
      15%;
  }


  .about-particles span:nth-child(2) {
    top:
      25%;

    right:
      15%;

    animation-delay:
      -1s;
  }


  .about-particles span:nth-child(3) {
    top:
      50%;

    left:
      45%;

    background:
      var(--color-violet);

    animation-delay:
      -2s;
  }


  .about-particles span:nth-child(4) {
    bottom:
      20%;

    right:
      25%;

    animation-delay:
      -3s;
  }


  .about-particles span:nth-child(5) {
    bottom:
      8%;

    left:
      20%;

    background:
      var(--color-blue);

    animation-delay:
      -4s;
  }


  .about-particles span:nth-child(6) {
    top:
      65%;

    left:
      5%;

    animation-delay:
      -2.5s;
  }


  @keyframes particle-float {
    0%,
    100% {
      transform:
        translate(0, 0)
        scale(0.8);

      opacity:
        0.35;
    }

    50% {
      transform:
        translate(5px, -8px)
        scale(1.5);

      opacity:
        1;
    }
  }


  /* ========================================================
     MAIN LAYOUT
     ======================================================== */

  .about-layout {
    display:
      grid;

    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(280px, 0.9fr);

    gap:
      3rem;

    align-items:
      start;
  }


  /* ========================================================
     TERMINAL PROFILE
     ======================================================== */

  .profile-terminal {
    overflow:
      hidden;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(5, 9, 15, 0.72);

    box-shadow:
      0 20px 70px rgba(0, 0, 0, 0.18);
  }


  .terminal-header {
    display:
      flex;

    align-items:
      center;

    gap:
      0.8rem;

    min-height:
      42px;

    padding:
      0 1rem;

    border-bottom:
      1px solid var(--color-border);

    background:
      rgba(148, 163, 184, 0.018);
  }


  .terminal-dots {
    display:
      flex;

    gap:
      0.3rem;
  }


  .terminal-dots span {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    background:
      rgba(148, 163, 184, 0.2);
  }


  .terminal-dots span:first-child {
    background:
      rgba(239, 68, 68, 0.5);
  }


  .terminal-dots span:nth-child(2) {
    background:
      rgba(234, 179, 8, 0.5);
  }


  .terminal-dots span:nth-child(3) {
    background:
      rgba(34, 197, 94, 0.5);
  }


  .terminal-title {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.5rem;
  }


  .terminal-status {
    margin-left:
      auto;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.44rem;

    letter-spacing:
      0.06em;
  }


  .terminal-body {
    position:
      relative;

    min-height:
      330px;

    padding:
      1.5rem;

    font-family:
      var(--font-mono);

    font-size:
      0.58rem;

    line-height:
      1.7;
  }


  .terminal-line {
    display:
      flex;

    gap:
      0.55rem;

    color:
      var(--color-text-subtle);
  }


  .terminal-line-spaced {
    margin-top:
      1.15rem;
  }


  .terminal-prompt {
    color:
      var(--color-cyan);
  }


  .terminal-output {
    max-width:
      650px;

    padding-left:
      1rem;

    color:
      var(--color-text-muted);
  }


  .terminal-accent {
    color:
      var(--color-cyan);
  }


  .terminal-cursor {
    display:
      inline-block;

    width:
      6px;

    height:
      12px;

    margin-top:
      0.8rem;

    background:
      var(--color-cyan);

    opacity:
      0.7;

    animation:
      cursor-blink 1.1s step-end infinite;
  }


  @keyframes cursor-blink {
    0%,
    45% {
      opacity:
        0.7;
    }

    46%,
    100% {
      opacity:
        0;
    }
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .about-description {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.9rem;

    margin-top:
      1.5rem;

    max-width:
      720px;
  }


  .about-description p {
    margin:
      0;

    color:
      var(--color-text-muted);

    font-size:
      0.72rem;

    line-height:
      1.8;
  }


  .about-description p:first-child {
    color:
      var(--color-text);
  }


  /* ========================================================
     PRINCIPLES
     ======================================================== */

  .about-principles {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.8rem;
  }


  .principle-card {
    display:
      grid;

    grid-template-columns:
      34px 1fr;

    gap:
      0.9rem;

    padding:
      1.1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(148, 163, 184, 0.012);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard);
  }


  .principle-card:hover {
    transform:
      translateX(4px);

    border-color:
      rgba(34, 211, 238, 0.16);

    background:
      rgba(148, 163, 184, 0.025);
  }


  .principle-number {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;
  }


  .principle-content {
    position:
      relative;

    padding-left:
      1rem;

    border-left:
      1px solid var(--color-border);
  }


  .principle-icon {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      22px;

    height:
      22px;

    margin-bottom:
      0.7rem;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      50%;
  }


  .principle-icon span {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 9px var(--color-cyan);
  }


  .principle-card:nth-child(2) .principle-icon {
    border-color:
      rgba(59, 130, 246, 0.2);
  }


  .principle-card:nth-child(2) .principle-icon span {
    background:
      var(--color-blue);

    box-shadow:
      0 0 9px var(--color-blue);
  }


  .principle-card:nth-child(3) .principle-icon {
    border-color:
      rgba(139, 92, 246, 0.2);
  }


  .principle-card:nth-child(3) .principle-icon span {
    background:
      var(--color-violet);

    box-shadow:
      0 0 9px var(--color-violet);
  }


  .principle-content h3 {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.95rem;

    font-weight:
      500;

    letter-spacing:
      -0.025em;
  }


  .principle-content p {
    margin:
      0.45rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      0.62rem;

    line-height:
      1.65;
  }


  /* ========================================================
     SPECIALIZATION STRIP
     ======================================================== */

  .specialization-strip {
    display:
      grid;

    grid-template-columns:
      170px 1fr;

    gap:
      1.5rem;

    align-items:
      center;

    margin-top:
      4rem;

    padding:
      1rem 1.2rem;

    border-top:
      1px solid var(--color-border);

    border-bottom:
      1px solid var(--color-border);
  }


  .strip-label {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.47rem;

    letter-spacing:
      0.07em;
  }


  .strip-items {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.5rem;
  }


  .strip-items span {
    padding:
      0.35rem 0.5rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.45rem;

    letter-spacing:
      0.04em;
  }


  .strip-items span:not(:last-child)::after {
    content:
      " /";

    margin-left:
      0.5rem;

    color:
      var(--color-cyan);

    opacity:
      0.4;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 850px) {
    .about-layout {
      grid-template-columns:
        1fr;
    }

    .about-principles {
      display:
        grid;

      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

    .principle-card {
      grid-template-columns:
        1fr;
    }

    .principle-content {
      padding-left:
        0;

      padding-top:
        0.8rem;

      border-left:
        0;

      border-top:
        1px solid var(--color-border);
    }
  }


  @media (max-width: 650px) {
    .about-principles {
      grid-template-columns:
        1fr;
    }

    .principle-card {
      grid-template-columns:
        34px 1fr;
    }

    .principle-content {
      padding-left:
        1rem;

      padding-top:
        0;

      border-top:
        0;

      border-left:
        1px solid var(--color-border);
    }

    .specialization-strip {
      grid-template-columns:
        1fr;

      gap:
        0.8rem;
    }
  }


  @media (max-width: 500px) {
    .terminal-body {
      min-height:
        300px;

      padding:
        1.1rem;

      font-size:
        0.51rem;
    }

    .terminal-output {
      padding-left:
        0.8rem;
    }
  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor,
    .about-particles span {
      animation:
        none;
    }

    .principle-card {
      transition:
        none;
    }
  }
</style>
