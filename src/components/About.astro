---
/**
 * ============================================================
 * ABOUT SECTION
 * ============================================================
 *
 * Professional introduction and technical positioning.
 *
 * IMPORTANT:
 * Keep personal/project data inside /src/data/.
 * This component is responsible for presentation only.
 * ============================================================
 */

import SectionHeading from "./SectionHeading.astro";
import { profile } from "../data/profile";
---

<section
  id="about"
  class="about-section section"
  aria-labelledby="about-title"
>
  <!-- ======================================================
       BACKGROUND
       ====================================================== -->

  <div
    class="about-background"
    aria-hidden="true"
  >
    <div class="about-glow about-glow-one"></div>
    <div class="about-glow about-glow-two"></div>

    <div class="about-grid"></div>

    <div class="about-network">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
  </div>


  <div class="container">

    <!-- ====================================================
         SECTION HEADING
         ==================================================== -->

    <SectionHeading
      eyebrow="02 / About"
      title="Automation with an architecture mindset."
      description="I design and deliver automation solutions that connect business processes, enterprise systems and emerging AI capabilities."
    />


    <!-- ====================================================
         MAIN ABOUT GRID
         ==================================================== -->

    <div class="about-layout">

      <!-- ==================================================
           PROFILE CARD
           ================================================== -->

      <article class="profile-card glass-card">

        <div class="profile-card-top">

          <div class="profile-avatar">
            <span class="avatar-grid"></span>

            <span class="avatar-initials">
              HA
            </span>

            <span class="avatar-status"></span>
          </div>

          <div>
            <span class="profile-label">
              PROFESSIONAL PROFILE
            </span>

            <h3>
              {profile.name}
            </h3>

            <p class="profile-role">
              Senior RPA Consultant
            </p>
          </div>

        </div>


        <div class="profile-divider"></div>


        <div class="profile-info">

          <div class="profile-info-row">
            <span class="info-key">
              Focus
            </span>

            <span class="info-value">
              RPA · Automation · Architecture
            </span>
          </div>

          <div class="profile-info-row">
            <span class="info-key">
              Current direction
            </span>

            <span class="info-value">
              GenAI · LangChain · Intelligent Automation
            </span>
          </div>

          <div class="profile-info-row">
            <span class="info-key">
              Experience
            </span>

            <span class="info-value">
              6+ years in IT
            </span>
          </div>

          <div class="profile-info-row">
            <span class="info-key">
              Environment
            </span>

            <span class="info-value">
              Enterprise · Consulting · Delivery
            </span>
          </div>

        </div>


        <div class="profile-card-footer">

          <span class="footer-dot"></span>

          <span>
            Building reliable systems for real-world processes.
          </span>

        </div>

      </article>


      <!-- ==================================================
           PROFESSIONAL STORY
           ================================================== -->

      <div class="about-story">

        <p class="story-lead">
          {profile.aboutIntro}
        </p>

        <p>
          My professional journey has evolved from hands-on IT
          and automation delivery into consulting, solution
          architecture and enterprise automation. I have worked
          across different delivery models and technology
          environments, helping organizations transform
          repetitive and complex processes into scalable
          digital workflows.
        </p>

        <p>
          My current focus combines the reliability of
          enterprise RPA with the possibilities of
          <strong>Generative AI</strong>. I am actively expanding
          my knowledge of technologies such as
          <strong>LangChain</strong>, LLM-based applications,
          AI agents and intelligent automation patterns.
        </p>

        <p>
          The goal is not simply to automate tasks. It is to
          understand the complete process, identify the right
          architecture and build solutions that are maintainable,
          measurable and capable of evolving with the business.
        </p>


        <!-- ==================================================
             CORE CAPABILITIES
             ================================================== -->

        <div class="capability-list">

          <div class="capability-item">

            <span class="capability-number">
              01
            </span>

            <div>
              <h4>
                Automation Engineering
              </h4>

              <p>
                Designing robust RPA workflows and enterprise
                automation solutions.
              </p>
            </div>

          </div>


          <div class="capability-item">

            <span class="capability-number">
              02
            </span>

            <div>
              <h4>
                Solution Architecture
              </h4>

              <p>
                Translating business requirements into scalable
                technical solutions and integration patterns.
              </p>
            </div>

          </div>


          <div class="capability-item">

            <span class="capability-number">
              03
            </span>

            <div>
              <h4>
                Intelligent Automation
              </h4>

              <p>
                Exploring GenAI, LLMs and agentic approaches to
                extend traditional automation.
              </p>
            </div>

          </div>

        </div>

      </div>

    </div>


    <!-- ====================================================
         TECHNOLOGY STRIP
         ==================================================== -->

    <div class="technology-section">

      <div class="technology-heading">

        <span>
          CURRENT TECHNOLOGY INTERESTS
        </span>

        <div class="technology-line"></div>

      </div>


      <div class="technology-grid">

        <div class="technology-card">
          <span class="tech-icon">RPA</span>

          <div>
            <strong>
              Robotic Process Automation
            </strong>

            <small>
              Enterprise workflow automation
            </small>
          </div>
        </div>


        <div class="technology-card">
          <span class="tech-icon tech-blue">
            API
          </span>

          <div>
            <strong>
              APIs & Integration
            </strong>

            <small>
              Connecting enterprise systems
            </small>
          </div>
        </div>


        <div class="technology-card">
          <span class="tech-icon tech-violet">
            AI
          </span>

          <div>
            <strong>
              Generative AI
            </strong>

            <small>
              LLM applications & intelligent workflows
            </small>
          </div>
        </div>


        <div class="technology-card">
          <span class="tech-icon tech-green">
            AG
          </span>

          <div>
            <strong>
              AI Agents
            </strong>

            <small>
              Agentic automation exploration
            </small>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>


<style>
  /* ========================================================
     SECTION
     ======================================================== */

  .about-section {
    position:
      relative;

    overflow:
      hidden;
  }


  .about-background {
    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;

    z-index:
      -1;
  }


  .about-grid {
    position:
      absolute;

    inset:
      10% 0 0;

    opacity:
      0.35;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      80px 80px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 20%,
        black 75%,
        transparent
      );
  }


  .about-glow {
    position:
      absolute;

    border-radius:
      50%;

    filter:
      blur(100px);
  }


  .about-glow-one {
    top:
      20%;

    right:
      -10%;

    width:
      30rem;

    height:
      30rem;

    background:
      rgba(34, 211, 238, 0.045);
  }


  .about-glow-two {
    bottom:
      0;

    left:
      -10%;

    width:
      28rem;

    height:
      28rem;

    background:
      rgba(139, 92, 246, 0.04);
  }


  /* ========================================================
     NETWORK DECORATION
     ======================================================== */

  .about-network {
    position:
      absolute;

    top:
      20%;

    right:
      4%;

    width:
      220px;

    height:
      220px;

    opacity:
      0.5;
  }


  .about-network::before,
  .about-network::after {
    content:
      "";

    position:
      absolute;

    top:
      50%;

    left:
      50%;

    width:
      100%;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.25),
        transparent
      );
  }


  .about-network::after {
    transform:
      rotate(90deg);
  }


  .about-network span {
    position:
      absolute;

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 12px rgba(34, 211, 238, 0.7);

    animation:
      about-node 4s ease-in-out infinite;
  }


  .about-network span:nth-child(1) {
    top:
      15%;

    left:
      20%;
  }


  .about-network span:nth-child(2) {
    top:
      32%;

    right:
      12%;

    animation-delay:
      -1s;
  }


  .about-network span:nth-child(3) {
    top:
      70%;

    right:
      25%;

    background:
      var(--color-violet);

    animation-delay:
      -2s;
  }


  .about-network span:nth-child(4) {
    bottom:
      8%;

    left:
      30%;

    animation-delay:
      -3s;
  }


  .about-network span:nth-child(5) {
    top:
      48%;

    left:
      5%;

    background:
      var(--color-blue);

    animation-delay:
      -1.5s;
  }


  .about-network span:nth-child(6) {
    top:
      48%;

    left:
      48%;

    animation-delay:
      -2.5s;
  }


  @keyframes about-node {
    0%,
    100% {
      transform:
        scale(0.7);

      opacity:
        0.3;
    }

    50% {
      transform:
        scale(1.5);

      opacity:
        1;
    }
  }


  /* ========================================================
     MAIN LAYOUT
     ======================================================== */

  .about-layout {
    display:
      grid;

    grid-template-columns:
      minmax(280px, 0.75fr)
      minmax(0, 1.25fr);

    gap:
      clamp(2rem, 7vw, 7rem);

    align-items:
      start;
  }


  /* ========================================================
     PROFILE CARD
     ======================================================== */

  .profile-card {
    position:
      relative;

    overflow:
      hidden;

    padding:
      clamp(1.25rem, 3vw, 2rem);
  }


  .profile-card::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      40%;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        var(--color-cyan),
        transparent
      );
  }


  .profile-card::after {
    content:
      "";

    position:
      absolute;

    right:
      -30%;

    bottom:
      -40%;

    width:
      15rem;

    height:
      15rem;

    border-radius:
      50%;

    background:
      rgba(34, 211, 238, 0.04);

    filter:
      blur(50px);
  }


  .profile-card-top {
    display:
      flex;

    align-items:
      center;

    gap:
      1rem;
  }


  .profile-avatar {
    position:
      relative;

    flex:
      0 0 auto;

    width:
      4rem;

    height:
      4rem;

    display:
      grid;

    place-items:
      center;

    overflow:
      hidden;

    border:
      1px solid rgba(34, 211, 238, 0.2);

    border-radius:
      1rem;

    background:
      linear-gradient(
        135deg,
        rgba(34, 211, 238, 0.1),
        rgba(139, 92, 246, 0.08)
      );
  }


  .avatar-grid {
    position:
      absolute;

    inset:
      0;

    background-image:
      linear-gradient(
        rgba(34, 211, 238, 0.08) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.08) 1px,
        transparent 1px
      );

    background-size:
      10px 10px;
  }


  .avatar-initials {
    position:
      relative;

    z-index:
      2;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      1.15rem;

    font-weight:
      600;

    letter-spacing:
      -0.04em;
  }


  .avatar-status {
    position:
      absolute;

    right:
      0.45rem;

    bottom:
      0.45rem;

    width:
      0.4rem;

    height:
      0.4rem;

    z-index:
      3;

    border-radius:
      50%;

    background:
      var(--color-green);

    box-shadow:
      0 0 10px rgba(34, 197, 94, 0.75);
  }


  .profile-label {
    display:
      block;

    margin-bottom:
      0.25rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.58rem;

    letter-spacing:
      0.1em;
  }


  .profile-card h3 {
    margin:
      0;

    font-size:
      1.15rem;

    letter-spacing:
      -0.02em;
  }


  .profile-role {
    margin-top:
      0.25rem;

    color:
      var(--color-text-muted);

    font-size:
      0.78rem;
  }


  .profile-divider {
    height:
      1px;

    margin:
      1.5rem 0;

    background:
      var(--color-border);
  }


  .profile-info {
    display:
      flex;

    flex-direction:
      column;

    gap:
      1rem;
  }


  .profile-info-row {
    display:
      grid;

    grid-template-columns:
      0.7fr 1.3fr;

    gap:
      1rem;

    font-size:
      0.75rem;
  }


  .info-key {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.6rem;

    text-transform:
      uppercase;

    letter-spacing:
      0.05em;
  }


  .info-value {
    color:
      var(--color-text-secondary);

    text-align:
      right;

    line-height:
      1.5;
  }


  .profile-card-footer {
    position:
      relative;

    z-index:
      2;

    display:
      flex;

    align-items:
      center;

    gap:
      0.55rem;

    margin-top:
      1.75rem;

    padding-top:
      1rem;

    border-top:
      1px solid var(--color-border);

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.58rem;

    line-height:
      1.5;
  }


  .footer-dot {
    flex:
      0 0 auto;

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 10px rgba(34, 211, 238, 0.6);
  }


  /* ========================================================
     STORY
     ======================================================== */

  .about-story {
    max-width:
      780px;

    color:
      var(--color-text-secondary);

    font-size:
      0.98rem;

    line-height:
      1.85;
  }


  .about-story p {
    margin-bottom:
      1.25rem;
  }


  .about-story .story-lead {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1.25rem, 2.4vw, 1.7rem);

    line-height:
      1.5;

    letter-spacing:
      -0.025em;
  }


  .about-story strong {
    color:
      var(--color-text);

    font-weight:
      500;
  }


  /* ========================================================
     CAPABILITIES
     ======================================================== */

  .capability-list {
    display:
      flex;

    flex-direction:
      column;

    margin-top:
      2.5rem;

    border-top:
      1px solid var(--color-border);
  }


  .capability-item {
    display:
      grid;

    grid-template-columns:
      3rem 1fr;

    gap:
      1rem;

    padding:
      1.35rem 0;

    border-bottom:
      1px solid var(--color-border);

    transition:
      padding-left var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard);
  }


  .capability-item:hover {
    padding-left:
      0.6rem;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.035),
        transparent
      );
  }


  .capability-number {
    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.65rem;
  }


  .capability-item h4 {
    margin:
      0 0 0.35rem;

    color:
      var(--color-text);

    font-size:
      0.95rem;

    font-weight:
      500;
  }


  .capability-item p {
    margin:
      0;

    color:
      var(--color-text-muted);

    font-size:
      0.78rem;

    line-height:
      1.6;
  }


  /* ========================================================
     TECHNOLOGY SECTION
     ======================================================== */

  .technology-section {
    margin-top:
      clamp(4rem, 9vw, 7rem);
  }


  .technology-heading {
    display:
      flex;

    align-items:
      center;

    gap:
      1rem;

    margin-bottom:
      1.25rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.58rem;

    letter-spacing:
      0.1em;
  }


  .technology-line {
    flex:
      1;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        var(--color-border),
        transparent
      );
  }


  .technology-grid {
    display:
      grid;

    grid-template-columns:
      repeat(4, 1fr);

    gap:
      0.75rem;
  }


  .technology-card {
    display:
      flex;

    align-items:
      center;

    gap:
      0.8rem;

    min-height:
      5.5rem;

    padding:
      1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-md);

    background:
      rgba(148, 163, 184, 0.02);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
  }


  .technology-card:hover {
    transform:
      translateY(-4px);

    border-color:
      rgba(34, 211, 238, 0.22);

    background:
      rgba(34, 211, 238, 0.035);
  }


  .technology-card strong {
    display:
      block;

    margin-bottom:
      0.25rem;

    color:
      var(--color-text);

    font-size:
      0.72rem;

    font-weight:
      500;

    line-height:
      1.35;
  }


  .technology-card small {
    display:
      block;

    color:
      var(--color-text-subtle);

    font-size:
      0.6rem;

    line-height:
      1.4;
  }


  .tech-icon {
    flex:
      0 0 auto;

    display:
      grid;

    place-items:
      center;

    width:
      2.3rem;

    height:
      2.3rem;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      0.65rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.05);

    font-family:
      var(--font-mono);

    font-size:
      0.52rem;

    font-weight:
      600;
  }


  .tech-blue {
    color:
      var(--color-blue-bright);

    border-color:
      rgba(59, 130, 246, 0.2);

    background:
      rgba(59, 130, 246, 0.05);
  }


  .tech-violet {
    color:
      var(--color-violet-bright);

    border-color:
      rgba(139, 92, 246, 0.2);

    background:
      rgba(139, 92, 246, 0.05);
  }


  .tech-green {
    color:
      #4ade80;

    border-color:
      rgba(34, 197, 94, 0.18);

    background:
      rgba(34, 197, 94, 0.04);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 1000px) {
    .about-layout {
      grid-template-columns:
        minmax(250px, 0.8fr)
        minmax(0, 1.2fr);

      gap:
        3rem;
    }

    .technology-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }
  }


  @media (max-width: 800px) {
    .about-layout {
      grid-template-columns:
        1fr;

      gap:
        3rem;
    }

    .profile-card {
      max-width:
        620px;
    }

    .about-network {
      opacity:
        0.25;
    }
  }


  @media (max-width: 560px) {
    .technology-grid {
      grid-template-columns:
        1fr;
    }

    .profile-info-row {
      grid-template-columns:
        1fr;

      gap:
        0.25rem;
    }

    .info-value {
      text-align:
        left;
    }

    .about-story {
      font-size:
        0.9rem;
    }

    .about-story .story-lead {
      font-size:
        1.25rem;
    }

    .capability-item {
      grid-template-columns:
        2rem 1fr;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .about-network span {
      animation:
        none;
    }

    .technology-card,
    .capability-item {
      transition:
        none;
    }
  }
</style>
