---
/**
 * ============================================================
 * SECTION HEADING
 * ============================================================
 *
 * Reusable heading system for portfolio sections.
 *
 * Supports:
 * - Section number
 * - Eyebrow
 * - Main title
 * - Highlighted title fragment
 * - Description
 * - System status
 * - Optional metadata
 *
 * ============================================================
 */

interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  status?: string;
  meta?: string;
  align?: "left" | "center";
}

const {
  number = "01",
  eyebrow = "SYSTEM MODULE",
  title,
  highlight,
  description,
  status = "ACTIVE",
  meta,
  align = "left"
} = Astro.props;

/*
 * Split the title around the highlight text so the highlighted
 * fragment can be styled without requiring HTML in the data.
 */
let titleBefore = title;
let titleAfter = "";

if (highlight) {
  const highlightIndex = title.indexOf(highlight);

  if (highlightIndex !== -1) {
    titleBefore = title.slice(0, highlightIndex);
    titleAfter = title.slice(
      highlightIndex + highlight.length
    );
  }
}
---

<section
  class:list={[
    "section-heading",
    `section-heading-${align}`
  ]}
>

  <!-- ======================================================
       TOP SYSTEM ROW
       ====================================================== -->

  <div class="heading-system-row">

    <div class="heading-system-left">

      <span class="heading-number">
        {number}
      </span>

      <span class="heading-divider"></span>

      <span class="heading-eyebrow">
        {eyebrow}
      </span>

    </div>


    <div class="heading-system-right">

      {
        meta && (
          <span class="heading-meta">
            {meta}
          </span>
        )
      }

      <span class="heading-status">

        <span
          class="heading-status-dot"
          aria-hidden="true"
        ></span>

        {status}

      </span>

    </div>

  </div>


  <!-- ======================================================
       TITLE
       ====================================================== -->

  <h2 class="heading-title">

    {titleBefore}

    {
      highlight && (
        <span class="heading-highlight">
          {highlight}
        </span>
      )
    }

    {titleAfter}

  </h2>


  <!-- ======================================================
       DESCRIPTION
       ====================================================== -->

  {
    description && (
      <p class="heading-description">
        {description}
      </p>
    )
  }


  <!-- ======================================================
       DECORATIVE SIGNAL
       ====================================================== -->

  <div
    class="heading-signal"
    aria-hidden="true"
  >

    <span class="signal-node"></span>

    <span class="signal-line signal-line-short"></span>

    <span class="signal-line"></span>

    <span class="signal-node signal-node-secondary"></span>

  </div>

</section>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .section-heading {
    width:
      100%;

    margin-bottom:
      3rem;
  }


  /* ========================================================
     SYSTEM ROW
     ======================================================== */

  .heading-system-row {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-bottom:
      1rem;

    min-height:
      20px;
  }


  .heading-system-left,
  .heading-system-right {
    display:
      flex;

    align-items:
      center;

    min-width:
      0;
  }


  .heading-system-left {
    gap:
      0.5rem;
  }


  .heading-system-right {
    gap:
      0.75rem;
  }


  /* ========================================================
     NUMBER
     ======================================================== */

  .heading-number {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    min-width:
      22px;

    height:
      18px;

    padding:
      0 0.35rem;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      0.15rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;

    letter-spacing:
      0.03em;

    background:
      rgba(34, 211, 238, 0.025);
  }


  /* ========================================================
     DIVIDER
     ======================================================== */

  .heading-divider {
    width:
      35px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.45),
        transparent
      );
  }


  /* ========================================================
     EYEBROW
     ======================================================== */

  .heading-eyebrow {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;

    font-weight:
      500;

    letter-spacing:
      0.045em;

    white-space:
      nowrap;
  }


  /* ========================================================
     META
     ======================================================== */

  .heading-meta {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.23rem;

    letter-spacing:
      0.03em;

    white-space:
      nowrap;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .heading-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.22rem;

    letter-spacing:
      0.035em;

    white-space:
      nowrap;
  }


  .heading-status-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      #4ade80;

    box-shadow:
      0 0 7px rgba(74, 222, 128, 0.65);

    animation:
      heading-status-pulse 2.2s ease-in-out infinite;
  }


  @keyframes heading-status-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     TITLE
     ======================================================== */

  .heading-title {
    max-width:
      800px;

    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(2rem, 5vw, 4rem);

    font-weight:
      600;

    letter-spacing:
      -0.055em;

    line-height:
      0.98;
  }


  .heading-highlight {
    color:
      var(--color-cyan);

    text-shadow:
      0 0 30px rgba(34, 211, 238, 0.08);
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .heading-description {
    max-width:
      650px;

    margin:
      1rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      clamp(0.78rem, 1.2vw, 0.95rem);

    line-height:
      1.7;
  }


  /* ========================================================
     SIGNAL
     ======================================================== */

  .heading-signal {
    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    width:
      min(100%, 240px);

    margin-top:
      1.25rem;
  }


  .signal-node {
    width:
      5px;

    height:
      5px;

    flex-shrink:
      0;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    box-shadow:
      0 0 7px rgba(34, 211, 238, 0.35);

    animation:
      signal-node-pulse 2.8s ease-in-out infinite;
  }


  .signal-node-secondary {
    border-color:
      var(--color-violet);

    box-shadow:
      0 0 7px rgba(139, 92, 246, 0.35);

    animation-delay:
      0.8s;
  }


  .signal-line {
    flex:
      1;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.35),
        rgba(148, 163, 184, 0.08)
      );
  }


  .signal-line-short {
    flex:
      0 1 25px;

    background:
      rgba(34, 211, 238, 0.18);
  }


  @keyframes signal-node-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.8);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1.15);
    }

  }


  /* ========================================================
     CENTER ALIGNMENT
     ======================================================== */

  .section-heading-center {
    text-align:
      center;
  }


  .section-heading-center
    .heading-system-row {

    justify-content:
      center;
  }


  .section-heading-center
    .heading-system-right {

    display:
      none;
  }


  .section-heading-center
    .heading-title {

    margin-inline:
      auto;
  }


  .section-heading-center
    .heading-description {

    margin-inline:
      auto;
  }


  .section-heading-center
    .heading-signal {

    margin-inline:
      auto;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .heading-number {

    border-color:
      rgba(14, 116, 144, 0.18);

    background:
      rgba(14, 116, 144, 0.025);
  }


  :global([data-theme="light"])
    .heading-highlight {

    color:
      #0e7490;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .section-heading {
      margin-bottom:
        2.2rem;
    }


    .heading-system-row {
      align-items:
        flex-start;
    }


    .heading-system-right {
      display:
        none;
    }


    .heading-title {
      font-size:
        clamp(1.9rem, 9vw, 3rem);
    }


    .heading-description {
      font-size:
        0.76rem;

      line-height:
        1.65;
    }

  }


  @media (max-width: 430px) {

    .heading-eyebrow {
      font-size:
        0.23rem;
    }


    .heading-divider {
      width:
        20px;
    }


    .heading-number {
      min-width:
        20px;

      height:
        17px;

      font-size:
        0.22rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .heading-status-dot,
    .signal-node {
      animation:
        none;
    }

  }
</style>
