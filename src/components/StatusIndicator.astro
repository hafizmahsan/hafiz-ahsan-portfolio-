---
/**
 * ============================================================
 * STATUS INDICATOR
 * ============================================================
 *
 * Reusable status indicator with a small visual signal.
 *
 * ============================================================
 */

type StatusVariant =
  | "online"
  | "available"
  | "current"
  | "progress"
  | "complete"
  | "offline"
  | "warning";

interface Props {
  label: string;

  variant?: StatusVariant;

  pulse?: boolean;

  size?:
    | "sm"
    | "md";

  class?: string;
}

const {
  label,
  variant = "online",
  pulse = false,
  size = "sm",
  class: className = ""
} = Astro.props;
---

<div
  class:list={[
    "status",
    `status--${variant}`,
    `status--${size}`,
    {
      "status--pulse": pulse
    },
    className
  ]}
  role="status"
>
  <span
    class="status__indicator"
    aria-hidden="true"
  >
    <span class="status__dot" />
  </span>

  <span class="status__label">
    {label}
  </span>
</div>


<style>
  .status {
    display: inline-flex;
    align-items: center;

    width: fit-content;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-weight: 600;

    letter-spacing: 0.1em;

    text-transform: uppercase;
  }


  .status--sm {
    gap: 0.5rem;

    font-size: 0.65rem;
  }


  .status--md {
    gap: 0.6rem;

    font-size: 0.72rem;
  }


  .status__indicator {
    position: relative;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    width: 0.55rem;
    height: 0.55rem;
  }


  .status__dot {
    display: block;

    width: 100%;
    height: 100%;

    border-radius: 999px;

    background:
      currentColor;
  }


  .status--pulse
  .status__indicator::before {
    content: "";

    position: absolute;
    inset: -0.2rem;

    border-radius: 999px;

    border: 1px solid currentColor;

    opacity: 0.35;

    animation:
      status-pulse 1.8s
      ease-out infinite;
  }


  /* ========================================================
     VARIANTS
     ======================================================== */

  .status--online {
    color:
      #4ade80;
  }


  .status--available {
    color:
      #67e8f9;
  }


  .status--current {
    color:
      #67e8f9;
  }


  .status--progress {
    color:
      #a78bfa;
  }


  .status--complete {
    color:
      #4ade80;
  }


  .status--offline {
    color:
      #94a3b8;
  }


  .status--warning {
    color:
      #facc15;
  }


  /* ========================================================
     ANIMATION
     ======================================================== */

  @keyframes status-pulse {
    0% {
      transform: scale(0.75);

      opacity: 0.5;
    }

    70% {
      transform: scale(1.5);

      opacity: 0;
    }

    100% {
      transform: scale(1.5);

      opacity: 0;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .status--pulse
    .status__indicator::before {
      animation: none;
    }
  }
</style>
