---
/**
 * ============================================================
 * CONTACT SECTION
 * ============================================================
 *
 * Final call-to-action / contact area.
 *
 * ============================================================
 */

import Button from "./Button.astro";
import SectionHeader from "./SectionHeader.astro";

interface ContactLink {
  label: string;

  href: string;

  external?: boolean;
}

interface Props {
  number?: string;

  eyebrow?: string;

  title?: string;

  description?: string;

  email?: string;

  availability?: string;

  links?: ContactLink[];

  class?: string;
}

const {
  number = "05",

  eyebrow = "CONTACT",

  title = "Let's build something useful.",

  description =
    "Have a project, workflow, or technical problem worth exploring? I'd be happy to hear about it.",

  email = "hello@example.com",

  availability = "AVAILABLE FOR SELECTED PROJECTS",

  links = [],

  class: className = ""
} = Astro.props;
---

<section
  id="contact"
  class:list={[
    "contact-section",
    className
  ]}
>
  <div class="contact-section__inner">

    <SectionHeader
      number={number}
      eyebrow={eyebrow}
      title={title}
      description={description}
    />


    <div class="contact-section__panel">

      <div class="contact-section__status">

        <span
          class="contact-section__status-dot"
          aria-hidden="true"
        ></span>

        <span>
          {availability}
        </span>

      </div>


      <div class="contact-section__email">

        <span class="contact-section__label">
          DIRECT CONTACT
        </span>

        <a
          href={`mailto:${email}`}
          class="contact-section__email-link"
        >
          {email}
        </a>

      </div>


      <div class="contact-section__actions">

        <Button
          href={`mailto:${email}`}
          label="SEND AN EMAIL"
          variant="primary"
          size="lg"
        />


        {
          links.length > 0 && (
            <div class="contact-section__links">

              {
                links.map(
                  (link) => (
                    <a
                      href={link.href}
                      class="contact-section__link"
                      target={
                        link.external
                          ? "_blank"
                          : undefined
                      }
                      rel={
                        link.external
                          ? "noopener noreferrer"
                          : undefined
                      }
                    >
                      {link.label}

                      {
                        link.external && (
                          <span
                            aria-hidden="true"
                          >
                            ↗
                          </span>
                        )
                      }
                    </a>
                  )
                )
              }

            </div>
          )
        }

      </div>

    </div>

  </div>
</section>


<style>
  .contact-section {
    padding:
      7rem 0 8rem;
  }


  .contact-section__inner {
    width:
      min(
        calc(100% - 2.5rem),
        76rem
      );

    margin-inline: auto;
  }


  /* ========================================================
     PANEL
     ======================================================== */

  .contact-section__panel {
    position: relative;

    display: grid;

    grid-template-columns:
      auto minmax(0, 1fr) auto;

    align-items: center;

    gap:
      clamp(1.5rem, 4vw, 4rem);

    margin-top: 4rem;

    padding:
      clamp(1.5rem, 4vw, 2.5rem);

    border:
      1px solid
      rgba(103, 232, 249, 0.13);

    background:
      linear-gradient(
        135deg,
        rgba(8, 47, 73, 0.18),
        rgba(2, 6, 23, 0.72)
      );

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.025);
  }


  .contact-section__panel::before {
    content: "";

    position: absolute;

    top: -1px;
    left: 2rem;

    width: 4rem;
    height: 1px;

    background:
      #67e8f9;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .contact-section__status {
    display: flex;

    align-items: center;

    gap: 0.55rem;

    align-self: start;

    padding-top: 0.2rem;

    color:
      rgba(148, 163, 184, 0.68);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.52rem;

    font-weight: 700;

    letter-spacing: 0.08em;

    line-height: 1.4;
  }


  .contact-section__status-dot {
    width: 0.4rem;
    height: 0.4rem;

    flex-shrink: 0;

    border-radius: 50%;

    background:
      #22c55e;

    box-shadow:
      0 0 0 3px
      rgba(34, 197, 94, 0.08),
      0 0 12px
      rgba(34, 197, 94, 0.35);
  }


  /* ========================================================
     EMAIL
     ======================================================== */

  .contact-section__email {
    min-width: 0;
  }


  .contact-section__label {
    display: block;

    margin-bottom: 0.55rem;

    color:
      rgba(100, 116, 139, 0.65);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.52rem;

    font-weight: 700;

    letter-spacing: 0.1em;
  }


  .contact-section__email-link {
    display: inline-block;

    max-width: 100%;

    overflow-wrap: anywhere;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(1.1rem, 2.5vw, 1.65rem);

    font-weight: 700;

    letter-spacing: -0.04em;

    line-height: 1.2;

    text-decoration: none;

    transition:
      color 160ms ease;
  }


  .contact-section__email-link:hover {
    color:
      #67e8f9;
  }


  /* ========================================================
     ACTIONS
     ======================================================== */

  .contact-section__actions {
    display: flex;

    align-items: center;

    gap: 1.25rem;
  }


  .contact-section__links {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 0.45rem;
  }


  .contact-section__link {
    display: inline-flex;

    align-items: center;

    gap: 0.35rem;

    color:
      rgba(148, 163, 184, 0.7);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.55rem;

    font-weight: 700;

    letter-spacing: 0.08em;

    text-decoration: none;

    transition:
      color 160ms ease;
  }


  .contact-section__link:hover {
    color:
      #67e8f9;
  }


  .contact-section__link span {
    color:
      rgba(103, 232, 249, 0.65);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 1000px) {
    .contact-section__panel {
      grid-template-columns:
        1fr auto;
    }


    .contact-section__status {
      grid-column:
        1 / -1;
    }


    .contact-section__actions {
      justify-content: flex-end;
    }
  }


  @media (max-width: 700px) {
    .contact-section {
      padding:
        5rem 0 6rem;
    }


    .contact-section__panel {
      grid-template-columns: 1fr;

      align-items: start;

      margin-top: 3rem;
    }


    .contact-section__actions {
      align-items: flex-start;

      justify-content: flex-start;

      flex-direction: column;
    }


    .contact-section__links {
      flex-direction: row;

      flex-wrap: wrap;

      gap: 1rem;
    }
  }


  @media (max-width: 640px) {
    .contact-section__inner {
      width:
        min(
          calc(100% - 2rem),
          76rem
        );
    }


    .contact-section__email-link {
      font-size:
        clamp(
          1rem,
          5vw,
          1.35rem
        );
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .contact-section__email-link,
    .contact-section__link {
      transition: none;
    }
  }
</style>
