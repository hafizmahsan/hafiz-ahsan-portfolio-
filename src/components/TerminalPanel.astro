---
/**
 * ============================================================
 * TERMINAL PANEL
 * ============================================================
 *
 * Reusable terminal / system console visual.
 *
 * Intended for:
 * - Hero section
 * - Automation demonstrations
 * - Project highlights
 * - Technical profile
 *
 * Content is passed through props so the component remains
 * reusable and easy to maintain.
 *
 * ============================================================
 */

interface TerminalLine {
  prompt?: string;
  text: string;
  type?: "command" | "success" | "info" | "warning" | "output";
}

interface Props {
  title?: string;
  status?: string;
  lines?: TerminalLine[];
  accent?: "cyan" | "violet" | "blue" | "green";
  animated?: boolean;
}

const {
  title = "AUTOMATION CORE",
  status = "ONLINE",
  lines = [
    {
      prompt: "$",
      text: "initialize automation.core",
      type: "command"
    },
    {
      text: "[OK] Runtime initialized",
      type: "success"
    },
    {
      text: "[OK] RPA orchestration layer connected",
      type: "success"
    },
    {
      text: "[INFO] Intelligent automation modules ready",
      type: "info"
    },
    {
      text: "[INFO] Gen AI learning environment detected",
      type: "info"
    },
    {
      prompt: "$",
      text: "system.status",
      type: "command"
    },
    {
      text: "Automation systems operational.",
      type: "output"
    }
  ],
  accent = "cyan",
  animated = true
} = Astro.props;
---

<div
  class:list={[
    "terminal-panel",
    `terminal-panel-${accent}`,
    {
      "terminal-panel-animated": animated
    }
  ]}
>

  <!-- ======================================================
       TERMINAL HEADER
       ====================================================== -->

  <div class="terminal-header">

    <div class="terminal-controls">

      <span class="terminal-control terminal-control-red"></span>

      <span class="terminal-control terminal-control-yellow"></span>

      <span class="terminal-control terminal-control-green"></span>

    </div>


    <div class="terminal-title">

      <span
        class="terminal-title-icon"
        aria-hidden="true"
      >
        ◈
      </span>

      <span>
        {title}
      </span>

    </div>


    <div class="terminal-status">

      <span
        class="terminal-status-dot"
        aria-hidden="true"
      ></span>

      <span>
        {status}
      </span>

    </div>

  </div>


  <!-- ======================================================
       TERMINAL BODY
       ====================================================== -->

  <div class="terminal-body">

    <div class="terminal-system-info">

      <span>SYS</span>

      <span class="terminal-info-line"></span>

      <span>RPA // AI // API</span>

    </div>


    <div class="terminal-output">

      {
        lines.map((line, index) => (
          <div
            class:list={[
              "terminal-line",
              `terminal-line-${line.type ?? "output"}`
            ]}
            style={`--line-index: ${index}`}
          >

            {
              line.prompt && (
                <span class="terminal-prompt">
                  {line.prompt}
                </span>
              )
            }

            <span class="terminal-text">
              {line.text}
            </span>

          </div>
        ))
      }


      <div class="terminal-cursor-line">

        <span class="terminal-prompt">
          $
        </span>

        <span class="terminal-cursor"></span>

      </div>

    </div>

  </div>


  <!-- ======================================================
       TERMINAL FOOTER
       ====================================================== -->

  <div class="terminal-footer">

    <span class="terminal-footer-item">
      <span class="footer-dot"></span>
      PROCESSING
    </span>

    <span class="terminal-footer-item">
      NODE 01
    </span>

    <span class="terminal-footer-item">
      SECURE
    </span>

  </div>


  <!-- ======================================================
       DECORATIVE CORNERS
       ====================================================== -->

  <span
    class="terminal-corner terminal-corner-top"
    aria-hidden="true"
  ></span>

  <span
    class="terminal-corner terminal-corner-bottom"
    aria-hidden="true"
  ></span>

</div>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .terminal-panel {
    position:
      relative;

    width:
      100%;

    border:
      1px solid var(--color-border);

    border-radius:
      0.5rem;

    background:
      rgba(3, 7, 18, 0.72);

    box-shadow:
      0 20px 70px rgba(0, 0, 0, 0.25),
      inset 0 0 40px rgba(34, 211, 238, 0.012);

    overflow:
      hidden;

    backdrop-filter:
      blur(12px);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .terminal-panel:hover {
    transform:
      translateY(-3px);

    border-color:
      rgba(34, 211, 238, 0.16);

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.3),
      0 0 40px rgba(34, 211, 238, 0.025);
  }


  /* ========================================================
     HEADER
     ======================================================== */

  .terminal-header {
    display:
      grid;

    grid-template-columns:
      auto 1fr auto;

    align-items:
      center;

    gap:
      0.8rem;

    min-height:
      38px;

    padding:
      0 0.75rem;

    border-bottom:
      1px solid var(--color-border);

    background:
      rgba(148, 163, 184, 0.018);
  }


  /* ========================================================
     CONTROLS
     ======================================================== */

  .terminal-controls {
    display:
      flex;

    align-items:
      center;

    gap:
      0.3rem;
  }


  .terminal-control {
    width:
      6px;

    height:
      6px;

    border-radius:
      50%;

    opacity:
      0.65;
  }


  .terminal-control-red {
    background:
      #f87171;
  }


  .terminal-control-yellow {
    background:
      #facc15;
  }


  .terminal-control-green {
    background:
      #4ade80;
  }


  /* ========================================================
     TITLE
     ======================================================== */

  .terminal-title {
    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    min-width:
      0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;

    letter-spacing:
      0.04em;

    white-space:
      nowrap;

    overflow:
      hidden;

    text-overflow:
      ellipsis;
  }


  .terminal-title-icon {
    color:
      var(--color-cyan);

    font-size:
      0.35rem;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .terminal-status {
    display:
      flex;

    align-items:
      center;

    gap:
      0.3rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.22rem;

    letter-spacing:
      0.04em;
  }


  .terminal-status-dot {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      #4ade80;

    box-shadow:
      0 0 8px rgba(74, 222, 128, 0.65);

    animation:
      terminal-status-pulse 2s ease-in-out infinite;
  }


  @keyframes terminal-status-pulse {

    0%,
    100% {
      opacity:
        0.4;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     BODY
     ======================================================== */

  .terminal-body {
    position:
      relative;

    padding:
      0.8rem;

    min-height:
      270px;

    background:
      radial-gradient(
        circle at 75% 20%,
        rgba(34, 211, 238, 0.025),
        transparent 40%
      );
  }


  .terminal-body::before {
    content:
      "";

    position:
      absolute;

    inset:
      0;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      100% 24px;

    pointer-events:
      none;

    opacity:
      0.35;
  }


  /* ========================================================
     SYSTEM INFO
     ======================================================== */

  .terminal-system-info {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      center;

    gap:
      0.45rem;

    margin-bottom:
      0.9rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.21rem;

    letter-spacing:
      0.04em;
  }


  .terminal-system-info > span:first-child {
    color:
      var(--color-cyan);
  }


  .terminal-info-line {
    width:
      30px;

    height:
      1px;

    background:
      var(--color-border);
  }


  /* ========================================================
     OUTPUT
     ======================================================== */

  .terminal-output {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    flex-direction:
      column;

    gap:
      0.5rem;
  }


  .terminal-line {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      0.45rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.29rem;

    line-height:
      1.5;

    opacity:
      0.9;
  }


  .terminal-panel-animated
    .terminal-line {

    animation:
      terminal-line-in 0.6s var(--ease-standard) both;

    animation-delay:
      calc(var(--line-index) * 0.12s);
  }


  @keyframes terminal-line-in {

    from {
      opacity:
        0;

      transform:
        translateX(-6px);
    }

    to {
      opacity:
        0.9;

      transform:
        translateX(0);
    }

  }


  /* ========================================================
     PROMPT
     ======================================================== */

  .terminal-prompt {
    flex-shrink:
      0;

    color:
      var(--color-cyan);

    font-weight:
      500;
  }


  /* ========================================================
     COMMAND
     ======================================================== */

  .terminal-line-command
    .terminal-text {

    color:
      var(--color-text);
  }


  /* ========================================================
     SUCCESS
     ======================================================== */

  .terminal-line-success
    .terminal-text {

    color:
      rgba(74, 222, 128, 0.8);
  }


  /* ========================================================
     INFO
     ======================================================== */

  .terminal-line-info
    .terminal-text {

    color:
      rgba(96, 165, 250, 0.8);
  }


  /* ========================================================
     WARNING
     ======================================================== */

  .terminal-line-warning
    .terminal-text {

    color:
      rgba(250, 204, 21, 0.85);
  }


  /* ========================================================
     OUTPUT
     ======================================================== */

  .terminal-line-output
    .terminal-text {

    color:
      var(--color-text-muted);
  }


  /* ========================================================
     CURSOR
     ======================================================== */

  .terminal-cursor-line {
    display:
      flex;

    align-items:
      center;

    gap:
      0.45rem;

    margin-top:
      0.1rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.29rem;
  }


  .terminal-cursor {
    display:
      inline-block;

    width:
      5px;

    height:
      10px;

    background:
      var(--color-cyan);

    opacity:
      0.75;

    animation:
      terminal-cursor-blink 1s steps(1) infinite;
  }


  @keyframes terminal-cursor-blink {

    0%,
    45% {
      opacity:
        0.75;
    }

    46%,
    100% {
      opacity:
        0;
    }

  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .terminal-footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      0.5rem;

    min-height:
      28px;

    padding:
      0 0.75rem;

    border-top:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.19rem;

    letter-spacing:
      0.03em;
  }


  .terminal-footer-item {
    display:
      flex;

    align-items:
      center;

    gap:
      0.25rem;
  }


  .footer-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      #4ade80;

    box-shadow:
      0 0 6px rgba(74, 222, 128, 0.5);
  }


  /* ========================================================
     CORNERS
     ======================================================== */

  .terminal-corner {
    position:
      absolute;

    width:
      8px;

    height:
      8px;

    pointer-events:
      none;
  }


  .terminal-corner-top {
    top:
      0;

    right:
      0;

    border-top:
      1px solid var(--color-cyan);

    border-right:
      1px solid var(--color-cyan);

    opacity:
      0.45;
  }


  .terminal-corner-bottom {
    bottom:
      0;

    left:
      0;

    border-bottom:
      1px solid var(--color-cyan);

    border-left:
      1px solid var(--color-cyan);

    opacity:
      0.3;
  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .terminal-panel-violet
    .terminal-title-icon {

    color:
      var(--color-violet);
  }


  .terminal-panel-violet
    .terminal-prompt {

    color:
      var(--color-violet);
  }


  .terminal-panel-violet
    .terminal-corner {

    border-color:
      var(--color-violet);
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .terminal-panel-blue
    .terminal-title-icon {

    color:
      var(--color-blue);
  }


  .terminal-panel-blue
    .terminal-prompt {

    color:
      var(--color-blue);
  }


  .terminal-panel-blue
    .terminal-corner {

    border-color:
      var(--color-blue);
  }


  /* ========================================================
     GREEN
     ======================================================== */

  .terminal-panel-green
    .terminal-title-icon {

    color:
      #4ade80;
  }


  .terminal-panel-green
    .terminal-prompt {

    color:
      #4ade80;
  }


  .terminal-panel-green
    .terminal-corner {

    border-color:
      #4ade80;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .terminal-panel {

    background:
      rgba(248, 250, 252, 0.8);

    box-shadow:
      0 20px 70px rgba(15, 23, 42, 0.08),
      inset 0 0 40px rgba(14, 116, 144, 0.01);
  }


  :global([data-theme="light"])
    .terminal-body {

    background:
      radial-gradient(
        circle at 75% 20%,
        rgba(14, 116, 144, 0.025),
        transparent 40%
      );
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 600px) {

    .terminal-header {
      min-height:
        34px;

      padding:
        0 0.6rem;
    }


    .terminal-body {
      min-height:
        230px;

      padding:
        0.7rem;
    }


    .terminal-line {
      font-size:
        0.25rem;
    }


    .terminal-footer {
      padding:
        0 0.6rem;
    }

  }


  @media (max-width: 430px) {

    .terminal-status {
      display:
        none;
    }


    .terminal-header {
      grid-template-columns:
        auto 1fr;
    }


    .terminal-footer-item:nth-child(2) {
      display:
        none;
    }


    .terminal-line {
      font-size:
        0.23rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .terminal-panel,
    .terminal-status-dot,
    .terminal-line,
    .terminal-cursor {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
