---
/**
 * ============================================================
 * EXPERIENCE CARD
 * ============================================================
 *
 * Reusable professional experience / career timeline card.
 *
 * The component is intentionally data-driven so experience
 * information can later live in a central data file.
 *
 * ============================================================
 */

interface ExperienceItem {
  text: string;
}

interface Technology {
  name: string;
  accent?: "cyan" | "violet" | "blue" | "green";
}

interface Props {
  company: string;
  role: string;
  period: string;
  location?: string;
  type?: string;
  companyDescription?: string;
  summary?: string;
  responsibilities?: ExperienceItem[];
  technologies?: Technology[];
  index?: string;
  current?: boolean;
  featured?: boolean;
  vendor?: string;
  vendorPeriod?: string;
}

const {
  company,
  role,
  period,
  location,
  type,
  companyDescription,
  summary,
  responsibilities = [],
  technologies = [],
  index = "01",
  current = false,
  featured = false,
  vendor,
  vendorPeriod
} = Astro.props;
---

<article
  class:list={[
    "experience-card",
    {
      "experience-card-current": current,
      "experience-card-featured": featured
    }
  ]}
>

  <!-- ======================================================
       TIMELINE NODE
       ====================================================== -->

  <div
    class="experience-timeline"
    aria-hidden="true"
  >

    <span class="timeline-line"></span>

    <span class="timeline-node">

      <span class="timeline-node-core"></span>

    </span>

  </div>


  <!-- ======================================================
       CARD
       ====================================================== -->

  <div class="experience-content">

    <!-- ==================================================
         HEADER
         ================================================== -->

    <header class="experience-header">

      <div class="experience-index">
        {index}
      </div>


      <div class="experience-date">

        <span>
          {period}
        </span>

        {
          current && (
            <span class="current-badge">
              CURRENT
            </span>
          )
        }

      </div>

    </header>


    <!-- ==================================================
         COMPANY
         ================================================== -->

    <div class="experience-company-row">

      <div class="experience-company">

        <h3>
          {company}
        </h3>

        {
          companyDescription && (
            <span class="company-description">
              {companyDescription}
            </span>
          )
        }

      </div>


      <div class="experience-status">

        <span class="status-dot"></span>

        {
          current
            ? "ACTIVE"
            : "COMPLETED"
        }

      </div>

    </div>


    <!-- ==================================================
         ROLE
         ================================================== -->

    <div class="experience-role">
      {role}
    </div>


    <!-- ==================================================
         META
         ================================================== -->

    {
      (location || type || vendor) && (
        <div class="experience-meta">

          {
            location && (
              <span class="experience-meta-item">
                <span class="meta-icon">⌖</span>
                {location}
              </span>
            )
          }

          {
            type && (
              <span class="experience-meta-item">
                <span class="meta-icon">◇</span>
                {type}
              </span>
            )
          }

          {
            vendor && (
              <span class="experience-meta-item">
                <span class="meta-icon">↳</span>
                {vendor}
                {
                  vendorPeriod && (
                    <span class="vendor-period">
                      {vendorPeriod}
                    </span>
                  )
                }
              </span>
            )
          }

        </div>
      )
    }


    <!-- ==================================================
         SUMMARY
         ================================================== -->

    {
      summary && (
        <p class="experience-summary">
          {summary}
        </p>
      )
    }


    <!-- ==================================================
         RESPONSIBILITIES
         ================================================== -->

    {
      responsibilities.length > 0 && (
        <div class="experience-responsibilities">

          <div class="experience-subheading">

            <span class="subheading-node"></span>

            KEY CONTRIBUTIONS

          </div>


          <ul>

            {
              responsibilities.map((item) => (
                <li>

                  <span
                    class="bullet-node"
                    aria-hidden="true"
                  ></span>

                  <span>
                    {item.text}
                  </span>

                </li>
              ))
            }

          </ul>

        </div>
      )
    }


    <!-- ==================================================
         TECHNOLOGIES
         ================================================== -->

    {
      technologies.length > 0 && (
        <div class="experience-technologies">

          <div class="experience-subheading">

            <span class="subheading-node"></span>

            TECHNOLOGY STACK

          </div>


          <div class="technology-list">

            {
              technologies.map((technology) => (
                <span
                  class:list={[
                    "technology-chip",
                    `technology-${technology.accent || "cyan"}`
                  ]}
                >

                  <span class="technology-chip-node">
                    ◇
                  </span>

                  {technology.name}

                </span>
              ))
            }

          </div>

        </div>
      )
    }


    <!-- ==================================================
         FOOTER
         ================================================== -->

    <footer class="experience-footer">

      <span>
        EXPERIENCE / {index}
      </span>

      <span class="footer-line"></span>

      <span class="footer-signal">
        <span></span>
      </span>

    </footer>

  </div>

</article>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .experience-card {
    position:
      relative;

    display:
      grid;

    grid-template-columns:
      38px minmax(0, 1fr);

    gap:
      1rem;

    min-width:
      0;
  }


  /* ========================================================
     TIMELINE
     ======================================================== */

  .experience-timeline {
    position:
      relative;

    display:
      flex;

    justify-content:
      center;

    min-height:
      100%;
  }


  .timeline-line {
    position:
      absolute;

    top:
      0;

    bottom:
      0;

    width:
      1px;

    background:
      linear-gradient(
        180deg,
        rgba(34, 211, 238, 0.35),
        var(--color-border) 20%,
        var(--color-border) 80%,
        transparent
      );
  }


  .timeline-node {
    position:
      relative;

    z-index:
      2;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      13px;

    height:
      13px;

    margin-top:
      1.25rem;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      var(--color-bg);

    box-shadow:
      0 0 16px rgba(34, 211, 238, 0.12);
  }


  .timeline-node-core {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 9px rgba(34, 211, 238, 0.7);

    animation:
      timeline-pulse 2.5s ease-in-out infinite;
  }


  @keyframes timeline-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.8);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1.2);
    }

  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .experience-content {
    position:
      relative;

    min-width:
      0;

    margin-bottom:
      1.5rem;

    padding:
      1.1rem 1.15rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.55rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .experience-content::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      100px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        var(--color-cyan),
        transparent
      );

    opacity:
      0.55;
  }


  .experience-content::after {
    content:
      "";

    position:
      absolute;

    right:
      -80px;

    bottom:
      -80px;

    width:
      180px;

    height:
      180px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        rgba(34, 211, 238, 0.04),
        transparent 68%
      );

    pointer-events:
      none;
  }


  .experience-card:hover
    .experience-content {

    border-color:
      rgba(34, 211, 238, 0.18);

    background:
      rgba(34, 211, 238, 0.015);

    transform:
      translateX(3px);

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.08);
  }


  /* ========================================================
     HEADER
     ======================================================== */

  .experience-header {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-bottom:
      0.85rem;
  }


  .experience-index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.3rem;

    letter-spacing:
      0.04em;
  }


  .experience-date {
    display:
      flex;

    align-items:
      center;

    gap:
      0.5rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.33rem;

    letter-spacing:
      0.035em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     CURRENT BADGE
     ======================================================== */

  .current-badge {
    padding:
      0.2rem 0.3rem;

    border:
      1px solid rgba(74, 222, 128, 0.18);

    border-radius:
      0.2rem;

    color:
      #4ade80;

    background:
      rgba(74, 222, 128, 0.025);

    font-size:
      0.25rem;

    letter-spacing:
      0.04em;
  }


  /* ========================================================
     COMPANY
     ======================================================== */

  .experience-company-row {
    display:
      flex;

    align-items:
      flex-start;

    justify-content:
      space-between;

    gap:
      1rem;
  }


  .experience-company {
    min-width:
      0;
  }


  .experience-company h3 {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1.05rem, 2vw, 1.35rem);

    font-weight:
      600;

    letter-spacing:
      -0.025em;

    line-height:
      1.2;
  }


  .company-description {
    display:
      block;

    margin-top:
      0.3rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.29rem;

    letter-spacing:
      0.02em;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .experience-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    flex-shrink:
      0;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;

    text-transform:
      uppercase;
  }


  .status-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-text-subtle);
  }


  .experience-card-current
    .status-dot {

    background:
      #4ade80;

    box-shadow:
      0 0 7px rgba(74, 222, 128, 0.7);
  }


  .experience-card-current
    .experience-status {

    color:
      #4ade80;
  }


  /* ========================================================
     ROLE
     ======================================================== */

  .experience-role {
    margin-top:
      0.5rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.43rem;

    font-weight:
      500;

    letter-spacing:
      0.02em;
  }


  /* ========================================================
     META
     ======================================================== */

  .experience-meta {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.4rem;

    margin-top:
      0.7rem;
  }


  .experience-meta-item {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.28rem 0.4rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.2rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(148, 163, 184, 0.01);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;
  }


  .meta-icon {
    color:
      var(--color-cyan);

    font-size:
      0.4rem;
  }


  .vendor-period {
    color:
      var(--color-text-subtle);

    opacity:
      0.7;
  }


  /* ========================================================
     SUMMARY
     ======================================================== */

  .experience-summary {
    max-width:
      800px;

    margin:
      1rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.77rem;

    line-height:
      1.75;
  }


  /* ========================================================
     SUBHEADING
     ======================================================== */

  .experience-subheading {
    display:
      flex;

    align-items:
      center;

    gap:
      0.4rem;

    margin-bottom:
      0.6rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.28rem;

    letter-spacing:
      0.05em;

    text-transform:
      uppercase;
  }


  .subheading-node {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 6px rgba(34, 211, 238, 0.5);
  }


  /* ========================================================
     RESPONSIBILITIES
     ======================================================== */

  .experience-responsibilities {
    margin-top:
      1rem;

    padding-top:
      0.85rem;

    border-top:
      1px solid rgba(148, 163, 184, 0.06);
  }


  .experience-responsibilities ul {
    display:
      grid;

    gap:
      0.5rem;

    margin:
      0;

    padding:
      0;

    list-style:
      none;
  }


  .experience-responsibilities li {
    display:
      grid;

    grid-template-columns:
      7px 1fr;

    align-items:
      start;

    gap:
      0.5rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.7rem;

    line-height:
      1.65;
  }


  .bullet-node {
    width:
      4px;

    height:
      4px;

    margin-top:
      0.48rem;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      transparent;
  }


  /* ========================================================
     TECHNOLOGIES
     ======================================================== */

  .experience-technologies {
    margin-top:
      1rem;

    padding-top:
      0.85rem;

    border-top:
      1px solid rgba(148, 163, 184, 0.06);
  }


  .technology-list {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.4rem;
  }


  .technology-chip {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.3rem 0.45rem;

    border:
      1px solid rgba(34, 211, 238, 0.12);

    border-radius:
      0.2rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(34, 211, 238, 0.012);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;
  }


  .technology-chip-node {
    color:
      var(--color-cyan);

    font-size:
      0.32rem;
  }


  .technology-violet {
    border-color:
      rgba(139, 92, 246, 0.12);
  }


  .technology-violet
    .technology-chip-node {

    color:
      var(--color-violet);
  }


  .technology-blue {
    border-color:
      rgba(59, 130, 246, 0.12);
  }


  .technology-blue
    .technology-chip-node {

    color:
      var(--color-blue);
  }


  .technology-green {
    border-color:
      rgba(74, 222, 128, 0.12);
  }


  .technology-green
    .technology-chip-node {

    color:
      #4ade80;
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .experience-footer {
    display:
      flex;

    align-items:
      center;

    gap:
      0.5rem;

    margin-top:
      1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;

    letter-spacing:
      0.04em;
  }


  .footer-line {
    flex:
      1;

    height:
      1px;

    background:
      var(--color-border);
  }


  .footer-signal {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      8px;

    height:
      8px;

    border:
      1px solid var(--color-border);

    border-radius:
      50%;
  }


  .footer-signal span {
    width:
      2px;

    height:
      2px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 5px rgba(34, 211, 238, 0.5);
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .experience-card-featured
    .experience-content {

    border-color:
      rgba(34, 211, 238, 0.13);

  }


  .experience-card-featured
    .timeline-node {

    box-shadow:
      0 0 22px rgba(34, 211, 238, 0.18);

  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .experience-content {

    background:
      rgba(15, 23, 42, 0.012);

  }


  :global([data-theme="light"])
    .experience-card:hover
    .experience-content {

    background:
      rgba(14, 116, 144, 0.015);

    box-shadow:
      0 20px 60px rgba(15, 23, 42, 0.06);

  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .experience-card {
      grid-template-columns:
        24px minmax(0, 1fr);

      gap:
        0.55rem;
    }


    .experience-content {
      padding:
        0.9rem;
    }


    .experience-company-row {
      display:
        block;
    }


    .experience-status {
      margin-top:
        0.5rem;
    }


    .experience-summary {
      font-size:
        0.7rem;
    }

  }


  @media (max-width: 480px) {

    .experience-card {
      grid-template-columns:
        18px minmax(0, 1fr);
    }


    .experience-header {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        0.4rem;
    }


    .experience-date {
      order:
        -1;
    }


    .experience-company h3 {
      font-size:
        1rem;
    }


    .experience-role {
      font-size:
        0.38rem;
    }


    .experience-responsibilities li {
      font-size:
        0.65rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .timeline-node-core,
    .experience-content {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
