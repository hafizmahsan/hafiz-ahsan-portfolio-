---
/**
 * ============================================================
 * EXPERIENCE CARD
 * ============================================================
 *
 * Reusable professional experience / career timeline card.
 *
 * Designed for:
 * - Employment history
 * - Consulting engagements
 * - Client assignments
 * - Architecture roles
 * - Career milestones
 *
 * The component receives data through props so that the
 * experience content can later be maintained from a central
 * data file.
 *
 * ============================================================
 */

interface ExperienceItem {
  title: string;
  company: string;
  location?: string;
  period: string;
  employmentType?: string;
  description?: string;
  highlights?: string[];
  technologies?: string[];
  current?: boolean;
}

interface Props {
  experience: ExperienceItem;
  index?: string;
  accent?: "cyan" | "violet" | "blue" | "green";
}

const {
  experience,
  index = "01",
  accent = "cyan"
} = Astro.props;
---

<article
  class:list={[
    "experience-card",
    `experience-card-${accent}`,
    {
      "experience-card-current": experience.current
    }
  ]}
>

  <!-- ======================================================
       TIMELINE
       ====================================================== -->

  <div class="experience-timeline" aria-hidden="true">

    <div class="timeline-node">

      <span class="timeline-node-core"></span>

    </div>

    <div class="timeline-line"></div>

  </div>


  <!-- ======================================================
       MAIN CARD
       ====================================================== -->

  <div class="experience-content">

    <!-- ====================================================
         HEADER
         ==================================================== -->

    <header class="experience-header">

      <div class="experience-heading">

        <div class="experience-index">
          {index}
        </div>

        <div>

          <h3 class="experience-title">
            {experience.title}
          </h3>

          <div class="experience-company">
            {experience.company}
          </div>

        </div>

      </div>


      <div class="experience-meta">

        <span class="experience-period">
          {experience.period}
        </span>

        {
          experience.current && (
            <span class="experience-current">

              <span
                class="experience-current-dot"
                aria-hidden="true"
              ></span>

              CURRENT

            </span>
          )
        }

      </div>

    </header>


    <!-- ====================================================
         INFORMATION ROW
         ==================================================== -->

    <div class="experience-info">

      {
        experience.location && (
          <span class="experience-info-item">

            <span
              class="info-icon"
              aria-hidden="true"
            >
              ◇
            </span>

            {experience.location}

          </span>
        )
      }


      {
        experience.employmentType && (
          <span class="experience-info-item">

            <span
              class="info-icon"
              aria-hidden="true"
            >
              ◈
            </span>

            {experience.employmentType}

          </span>
        )
      }

    </div>


    <!-- ====================================================
         DESCRIPTION
         ==================================================== -->

    {
      experience.description && (
        <p class="experience-description">
          {experience.description}
        </p>
      )
    }


    <!-- ====================================================
         HIGHLIGHTS
         ==================================================== -->

    {
      experience.highlights?.length && (
        <div class="experience-highlights">

          <div class="highlights-label">

            <span class="highlights-label-node"></span>

            KEY CONTRIBUTIONS

          </div>


          <ul>

            {
              experience.highlights.map((highlight) => (
                <li>
                  <span
                    class="highlight-marker"
                    aria-hidden="true"
                  ></span>

                  <span>
                    {highlight}
                  </span>
                </li>
              ))
            }

          </ul>

        </div>
      )
    }


    <!-- ====================================================
         TECHNOLOGIES
         ==================================================== -->

    {
      experience.technologies?.length && (
        <div class="experience-technologies">

          <div class="technologies-label">
            TECHNOLOGY / DOMAIN
          </div>

          <div class="technology-list">

            {
              experience.technologies.map((technology) => (
                <span class="technology-item">
                  {technology}
                </span>
              ))
            }

          </div>

        </div>
      )
    }


    <!-- ====================================================
         FOOTER SIGNAL
         ==================================================== -->

    <div
      class="experience-footer"
      aria-hidden="true"
    >

      <span class="footer-node"></span>

      <span class="footer-line"></span>

      <span class="footer-code">
        EXPERIENCE.NODE_{index}
      </span>

      <span class="footer-line"></span>

      <span class="footer-node footer-node-secondary"></span>

    </div>

  </div>

</article>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .experience-card {
    --experience-accent:
      #22d3ee;

    --experience-accent-soft:
      rgba(34, 211, 238, 0.08);

    --experience-accent-border:
      rgba(34, 211, 238, 0.16);

    position:
      relative;

    display:
      grid;

    grid-template-columns:
      32px 1fr;

    column-gap:
      1.25rem;

    width:
      100%;
  }


  /* ========================================================
     TIMELINE
     ======================================================== */

  .experience-timeline {
    position:
      relative;

    display:
      flex;

    justify-content:
      center;

    min-height:
      100%;
  }


  .timeline-node {
    position:
      relative;

    z-index:
      2;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      15px;

    height:
      15px;

    margin-top:
      1.15rem;

    border:
      1px solid var(--experience-accent-border);

    border-radius:
      50%;

    background:
      var(--color-bg);

    box-shadow:
      0 0 20px var(--experience-accent-soft);
  }


  .timeline-node::before {
    content:
      "";

    position:
      absolute;

    inset:
      -5px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--experience-accent) 7%,
        transparent
      );

    border-radius:
      50%;

    animation:
      experience-node-pulse 3s ease-in-out infinite;
  }


  .timeline-node-core {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--experience-accent);

    box-shadow:
      0 0 9px var(--experience-accent);
  }


  .timeline-line {
    position:
      absolute;

    top:
      2rem;

    bottom:
      -1.5rem;

    width:
      1px;

    background:
      linear-gradient(
        180deg,
        var(--experience-accent-border),
        var(--color-border),
        transparent
      );
  }


  @keyframes experience-node-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.9);
    }

    50% {
      opacity:
        0.9;

      transform:
        scale(1.1);
    }

  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .experience-content {
    position:
      relative;

    margin-bottom:
      1.5rem;

    padding:
      1.2rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.5rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .experience-content::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      2px;

    height:
      100%;

    background:
      linear-gradient(
        180deg,
        var(--experience-accent),
        transparent
      );

    opacity:
      0.35;
  }


  .experience-content::after {
    content:
      "";

    position:
      absolute;

    right:
      -80px;

    top:
      -80px;

    width:
      180px;

    height:
      180px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        var(--experience-accent-soft),
        transparent 70%
      );

    pointer-events:
      none;
  }


  .experience-content:hover {
    transform:
      translateY(-3px);

    border-color:
      var(--experience-accent-border);

    background:
      rgba(148, 163, 184, 0.018);

    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.15),
      0 0 35px var(--experience-accent-soft);
  }


  /* ========================================================
     HEADER
     ======================================================== */

  .experience-header {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      flex-start;

    justify-content:
      space-between;

    gap:
      1.5rem;
  }


  .experience-heading {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      0.75rem;

    min-width:
      0;
  }


  .experience-index {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      24px;

    height:
      20px;

    flex-shrink:
      0;

    margin-top:
      0.15rem;

    border:
      1px solid var(--experience-accent-border);

    border-radius:
      0.15rem;

    color:
      var(--experience-accent);

    background:
      var(--experience-accent-soft);

    font-family:
      var(--font-mono);

    font-size:
      0.22rem;

    letter-spacing:
      0.025em;
  }


  .experience-title {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1rem, 2vw, 1.4rem);

    font-weight:
      600;

    letter-spacing:
      -0.035em;

    line-height:
      1.15;
  }


  .experience-company {
    margin-top:
      0.35rem;

    color:
      var(--experience-accent);

    font-family:
      var(--font-mono);

    font-size:
      0.28rem;

    letter-spacing:
      0.035em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     META
     ======================================================== */

  .experience-meta {
    display:
      flex;

    flex-direction:
      column;

    align-items:
      flex-end;

    gap:
      0.4rem;

    flex-shrink:
      0;
  }


  .experience-period {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;

    letter-spacing:
      0.025em;

    white-space:
      nowrap;
  }


  .experience-current {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.2rem 0.4rem;

    border:
      1px solid rgba(74, 222, 128, 0.18);

    border-radius:
      999px;

    color:
      rgba(134, 239, 172, 0.8);

    background:
      rgba(74, 222, 128, 0.025);

    font-family:
      var(--font-mono);

    font-size:
      0.2rem;

    letter-spacing:
      0.035em;
  }


  .experience-current-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      #4ade80;

    box-shadow:
      0 0 7px rgba(74, 222, 128, 0.65);

    animation:
      current-dot-pulse 2s ease-in-out infinite;
  }


  @keyframes current-dot-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     INFO
     ======================================================== */

  .experience-info {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.5rem 1rem;

    margin-top:
      1rem;

    padding-top:
      0.7rem;

    border-top:
      1px solid var(--color-border);
  }


  .experience-info-item {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.23rem;

    letter-spacing:
      0.02em;
  }


  .info-icon {
    color:
      var(--experience-accent);

    font-size:
      0.45rem;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .experience-description {
    position:
      relative;

    z-index:
      1;

    max-width:
      850px;

    margin:
      1rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.72rem;

    line-height:
      1.7;
  }


  /* ========================================================
     HIGHLIGHTS
     ======================================================== */

  .experience-highlights {
    position:
      relative;

    z-index:
      1;

    margin-top:
      1.1rem;
  }


  .highlights-label,
  .technologies-label {
    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.22rem;

    letter-spacing:
      0.035em;
  }


  .highlights-label-node {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--experience-accent);

    box-shadow:
      0 0 6px var(--experience-accent);
  }


  .experience-highlights ul {
    display:
      grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      0.6rem 1.5rem;

    margin:
      0.7rem 0 0;

    padding:
      0;

    list-style:
      none;
  }


  .experience-highlights li {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      0.45rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.62rem;

    line-height:
      1.55;
  }


  .highlight-marker {
    width:
      5px;

    height:
      5px;

    flex-shrink:
      0;

    margin-top:
      0.4rem;

    border:
      1px solid var(--experience-accent);

    transform:
      rotate(45deg);
  }


  /* ========================================================
     TECHNOLOGIES
     ======================================================== */

  .experience-technologies {
    position:
      relative;

    z-index:
      1;

    margin-top:
      1.2rem;
  }


  .technology-list {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.35rem;

    margin-top:
      0.55rem;
  }


  .technology-item {
    padding:
      0.28rem 0.5rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.2rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(148, 163, 184, 0.015);

    font-family:
      var(--font-mono);

    font-size:
      0.21rem;

    letter-spacing:
      0.02em;

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }


  .technology-item:hover {
    border-color:
      var(--experience-accent-border);

    color:
      var(--experience-accent);
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .experience-footer {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    margin-top:
      1.25rem;
  }


  .footer-node {
    width:
      4px;

    height:
      4px;

    flex-shrink:
      0;

    border:
      1px solid var(--experience-accent-border);

    border-radius:
      50%;
  }


  .footer-node-secondary {
    border-color:
      rgba(139, 92, 246, 0.3);
  }


  .footer-line {
    width:
      35px;

    height:
      1px;

    background:
      var(--color-border);
  }


  .footer-code {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.18rem;

    letter-spacing:
      0.025em;

    white-space:
      nowrap;
  }


  /* ========================================================
     ACCENT VARIANTS
     ======================================================== */

  .experience-card-cyan {
    --experience-accent:
      #22d3ee;

    --experience-accent-soft:
      rgba(34, 211, 238, 0.08);

    --experience-accent-border:
      rgba(34, 211, 238, 0.16);
  }


  .experience-card-violet {
    --experience-accent:
      #8b5cf6;

    --experience-accent-soft:
      rgba(139, 92, 246, 0.08);

    --experience-accent-border:
      rgba(139, 92, 246, 0.16);
  }


  .experience-card-blue {
    --experience-accent:
      #3b82f6;

    --experience-accent-soft:
      rgba(59, 130, 246, 0.08);

    --experience-accent-border:
      rgba(59, 130, 246, 0.16);
  }


  .experience-card-green {
    --experience-accent:
      #4ade80;

    --experience-accent-soft:
      rgba(74, 222, 128, 0.08);

    --experience-accent-border:
      rgba(74, 222, 128, 0.16);
  }


  /* ========================================================
     CURRENT EXPERIENCE
     ======================================================== */

  .experience-card-current
    .experience-content {

    border-color:
      rgba(34, 211, 238, 0.12);

    box-shadow:
      inset 0 0 35px rgba(34, 211, 238, 0.012);
  }


  .experience-card-current
    .experience-index {

    box-shadow:
      0 0 18px rgba(34, 211, 238, 0.06);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .experience-content {

    background:
      rgba(15, 23, 42, 0.012);
  }


  :global([data-theme="light"])
    .timeline-node {

    background:
      var(--color-bg);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .experience-card {
      grid-template-columns:
        20px 1fr;

      column-gap:
        0.7rem;
    }


    .experience-content {
      padding:
        0.9rem;
    }


    .timeline-node {
      width:
        12px;

      height:
        12px;
    }


    .timeline-node-core {
      width:
        4px;

      height:
        4px;
    }


    .experience-header {
      flex-direction:
        column;

      gap:
        0.7rem;
    }


    .experience-meta {
      align-items:
        flex-start;

      flex-direction:
        row;

      flex-wrap:
        wrap;
    }


    .experience-highlights ul {
      grid-template-columns:
        1fr;
    }


    .experience-description {
      font-size:
        0.65rem;
    }

  }


  @media (max-width: 430px) {

    .experience-card {
      grid-template-columns:
        15px 1fr;

      column-gap:
        0.5rem;
    }


    .experience-content {
      padding:
        0.75rem;
    }


    .experience-index {
      display:
        none;
    }


    .experience-heading {
      gap:
        0;
    }


    .experience-title {
      font-size:
        0.95rem;
    }


    .experience-company {
      font-size:
        0.24rem;
    }


    .experience-period {
      font-size:
        0.22rem;
    }


    .experience-info-item {
      font-size:
        0.2rem;
    }


    .experience-description {
      font-size:
        0.61rem;
    }


    .technology-item {
      font-size:
        0.19rem;
    }


    .footer-line {
      width:
        20px;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .timeline-node::before,
    .experience-current-dot {
      animation:
        none;
    }


    .experience-content {
      transition:
        none;
    }

  }
</style>
