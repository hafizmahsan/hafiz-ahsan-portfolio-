---
/**
 * ============================================================
 * PROJECT CARD
 * ============================================================
 *
 * Reusable project / portfolio item.
 *
 * ============================================================
 */

import Link from "./Link.astro";
import Stack from "./Stack.astro";
import TagList from "./TagList.astro";
import StatusIndicator from "./StatusIndicator.astro";

interface Props {
  number?: string;

  title: string;

  description: string;

  technologies?: string[];

  href?: string;

  status?: string;

  statusVariant?:
    | "online"
    | "available"
    | "current"
    | "progress"
    | "complete"
    | "offline"
    | "warning";

  category?: string;

  featured?: boolean;

  class?: string;
}

const {
  number,
  title,
  description,
  technologies = [],
  href,
  status,
  statusVariant = "complete",
  category,
  featured = false,
  class: className = ""
} = Astro.props;
---

<article
  class:list={[
    "project-card",
    {
      "project-card--featured":
        featured
    },
    className
  ]}
>
  <Stack gap="lg">

    <div class="project-card__top">

      {
        number && (
          <span class="project-card__number">
            {number}
          </span>
        )
      }

      {
        status && (
          <StatusIndicator
            label={status}
            variant={statusVariant}
          />
        )
      }

    </div>


    <div class="project-card__heading">

      {
        category && (
          <span class="project-card__category">
            {category}
          </span>
        )
      }

      <h3 class="project-card__title">
        {title}
      </h3>

    </div>


    <p class="project-card__description">
      {description}
    </p>


    {
      technologies.length > 0 && (
        <TagList
          items={technologies}
          variant="cyan"
          size="sm"
        />
      )
    }


    {
      href && (
        <Link
          href={href}
          label="VIEW PROJECT"
          icon="arrow-up-right"
        />
      )
    }

  </Stack>
</article>


<style>
  .project-card {
    position: relative;

    min-width: 0;

    height: 100%;

    padding: 1.5rem;

    border:
      1px solid
      rgba(148, 163, 184, 0.12);

    border-radius:
      0.5rem;

    background:
      linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.7),
        rgba(2, 6, 23, 0.82)
      );

    box-shadow:
      0 20px 50px
      rgba(0, 0, 0, 0.16);

    overflow: hidden;

    transition:
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }


  .project-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(103, 232, 249, 0.35),
        transparent
      );

    opacity: 0.45;
  }


  .project-card:hover {
    border-color:
      rgba(103, 232, 249, 0.28);

    transform:
      translateY(-4px);

    box-shadow:
      0 28px 70px
      rgba(0, 0, 0, 0.24);
  }


  /* ========================================================
     TOP
     ======================================================== */

  .project-card__top {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    min-height: 1rem;
  }


  .project-card__number {
    color:
      rgba(103, 232, 249, 0.55);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.68rem;

    font-weight: 700;

    letter-spacing: 0.1em;
  }


  /* ========================================================
     HEADING
     ======================================================== */

  .project-card__heading {
    display: flex;

    flex-direction: column;

    gap: 0.65rem;
  }


  .project-card__category {
    color:
      rgba(148, 163, 184, 0.65);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.6rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
  }


  .project-card__title {
    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(1.35rem, 2.5vw, 1.8rem);

    font-weight: 700;

    letter-spacing: -0.035em;

    line-height: 1.05;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .project-card__description {
    margin: 0;

    color:
      rgba(148, 163, 184, 0.9);

    font-size: 0.9rem;

    line-height: 1.7;
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .project-card--featured {
    border-color:
      rgba(103, 232, 249, 0.2);

    background:
      linear-gradient(
        145deg,
        rgba(8, 47, 73, 0.38),
        rgba(2, 6, 23, 0.86)
      );
  }


  .project-card--featured::before {
    opacity: 1;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(103, 232, 249, 0.65),
        transparent
      );
  }


  @media (max-width: 640px) {
    .project-card {
      padding: 1.25rem;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
