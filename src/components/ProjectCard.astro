---
/**
 * ============================================================
 * PROJECT CARD
 * ============================================================
 *
 * Reusable project showcase component.
 *
 * Supports:
 * - Project imagery
 * - Project metadata
 * - Technology chips
 * - GitHub / live links
 * - Featured projects
 * - Technical network overlays
 * - Responsive layouts
 *
 * ============================================================
 */

interface Technology {
  name: string;
  accent?: "cyan" | "violet" | "blue" | "green";
}

interface Props {
  title: string;
  description: string;
  category?: string;
  image?: string;
  imageAlt?: string;
  technologies?: Technology[];
  githubUrl?: string;
  liveUrl?: string;
  index?: string;
  status?: "LIVE" | "ARCHIVED" | "CONCEPT" | "IN DEVELOPMENT";
  featured?: boolean;
  year?: string;
}

const {
  title,
  description,
  category = "PROJECT",
  image,
  imageAlt = "",
  technologies = [],
  githubUrl,
  liveUrl,
  index = "01",
  status = "LIVE",
  featured = false,
  year
} = Astro.props;
---

<article
  class:list={[
    "project-card",
    {
      "project-card-featured": featured
    }
  ]}
>

  <!-- ======================================================
       PROJECT VISUAL
       ====================================================== -->

  <div class="project-visual">

    {
      image ? (
        <img
          src={image}
          alt={imageAlt || title}
          class="project-image"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div
          class="project-image-placeholder"
          aria-hidden="true"
        >
          <span class="placeholder-grid"></span>
        </div>
      )
    }


    <!-- ====================================================
         IMAGE OVERLAY
         ==================================================== -->

    <div class="visual-overlay"></div>


    <!-- ====================================================
         TECHNICAL GRID
         ==================================================== -->

    <div
      class="visual-grid"
      aria-hidden="true"
    ></div>


    <!-- ====================================================
         NETWORK
         ==================================================== -->

    <div
      class="visual-network"
      aria-hidden="true"
    >

      <span class="network-line network-line-1"></span>

      <span class="network-line network-line-2"></span>

      <span class="network-line network-line-3"></span>

      <span class="network-node network-node-1"></span>

      <span class="network-node network-node-2"></span>

      <span class="network-node network-node-3"></span>

      <span class="network-node network-node-4"></span>

    </div>


    <!-- ====================================================
         TOP META
         ==================================================== -->

    <div class="visual-top">

      <span class="project-index">
        {index}
      </span>

      <span class="project-category">
        {category}
      </span>

      {
        year && (
          <span class="project-year">
            {year}
          </span>
        )
      }

    </div>


    <!-- ====================================================
         STATUS
         ==================================================== -->

    <div class="project-status">

      <span class="status-indicator"></span>

      {status}

    </div>


    <!-- ====================================================
         HOVER ARROW
         ==================================================== -->

    <span
      class="project-arrow"
      aria-hidden="true"
    >
      ↗
    </span>

  </div>


  <!-- ======================================================
       CONTENT
       ====================================================== -->

  <div class="project-content">

    <!-- ====================================================
         TITLE
         ==================================================== -->

    <div class="project-title-row">

      <h3 class="project-title">
        {title}
      </h3>

      <span
        class="title-node"
        aria-hidden="true"
      >
        ◇
      </span>

    </div>


    <!-- ====================================================
         DESCRIPTION
         ==================================================== -->

    <p class="project-description">
      {description}
    </p>


    <!-- ====================================================
         TECHNOLOGIES
         ==================================================== -->

    {
      technologies.length > 0 && (
        <div class="project-technologies">

          {
            technologies.map((technology) => (
              <span
                class:list={[
                  "technology-chip",
                  `technology-${technology.accent || "cyan"}`
                ]}
              >

                <span
                  class="chip-node"
                  aria-hidden="true"
                >
                  •
                </span>

                {technology.name}

              </span>
            ))
          }

        </div>
      )
    }


    <!-- ====================================================
         FOOTER
         ==================================================== -->

    <footer class="project-footer">

      <div class="project-links">

        {
          githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link"
              aria-label={`View ${title} source code on GitHub`}
            >
              <span class="link-icon">
                ↗
              </span>

              <span>
                GITHUB
              </span>
            </a>
          )
        }


        {
          liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="project-link project-link-primary"
              aria-label={`View ${title} live project`}
            >
              <span class="link-icon">
                ◉
              </span>

              <span>
                LIVE
              </span>
            </a>
          )
        }

      </div>


      <div
        class="project-signal"
        aria-hidden="true"
      >

        <span></span>

      </div>

    </footer>

  </div>

</article>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .project-card {
    position:
      relative;

    min-width:
      0;

    border:
      1px solid var(--color-border);

    border-radius:
      0.65rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .project-card:hover {
    transform:
      translateY(-6px);

    border-color:
      rgba(34, 211, 238, 0.2);

    background:
      rgba(34, 211, 238, 0.012);

    box-shadow:
      0 25px 70px rgba(0, 0, 0, 0.13);
  }


  /* ========================================================
     VISUAL
     ======================================================== */

  .project-visual {
    position:
      relative;

    aspect-ratio:
      16 / 10;

    overflow:
      hidden;

    background:
      #07111d;
  }


  /* ========================================================
     IMAGE
     ======================================================== */

  .project-image {
    position:
      absolute;

    inset:
      0;

    width:
      100%;

    height:
      100%;

    object-fit:
      cover;

    opacity:
      0.72;

    transform:
      scale(1.01);

    filter:
      saturate(0.75)
      contrast(1.08);

    transition:
      transform 700ms var(--ease-standard),
      opacity 500ms var(--ease-standard),
      filter 500ms var(--ease-standard);
  }


  .project-card:hover
    .project-image {

    opacity:
      0.88;

    transform:
      scale(1.055);

    filter:
      saturate(1)
      contrast(1.04);
  }


  /* ========================================================
     PLACEHOLDER
     ======================================================== */

  .project-image-placeholder {
    position:
      absolute;

    inset:
      0;

    background:
      radial-gradient(
        circle at 25% 25%,
        rgba(34, 211, 238, 0.08),
        transparent 28%
      ),
      radial-gradient(
        circle at 75% 75%,
        rgba(139, 92, 246, 0.09),
        transparent 30%
      ),
      #07111d;
  }


  .placeholder-grid {
    position:
      absolute;

    inset:
      0;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.06) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.06) 1px,
        transparent 1px
      );

    background-size:
      30px 30px;

    mask-image:
      linear-gradient(
        135deg,
        black,
        transparent
      );
  }


  /* ========================================================
     OVERLAY
     ======================================================== */

  .visual-overlay {
    position:
      absolute;

    inset:
      0;

    background:
      linear-gradient(
        180deg,
        rgba(2, 6, 23, 0.55),
        transparent 40%,
        rgba(2, 6, 23, 0.88)
      );

    pointer-events:
      none;
  }


  /* ========================================================
     GRID
     ======================================================== */

  .visual-grid {
    position:
      absolute;

    inset:
      0;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.045) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.045) 1px,
        transparent 1px
      );

    background-size:
      32px 32px;

    opacity:
      0.35;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 75%
      );

    pointer-events:
      none;
  }


  /* ========================================================
     NETWORK
     ======================================================== */

  .visual-network {
    position:
      absolute;

    inset:
      0;

    pointer-events:
      none;

    opacity:
      0.75;
  }


  .network-line {
    position:
      absolute;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.5),
        transparent
      );

    transform-origin:
      left center;
  }


  .network-line-1 {
    top:
      34%;

    left:
      7%;

    width:
      44%;

    transform:
      rotate(18deg);
  }


  .network-line-2 {
    top:
      67%;

    left:
      34%;

    width:
      48%;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(139, 92, 246, 0.48),
        transparent
      );

    transform:
      rotate(-13deg);
  }


  .network-line-3 {
    top:
      45%;

    right:
      9%;

    width:
      32%;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.4),
        transparent
      );

    transform:
      rotate(38deg);
  }


  .network-node {
    position:
      absolute;

    width:
      5px;

    height:
      5px;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      rgba(7, 17, 29, 0.9);

    box-shadow:
      0 0 9px rgba(34, 211, 238, 0.45);

    animation:
      project-node-pulse 3s ease-in-out infinite;
  }


  .network-node-1 {
    top:
      30%;

    left:
      8%;
  }


  .network-node-2 {
    top:
      50%;

    left:
      49%;

    animation-delay:
      0.7s;
  }


  .network-node-3 {
    top:
      68%;

    right:
      12%;

    border-color:
      var(--color-violet);

    box-shadow:
      0 0 9px rgba(139, 92, 246, 0.45);

    animation-delay:
      1.2s;
  }


  .network-node-4 {
    top:
      38%;

    right:
      34%;

    animation-delay:
      1.8s;
  }


  @keyframes project-node-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.8);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1.25);
    }

  }


  /* ========================================================
     TOP META
     ======================================================== */

  .visual-top {
    position:
      absolute;

    top:
      0.75rem;

    left:
      0.75rem;

    right:
      0.75rem;

    display:
      flex;

    align-items:
      center;

    gap:
      0.5rem;
  }


  .project-index,
  .project-category,
  .project-year {
    padding:
      0.25rem 0.38rem;

    border:
      1px solid rgba(148, 163, 184, 0.15);

    border-radius:
      0.2rem;

    background:
      rgba(2, 6, 23, 0.5);

    backdrop-filter:
      blur(8px);

    color:
      rgba(226, 232, 240, 0.75);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;

    letter-spacing:
      0.035em;

    text-transform:
      uppercase;
  }


  .project-category {
    color:
      var(--color-cyan);
  }


  .project-year {
    margin-left:
      auto;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .project-status {
    position:
      absolute;

    bottom:
      0.7rem;

    left:
      0.75rem;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    padding:
      0.28rem 0.4rem;

    border:
      1px solid rgba(148, 163, 184, 0.12);

    border-radius:
      0.2rem;

    background:
      rgba(2, 6, 23, 0.5);

    backdrop-filter:
      blur(8px);

    color:
      rgba(226, 232, 240, 0.65);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;

    letter-spacing:
      0.035em;
  }


  .status-indicator {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      #4ade80;

    box-shadow:
      0 0 7px rgba(74, 222, 128, 0.7);
  }


  /* ========================================================
     ARROW
     ======================================================== */

  .project-arrow {
    position:
      absolute;

    right:
      0.75rem;

    bottom:
      0.65rem;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      30px;

    height:
      30px;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      50%;

    background:
      rgba(2, 6, 23, 0.45);

    backdrop-filter:
      blur(8px);

    color:
      var(--color-cyan);

    font-size:
      0.8rem;

    opacity:
      0;

    transform:
      translate(-5px, 5px);

    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }


  .project-card:hover
    .project-arrow {

    opacity:
      1;

    transform:
      translate(0, 0);
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .project-content {
    padding:
      1rem 1.05rem 0.9rem;
  }


  /* ========================================================
     TITLE
     ======================================================== */

  .project-title-row {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      0.75rem;
  }


  .project-title {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1rem, 2vw, 1.25rem);

    font-weight:
      600;

    letter-spacing:
      -0.025em;

    line-height:
      1.25;
  }


  .title-node {
    flex-shrink:
      0;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.55rem;

    opacity:
      0.6;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .project-description {
    margin:
      0.55rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.7rem;

    line-height:
      1.7;
  }


  /* ========================================================
     TECHNOLOGIES
     ======================================================== */

  .project-technologies {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.35rem;

    margin-top:
      0.8rem;
  }


  .technology-chip {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.25rem;

    padding:
      0.27rem 0.38rem;

    border:
      1px solid rgba(34, 211, 238, 0.1);

    border-radius:
      0.18rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(34, 211, 238, 0.012);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;
  }


  .chip-node {
    color:
      var(--color-cyan);

    font-size:
      0.4rem;
  }


  .technology-violet {
    border-color:
      rgba(139, 92, 246, 0.12);
  }


  .technology-violet
    .chip-node {

    color:
      var(--color-violet);
  }


  .technology-blue {
    border-color:
      rgba(59, 130, 246, 0.12);
  }


  .technology-blue
    .chip-node {

    color:
      var(--color-blue);
  }


  .technology-green {
    border-color:
      rgba(74, 222, 128, 0.12);
  }


  .technology-green
    .chip-node {

    color:
      #4ade80;
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .project-footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      0.75rem;

    margin-top:
      1rem;

    padding-top:
      0.75rem;

    border-top:
      1px solid rgba(148, 163, 184, 0.06);
  }


  .project-links {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.4rem;
  }


  .project-link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.3rem 0.45rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.2rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.26rem;

    text-decoration:
      none;

    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }


  .project-link:hover {
    border-color:
      rgba(34, 211, 238, 0.2);

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.02);
  }


  .project-link-primary {
    border-color:
      rgba(34, 211, 238, 0.14);

    color:
      var(--color-cyan);
  }


  .link-icon {
    font-size:
      0.4rem;
  }


  .project-signal {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      10px;

    height:
      10px;

    border:
      1px solid var(--color-border);

    border-radius:
      50%;
  }


  .project-signal span {
    width:
      2px;

    height:
      2px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 6px rgba(34, 211, 238, 0.6);
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .project-card-featured {
    border-color:
      rgba(34, 211, 238, 0.12);
  }


  .project-card-featured
    .project-visual {

    aspect-ratio:
      16 / 9;
  }


  .project-card-featured
    .project-title {

    font-size:
      clamp(1.1rem, 2.4vw, 1.4rem);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .project-card {

    background:
      rgba(15, 23, 42, 0.012);

  }


  :global([data-theme="light"])
    .project-card:hover {

    background:
      rgba(14, 116, 144, 0.012);

    box-shadow:
      0 25px 70px rgba(15, 23, 42, 0.07);

  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .project-content {
      padding:
        0.9rem;
    }


    .project-description {
      font-size:
        0.67rem;
    }


    .project-arrow {
      opacity:
        1;

      transform:
        translate(0, 0);

      width:
        26px;

      height:
        26px;
    }

  }


  @media (max-width: 480px) {

    .project-visual {
      aspect-ratio:
        4 / 3;
    }


    .project-card-featured
      .project-visual {

      aspect-ratio:
        4 / 3;
    }


    .project-index,
    .project-category,
    .project-year {
      font-size:
        0.24rem;
    }


    .project-title {
      font-size:
        0.95rem;
    }


    .project-description {
      font-size:
        0.64rem;

      line-height:
        1.65;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .project-card,
    .project-image,
    .project-arrow,
    .network-node {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
