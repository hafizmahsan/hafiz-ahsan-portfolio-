---
/**
 * ============================================================
 * SECTION HEADER
 * ============================================================
 *
 * Reusable heading system for major portfolio sections.
 *
 * Keeps section presentation consistent while allowing
 * content to be changed independently.
 *
 * ============================================================
 */

interface Props {
  number?: string;
  eyebrow?: string;
  title: string;
  highlight?: string;
  description?: string;
  align?: "left" | "center";
  status?: string;
  id?: string;
}

const {
  number,
  eyebrow = "SYSTEM / SECTION",
  title,
  highlight,
  description,
  align = "left",
  status,
  id
} = Astro.props;
---

<header
  class:list={[
    "section-header",
    `section-header-${align}`
  ]}
  id={id}
>

  <!-- ======================================================
       TECHNICAL META
       ====================================================== -->

  <div class="section-meta">

    <div class="section-identifier">

      {
        number && (
          <span class="section-number">
            {number}
          </span>
        )
      }

      <span class="section-slash">
        //
      </span>

      <span class="section-eyebrow">
        {eyebrow}
      </span>

    </div>


    {
      status && (
        <span class="section-status">

          <span class="status-node"></span>

          {status}

        </span>
      )
    }

  </div>


  <!-- ======================================================
       HEADING
       ====================================================== -->

  <h2 class="section-title">

    <span>
      {title}
    </span>

    {
      highlight && (
        <>
          {" "}

          <span class="section-highlight">
            {highlight}
          </span>
        </>
      )
    }

  </h2>


  <!-- ======================================================
       DESCRIPTION
       ====================================================== -->

  {
    description && (
      <p class="section-description">
        {description}
      </p>
    )
  }


  <!-- ======================================================
       DECORATIVE TERMINAL LINE
       ====================================================== -->

  <div
    class="section-line"
    aria-hidden="true"
  >

    <span class="line-start"></span>

    <span class="line-main"></span>

    <span class="line-node"></span>

    <span class="line-end"></span>

  </div>

</header>


<style>
  /* ========================================================
     HEADER
     ======================================================== */

  .section-header {
    width:
      100%;

    margin-bottom:
      3rem;
  }


  .section-header-center {
    text-align:
      center;
  }


  /* ========================================================
     META
     ======================================================== */

  .section-meta {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-bottom:
      0.85rem;
  }


  .section-identifier {
    display:
      flex;

    align-items:
      center;

    gap:
      0.45rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    letter-spacing:
      0.055em;

    text-transform:
      uppercase;
  }


  .section-number {
    color:
      var(--color-cyan);

    opacity:
      0.85;
  }


  .section-slash {
    color:
      var(--color-text-subtle);

    opacity:
      0.55;
  }


  .section-eyebrow {
    color:
      var(--color-text-subtle);
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .section-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    padding:
      0.3rem 0.45rem;

    border:
      1px solid rgba(34, 211, 238, 0.12);

    border-radius:
      0.25rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(34, 211, 238, 0.02);

    font-family:
      var(--font-mono);

    font-size:
      0.32rem;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  .status-node {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 8px rgba(34, 211, 238, 0.6);

    animation:
      section-status-pulse 2.2s ease-in-out infinite;
  }


  @keyframes section-status-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     TITLE
     ======================================================== */

  .section-title {
    max-width:
      850px;

    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(
        2rem,
        5vw,
        4.2rem
      );

    font-weight:
      500;

    line-height:
      0.98;

    letter-spacing:
      -0.065em;
  }


  .section-highlight {
    color:
      transparent;

    background:
      linear-gradient(
        100deg,
        var(--color-cyan),
        #7dd3fc 45%,
        var(--color-violet)
      );

    background-clip:
      text;

    -webkit-background-clip:
      text;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .section-description {
    max-width:
      650px;

    margin:
      1.15rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      0.62rem;

    line-height:
      1.8;
  }


  .section-header-center
    .section-description {

    margin-right:
      auto;

    margin-left:
      auto;

  }


  /* ========================================================
     DECORATIVE LINE
     ======================================================== */

  .section-line {
    display:
      flex;

    align-items:
      center;

    width:
      min(
        100%,
        360px
      );

    margin-top:
      1.5rem;

    overflow:
      hidden;
  }


  .section-header-center
    .section-line {

    margin-right:
      auto;

    margin-left:
      auto;

  }


  .line-start {
    width:
      4px;

    height:
      4px;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      var(--color-bg);

    box-shadow:
      0 0 8px rgba(34, 211, 238, 0.35);
  }


  .line-main {
    width:
      80px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        var(--color-cyan),
        var(--color-border)
      );
  }


  .line-node {
    width:
      3px;

    height:
      3px;

    margin-left:
      0.25rem;

    border-radius:
      50%;

    background:
      var(--color-violet);

    box-shadow:
      0 0 8px rgba(139, 92, 246, 0.5);
  }


  .line-end {
    flex:
      1;

    height:
      1px;

    margin-left:
      0.25rem;

    background:
      linear-gradient(
        90deg,
        var(--color-border),
        transparent
      );
  }


  /* ========================================================
     CENTER ALIGNMENT
     ======================================================== */

  .section-header-center
    .section-meta {

    justify-content:
      center;

  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .section-highlight {

    background:
      linear-gradient(
        100deg,
        #0891b2,
        #2563eb 50%,
        #7c3aed
      );

    background-clip:
      text;

    -webkit-background-clip:
      text;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .section-header {
      margin-bottom:
        2.25rem;
    }


    .section-title {
      font-size:
        clamp(
          2rem,
          10vw,
          3rem
        );
    }


    .section-description {
      font-size:
        0.57rem;
    }


    .section-meta {
      align-items:
        flex-start;
    }


    .section-status {
      display:
        none;
    }

  }


  @media (max-width: 450px) {

    .section-title {
      font-size:
        2rem;
    }


    .section-description {
      line-height:
        1.7;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .status-node {
      animation:
        none;
    }

  }
</style>
