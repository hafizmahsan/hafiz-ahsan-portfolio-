---
/**
 * ============================================================
 * SECTION HEADER
 * ============================================================
 *
 * Shared heading treatment for major portfolio sections.
 *
 * ============================================================
 */

import Stack from "./Stack.astro";

interface Props {
  number?: string;

  eyebrow?: string;

  title: string;

  description?: string;

  align?:
    | "left"
    | "center";

  size?:
    | "md"
    | "lg"
    | "xl";

  class?: string;
}

const {
  number,
  eyebrow,
  title,
  description,
  align = "left",
  size = "lg",
  class: className = ""
} = Astro.props;
---

<header
  class:list={[
    "section-header",
    `section-header--${align}`,
    `section-header--${size}`,
    className
  ]}
>
  <Stack gap="sm">

    {
      (number || eyebrow) && (
        <div class="section-header__meta">

          {
            number && (
              <span class="section-header__number">
                {number}
              </span>
            )
          }

          {
            number && eyebrow && (
              <span
                class="section-header__separator"
                aria-hidden="true"
              >
                /
              </span>
            )
          }

          {
            eyebrow && (
              <span class="section-header__eyebrow">
                {eyebrow}
              </span>
            )
          }

        </div>
      )
    }


    <h2 class="section-header__title">
      {title}
    </h2>


    {
      description && (
        <p class="section-header__description">
          {description}
        </p>
      )
    }

  </Stack>
</header>


<style>
  .section-header {
    width: 100%;
  }


  .section-header--left {
    text-align: left;
  }


  .section-header--center {
    max-width: 48rem;

    margin-inline: auto;

    text-align: center;
  }


  /* ========================================================
     META
     ======================================================== */

  .section-header__meta {
    display: flex;
    align-items: center;

    justify-content: flex-start;

    gap: 0.55rem;

    color:
      rgba(103, 232, 249, 0.9);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.68rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    line-height: 1;

    text-transform: uppercase;
  }


  .section-header--center
  .section-header__meta {
    justify-content: center;
  }


  .section-header__number {
    color:
      rgba(103, 232, 249, 0.95);
  }


  .section-header__separator {
    color:
      rgba(148, 163, 184, 0.35);
  }


  .section-header__eyebrow {
    color:
      rgba(148, 163, 184, 0.8);
  }


  /* ========================================================
     TITLE
     ======================================================== */

  .section-header__title {
    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-weight: 700;

    letter-spacing: -0.045em;

    line-height: 0.95;
  }


  .section-header--md
  .section-header__title {
    font-size:
      clamp(2rem, 5vw, 3rem);
  }


  .section-header--lg
  .section-header__title {
    font-size:
      clamp(2.5rem, 6vw, 4.5rem);
  }


  .section-header--xl
  .section-header__title {
    font-size:
      clamp(3rem, 8vw, 6rem);
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .section-header__description {
    max-width: 42rem;

    margin: 0;

    color:
      rgba(148, 163, 184, 0.9);

    font-size:
      clamp(0.95rem, 1.5vw, 1.05rem);

    line-height: 1.75;
  }


  .section-header--center
  .section-header__description {
    margin-inline: auto;
  }


  @media (max-width: 640px) {
    .section-header__title {
      letter-spacing: -0.035em;
    }


    .section-header__meta {
      font-size: 0.62rem;
    }
  }
</style>
