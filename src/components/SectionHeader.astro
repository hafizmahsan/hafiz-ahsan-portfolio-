---
/**
 * ============================================================
 * SECTION HEADER
 * ============================================================
 *
 * Reusable heading for major portfolio sections.
 *
 * Keeps typography, numbering and visual treatment
 * consistent throughout the entire website.
 *
 * ============================================================
 */

interface Props {
  number: string;
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const {
  number,
  eyebrow,
  title,
  description,
  align = "left"
} = Astro.props;
---

<header
  class:list={[
    "section-header",
    `section-header-${align}`
  ]}
>

  <!-- ======================================================
       TOP SYSTEM LINE
       ====================================================== -->

  <div
    class="section-system-line"
    aria-hidden="true"
  >

    <span class="system-line-number">
      {number}
    </span>

    <span class="system-line-track"></span>

    <span class="system-line-node"></span>

  </div>


  <!-- ======================================================
       EYEBROW
       ====================================================== -->

  {
    eyebrow && (
      <div class="section-eyebrow">

        <span
          class="eyebrow-node"
          aria-hidden="true"
        ></span>

        <span>
          {eyebrow}
        </span>

      </div>
    )
  }


  <!-- ======================================================
       TITLE
       ====================================================== -->

  <h2 class="section-title">
    {title}
  </h2>


  <!-- ======================================================
       DESCRIPTION
       ====================================================== -->

  {
    description && (
      <p class="section-description">
        {description}
      </p>
    )
  }


  <!-- ======================================================
       DECORATIVE SIGNAL
       ====================================================== -->

  <div
    class="section-signal"
    aria-hidden="true"
  >

    <span class="signal-dot"></span>

    <span class="signal-line"></span>

    <span class="signal-dot signal-dot-last"></span>

  </div>

</header>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .section-header {
    position:
      relative;

    width:
      100%;

    margin-bottom:
      3rem;
  }


  .section-header-left {
    text-align:
      left;
  }


  .section-header-center {
    text-align:
      center;
  }


  /* ========================================================
     SYSTEM LINE
     ======================================================== */

  .section-system-line {
    display:
      flex;

    align-items:
      center;

    width:
      100%;

    margin-bottom:
      1.25rem;
  }


  .system-line-number {
    flex-shrink:
      0;

    margin-right:
      0.65rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.3rem;

    letter-spacing:
      0.04em;
  }


  .system-line-track {
    width:
      min(90px, 15vw);

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.5),
        transparent
      );
  }


  .system-line-node {
    width:
      4px;

    height:
      4px;

    margin-left:
      0.35rem;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    box-shadow:
      0 0 7px rgba(34, 211, 238, 0.35);

    animation:
      section-node-pulse 2.8s ease-in-out infinite;
  }


  @keyframes section-node-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.8);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1.15);
    }

  }


  /* ========================================================
     CENTER ALIGNMENT
     ======================================================== */

  .section-header-center
    .section-system-line {

    justify-content:
      center;
  }


  .section-header-center
    .system-line-number {

    margin-right:
      0.65rem;
  }


  /* ========================================================
     EYEBROW
     ======================================================== */

  .section-eyebrow {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.45rem;

    margin-bottom:
      0.7rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.29rem;

    letter-spacing:
      0.06em;

    text-transform:
      uppercase;
  }


  .eyebrow-node {
    width:
      5px;

    height:
      5px;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      rgba(34, 211, 238, 0.08);

    box-shadow:
      0 0 7px rgba(34, 211, 238, 0.35);
  }


  /* ========================================================
     TITLE
     ======================================================== */

  .section-title {
    max-width:
      900px;

    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(2rem, 5vw, 3.8rem);

    font-weight:
      600;

    letter-spacing:
      -0.055em;

    line-height:
      0.98;
  }


  .section-header-center
    .section-title {

    margin-inline:
      auto;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .section-description {
    max-width:
      680px;

    margin:
      1rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.82rem;

    line-height:
      1.8;
  }


  .section-header-center
    .section-description {

    margin-inline:
      auto;
  }


  /* ========================================================
     SIGNAL
     ======================================================== */

  .section-signal {
    display:
      flex;

    align-items:
      center;

    width:
      min(180px, 35vw);

    margin-top:
      1.35rem;
  }


  .section-header-center
    .section-signal {

    margin-inline:
      auto;
  }


  .signal-dot {
    width:
      4px;

    height:
      4px;

    flex-shrink:
      0;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      var(--color-bg);

    box-shadow:
      0 0 7px rgba(34, 211, 238, 0.4);
  }


  .signal-line {
    flex:
      1;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.4),
        var(--color-border)
      );
  }


  .signal-dot-last {
    border-color:
      var(--color-border);

    box-shadow:
      none;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .section-title {

    color:
      var(--color-text);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .section-header {
      margin-bottom:
        2rem;
    }


    .section-title {
      font-size:
        clamp(1.8rem, 9vw, 2.7rem);
    }


    .section-description {
      font-size:
        0.72rem;

      line-height:
        1.7;
    }

  }


  @media (max-width: 480px) {

    .section-system-line {
      margin-bottom:
        1rem;
    }


    .section-eyebrow {
      font-size:
        0.26rem;
    }


    .section-title {
      letter-spacing:
        -0.045em;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .system-line-node {
      animation:
        none;
    }

  }
</style>
