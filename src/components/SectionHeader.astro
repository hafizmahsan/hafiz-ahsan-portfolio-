---
/**
 * ============================================================
 * SECTION HEADER
 * ============================================================
 *
 * Reusable heading component for portfolio sections.
 *
 * ============================================================
 */

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  id?: string;
  number?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  id,
  number
} = Astro.props;
---

<header
  id={id}
  class:list={[
    "section-header",
    `section-header--${align}`
  ]}
>
  <div class="section-header__top">

    {
      number && (
        <span class="section-header__number">
          {number}
        </span>
      )
    }

    {
      eyebrow && (
        <span class="section-header__eyebrow">
          {eyebrow}
        </span>
      )
    }

  </div>


  <h2 class="section-header__title">
    {title}
  </h2>


  {
    description && (
      <p class="section-header__description">
        {description}
      </p>
    )
  }

</header>


<style>
  .section-header {
    position: relative;
    width: 100%;
    margin-bottom: 3rem;
  }


  .section-header--center {
    text-align: center;
  }


  .section-header__top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }


  .section-header--center
  .section-header__top {
    justify-content: center;
  }


  .section-header__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 2rem;
    height: 1.5rem;

    padding: 0 0.5rem;

    border: 1px solid
      rgba(34, 211, 238, 0.3);

    border-radius: 999px;

    color:
      rgba(103, 232, 249, 0.9);

    background:
      rgba(34, 211, 238, 0.05);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }


  .section-header__eyebrow {
    color:
      rgba(103, 232, 249, 0.85);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.72rem;
    font-weight: 600;

    letter-spacing: 0.16em;

    text-transform: uppercase;
  }


  .section-header__title {
    margin: 0;

    color:
      rgba(248, 250, 252, 0.96);

    font-size:
      clamp(2rem, 5vw, 3.5rem);

    font-weight: 700;

    line-height: 1.05;

    letter-spacing:
      -0.045em;
  }


  .section-header__description {
    max-width: 42rem;

    margin: 1rem 0 0;

    color:
      rgba(148, 163, 184, 0.9);

    font-size: 1rem;

    line-height: 1.75;
  }


  .section-header--center
  .section-header__description {
    margin-left: auto;
    margin-right: auto;
  }


  @media (max-width: 640px) {
    .section-header {
      margin-bottom: 2.25rem;
    }


    .section-header__title {
      font-size:
        clamp(1.8rem, 10vw, 2.6rem);
    }


    .section-header__description {
      font-size: 0.95rem;
    }
  }
</style>
