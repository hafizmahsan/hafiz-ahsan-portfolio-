---
/**
 * ============================================================
 * SECTION HEADER
 * ============================================================
 *
 * Reusable heading block for major page sections.
 *
 * ============================================================
 */

interface Props {
  number?: string;

  eyebrow?: string;

  title: string;

  description?: string;

  align?:
    | "left"
    | "center";

  size?:
    | "md"
    | "lg";

  class?: string;
}

const {
  number,
  eyebrow,
  title,
  description,
  align = "left",
  size = "lg",
  class: className = ""
} = Astro.props;
---

<header
  class:list={[
    "section-header",
    `section-header--${align}`,
    `section-header--${size}`,
    className
  ]}
>
  <div class="section-header__meta">

    {
      number && (
        <span class="section-header__number">
          {number}
        </span>
      )
    }

    {
      eyebrow && (
        <span class="section-header__eyebrow">
          {eyebrow}
        </span>
      )
    }

  </div>


  <h2 class="section-header__title">
    {title}
  </h2>


  {
    description && (
      <p class="section-header__description">
        {description}
      </p>
    )
  }
</header>


<style>
  .section-header {
    max-width: 52rem;
  }


  .section-header--left {
    text-align: left;
  }


  .section-header--center {
    margin-inline: auto;

    text-align: center;
  }


  /* ========================================================
     META
     ======================================================== */

  .section-header__meta {
    display: flex;

    align-items: center;

    gap: 0.65rem;

    margin-bottom: 0.8rem;

    color:
      #67e8f9;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.62rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    line-height: 1.2;

    text-transform: uppercase;
  }


  .section-header--center
  .section-header__meta {
    justify-content: center;
  }


  .section-header__number {
    color:
      rgba(103, 232, 249, 0.6);
  }


  .section-header__eyebrow {
    color:
      rgba(148, 163, 184, 0.7);
  }


  .section-header__number:not(:last-child)::after {
    content: "/";

    margin-left: 0.65rem;

    color:
      rgba(148, 163, 184, 0.25);
  }


  /* ========================================================
     TITLE
     ======================================================== */

  .section-header__title {
    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(2rem, 5vw, 4rem);

    font-weight: 800;

    letter-spacing: -0.06em;

    line-height: 0.98;
  }


  .section-header--md
  .section-header__title {
    font-size:
      clamp(1.75rem, 4vw, 3rem);
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .section-header__description {
    max-width: 42rem;

    margin:
      1.1rem 0 0;

    color:
      rgba(148, 163, 184, 0.86);

    font-size:
      clamp(0.88rem, 1.5vw, 1rem);

    line-height: 1.75;
  }


  .section-header--center
  .section-header__description {
    margin-inline: auto;
  }
</style>
