---
/**
 * ============================================================
 * BUTTON
 * ============================================================
 *
 * Reusable action component.
 *
 * Supports both normal links and button-like visual styles.
 *
 * ============================================================
 */

interface Props {
  href?: string;

  label?: string;

  variant?:
    | "primary"
    | "secondary"
    | "ghost"
    | "danger";

  size?:
    | "sm"
    | "md"
    | "lg";

  external?: boolean;

  download?: boolean;

  disabled?: boolean;

  type?:
    | "button"
    | "submit"
    | "reset";

  class?: string;

  ariaLabel?: string;
}

const {
  href,
  label,
  variant = "primary",
  size = "md",
  external = false,
  download = false,
  disabled = false,
  type = "button",
  class: className = "",
  ariaLabel
} = Astro.props;

const isLink =
  Boolean(href) && !disabled;
---

{
  isLink ? (
    <a
      href={href}
      class:list={[
        "button",
        `button--${variant}`,
        `button--${size}`,
        className
      ]}
      target={
        external
          ? "_blank"
          : undefined
      }
      rel={
        external
          ? "noopener noreferrer"
          : undefined
      }
      download={
        download
          ? true
          : undefined
      }
      aria-label={
        ariaLabel ?? label
      }
    >
      <span class="button__label">
        {label}
      </span>

      <span
        class="button__arrow"
        aria-hidden="true"
      >
        →
      </span>
    </a>
  ) : (
    <button
      type={type}
      class:list={[
        "button",
        `button--${variant}`,
        `button--${size}`,
        className
      ]}
      disabled={disabled}
      aria-label={
        ariaLabel ?? label
      }
    >
      <span class="button__label">
        {label}
      </span>

      <span
        class="button__arrow"
        aria-hidden="true"
      >
        →
      </span>
    </button>
  )
}


<style>
  .button {
    position: relative;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 0.8rem;

    border: 1px solid transparent;
    border-radius: 0.35rem;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.72rem;
    font-weight: 700;

    letter-spacing: 0.1em;

    line-height: 1;

    text-decoration: none;
    text-transform: uppercase;

    cursor: pointer;

    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      box-shadow 180ms ease;
  }


  .button:hover {
    transform:
      translateY(-1px);
  }


  .button:focus-visible {
    outline: 2px solid
      rgba(103, 232, 249, 0.9);

    outline-offset: 3px;
  }


  .button:disabled {
    opacity: 0.45;

    cursor: not-allowed;

    transform: none;
  }


  /* ========================================================
     SIZES
     ======================================================== */

  .button--sm {
    min-height: 2.25rem;

    padding:
      0.65rem 0.85rem;

    font-size: 0.65rem;
  }


  .button--md {
    min-height: 2.75rem;

    padding:
      0.8rem 1rem;
  }


  .button--lg {
    min-height: 3.25rem;

    padding:
      0.95rem 1.25rem;

    font-size: 0.75rem;
  }


  /* ========================================================
     PRIMARY
     ======================================================== */

  .button--primary {
    color:
      #020617;

    background:
      #67e8f9;

    border-color:
      #67e8f9;

    box-shadow:
      0 0 0
        rgba(103, 232, 249, 0);
  }


  .button--primary:hover {
    background:
      #a5f3fc;

    border-color:
      #a5f3fc;

    box-shadow:
      0 0 28px
        rgba(34, 211, 238, 0.22);
  }


  /* ========================================================
     SECONDARY
     ======================================================== */

  .button--secondary {
    color:
      rgba(226, 232, 240, 0.95);

    background:
      rgba(15, 23, 42, 0.7);

    border-color:
      rgba(148, 163, 184, 0.25);
  }


  .button--secondary:hover {
    color:
      #67e8f9;

    border-color:
      rgba(103, 232, 249, 0.55);

    background:
      rgba(34, 211, 238, 0.06);
  }


  /* ========================================================
     GHOST
     ======================================================== */

  .button--ghost {
    color:
      rgba(148, 163, 184, 0.95);

    background:
      transparent;

    border-color:
      transparent;
  }


  .button--ghost:hover {
    color:
      #67e8f9;

    background:
      rgba(34, 211, 238, 0.05);
  }


  /* ========================================================
     DANGER
     ======================================================== */

  .button--danger {
    color:
      #fecaca;

    background:
      rgba(127, 29, 29, 0.15);

    border-color:
      rgba(248, 113, 113, 0.3);
  }


  .button--danger:hover {
    color:
      #fee2e2;

    background:
      rgba(127, 29, 29, 0.3);

    border-color:
      rgba(248, 113, 113, 0.55);
  }


  /* ========================================================
     ARROW
     ======================================================== */

  .button__arrow {
    display: inline-block;

    transition:
      transform 180ms ease;
  }


  .button:hover
  .button__arrow {
    transform:
      translateX(3px);
  }


  @media (prefers-reduced-motion: reduce) {
    .button,
    .button__arrow {
      transition: none;
    }


    .button:hover {
      transform: none;
    }
  }
</style>
