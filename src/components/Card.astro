---
/**
 * ============================================================
 * CARD
 * ============================================================
 *
 * Reusable content surface for the portfolio.
 *
 * ============================================================
 */

interface Props {
  as?:
    | "div"
    | "article"
    | "section"
    | "aside";

  variant?:
    | "default"
    | "featured"
    | "interactive"
    | "muted";

  padding?:
    | "none"
    | "sm"
    | "md"
    | "lg";

  glow?:
    | "none"
    | "cyan"
    | "violet"
    | "blue"
    | "green";

  class?: string;
}

const {
  as = "article",
  variant = "default",
  padding = "md",
  glow = "none",
  class: className = ""
} = Astro.props;

const Tag = as;
---

<Tag
  class:list={[
    "card",
    `card--${variant}`,
    `card--padding-${padding}`,
    `card--glow-${glow}`,
    className
  ]}
>
  <div class="card__grid" aria-hidden="true" />
  <div class="card__glow" aria-hidden="true" />

  <div class="card__content">
    <slot />
  </div>
</Tag>


<style>
  .card {
    position: relative;

    width: 100%;

    overflow: hidden;

    border: 1px solid
      rgba(148, 163, 184, 0.14);

    border-radius: 0.75rem;

    background:
      linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.78),
        rgba(2, 6, 23, 0.82)
      );

    box-shadow:
      0 20px 50px
      rgba(0, 0, 0, 0.16);
  }


  .card__content {
    position: relative;
    z-index: 2;
  }


  /* ========================================================
     GRID DETAIL
     ======================================================== */

  .card__grid {
    position: absolute;
    inset: 0;

    z-index: 0;

    opacity: 0.22;

    pointer-events: none;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.035) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.035) 1px,
        transparent 1px
      );

    background-size:
      28px 28px;

    mask-image:
      linear-gradient(
        to bottom,
        black,
        transparent 85%
      );
  }


  /* ========================================================
     GLOW
     ======================================================== */

  .card__glow {
    position: absolute;

    width: 12rem;
    height: 12rem;

    top: -7rem;
    right: -5rem;

    z-index: 0;

    border-radius: 999px;

    opacity: 0.14;

    filter: blur(45px);

    pointer-events: none;

    background:
      rgba(34, 211, 238, 0.55);
  }


  .card--glow-violet
  .card__glow {
    background:
      rgba(139, 92, 246, 0.55);
  }


  .card--glow-blue
  .card__glow {
    background:
      rgba(59, 130, 246, 0.55);
  }


  .card--glow-green
  .card__glow {
    background:
      rgba(34, 197, 94, 0.5);
  }


  .card--glow-none
  .card__glow {
    display: none;
  }


  /* ========================================================
     PADDING
     ======================================================== */

  .card--padding-none {
    padding: 0;
  }


  .card--padding-sm {
    padding: 1rem;
  }


  .card--padding-md {
    padding: 1.5rem;
  }


  .card--padding-lg {
    padding: 2rem;
  }


  /* ========================================================
     DEFAULT
     ======================================================== */

  .card--default {
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .card--featured {
    border-color:
      rgba(34, 211, 238, 0.28);

    background:
      linear-gradient(
        145deg,
        rgba(8, 47, 73, 0.3),
        rgba(2, 6, 23, 0.88)
      );

    box-shadow:
      0 24px 70px
      rgba(34, 211, 238, 0.06);
  }


  /* ========================================================
     INTERACTIVE
     ======================================================== */

  .card--interactive {
    cursor: default;

    transition:
      transform 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease,
      box-shadow 200ms ease;
  }


  .card--interactive:hover {
    transform:
      translateY(-3px);

    border-color:
      rgba(103, 232, 249, 0.34);

    background:
      linear-gradient(
        145deg,
        rgba(15, 23, 42, 0.9),
        rgba(2, 6, 23, 0.92)
      );

    box-shadow:
      0 28px 80px
      rgba(0, 0, 0, 0.28),
      0 0 32px
      rgba(34, 211, 238, 0.05);
  }


  /* ========================================================
     MUTED
     ======================================================== */

  .card--muted {
    background:
      rgba(15, 23, 42, 0.4);

    border-color:
      rgba(148, 163, 184, 0.1);

    box-shadow: none;
  }


  @media (max-width: 640px) {
    .card--padding-md {
      padding: 1.15rem;
    }


    .card--padding-lg {
      padding: 1.4rem;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .card--default,
    .card--interactive {
      transition: none;
    }


    .card--interactive:hover {
      transform: none;
    }
  }
</style>
