---
/**
 * ============================================================
 * GLOW BUTTON
 * ============================================================
 *
 * Reusable premium CTA component.
 *
 * Supports:
 * - Internal links
 * - External links
 * - Download links
 * - Primary / secondary / ghost styles
 * - Cyan / violet / blue accents
 * - Animated hover effects
 *
 * ============================================================
 */

interface Props {
  href: string;
  label: string;
  icon?: string;
  variant?: "primary" | "secondary" | "ghost";
  accent?: "cyan" | "violet" | "blue";
  external?: boolean;
  download?: boolean;
  target?: string;
  rel?: string;
}

const {
  href,
  label,
  icon = "→",
  variant = "primary",
  accent = "cyan",
  external = false,
  download = false,
  target,
  rel
} = Astro.props;

const resolvedTarget =
  target ?? (external ? "_blank" : undefined);

const resolvedRel =
  rel ?? (external ? "noopener noreferrer" : undefined);
---

<a
  href={href}
  class:list={[
    "glow-button",
    `glow-button-${variant}`,
    `glow-button-${accent}`
  ]}
  target={resolvedTarget}
  rel={resolvedRel}
  download={download || undefined}
  aria-label={label}
>

  <span class="button-border" aria-hidden="true"></span>

  <span class="button-content">

    <span class="button-label">
      {label}
    </span>

    <span
      class="button-icon"
      aria-hidden="true"
    >
      {icon}
    </span>

  </span>

  <span
    class="button-scan"
    aria-hidden="true"
  ></span>

</a>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .glow-button {
    --button-accent:
      #22d3ee;

    --button-accent-soft:
      rgba(34, 211, 238, 0.12);

    --button-accent-glow:
      rgba(34, 211, 238, 0.18);

    position:
      relative;

    display:
      inline-flex;

    min-height:
      42px;

    align-items:
      center;

    justify-content:
      center;

    padding:
      0 1rem;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--button-accent) 28%,
        transparent
      );

    border-radius:
      0.3rem;

    overflow:
      hidden;

    color:
      var(--color-text);

    background:
      rgba(3, 7, 18, 0.6);

    text-decoration:
      none;

    cursor:
      pointer;

    isolation:
      isolate;

    transition:
      transform var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .glow-button:hover {
    transform:
      translateY(-2px);

    border-color:
      color-mix(
        in srgb,
        var(--button-accent) 65%,
        transparent
      );

    background:
      color-mix(
        in srgb,
        var(--button-accent) 5%,
        rgba(3, 7, 18, 0.8)
      );

    box-shadow:
      0 10px 35px var(--button-accent-glow);
  }


  .glow-button:active {
    transform:
      translateY(0);
  }


  .glow-button:focus-visible {
    outline:
      2px solid var(--button-accent);

    outline-offset:
      4px;
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .button-content {
    position:
      relative;

    z-index:
      3;

    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    gap:
      0.75rem;
  }


  .button-label {
    font-family:
      var(--font-mono);

    font-size:
      0.32rem;

    font-weight:
      500;

    letter-spacing:
      0.035em;

    text-transform:
      uppercase;

    white-space:
      nowrap;
  }


  .button-icon {
    display:
      inline-flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      20px;

    height:
      20px;

    color:
      var(--button-accent);

    font-family:
      var(--font-mono);

    font-size:
      0.75rem;

    line-height:
      1;

    transition:
      transform var(--duration-fast) var(--ease-standard);
  }


  .glow-button:hover
    .button-icon {

    transform:
      translateX(3px);
  }


  /* ========================================================
     BORDER
     ======================================================== */

  .button-border {
    position:
      absolute;

    inset:
      2px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--button-accent) 7%,
        transparent
      );

    border-radius:
      0.2rem;

    pointer-events:
      none;

    z-index:
      1;
  }


  /* ========================================================
     SCAN
     ======================================================== */

  .button-scan {
    position:
      absolute;

    top:
      0;

    left:
      -100%;

    width:
      70%;

    height:
      100%;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--button-accent-soft),
        transparent
      );

    transform:
      skewX(-20deg);

    pointer-events:
      none;

    z-index:
      2;

    transition:
      left 0.7s var(--ease-standard);
  }


  .glow-button:hover
    .button-scan {

    left:
      130%;
  }


  /* ========================================================
     PRIMARY
     ======================================================== */

  .glow-button-primary {
    background:
      color-mix(
        in srgb,
        var(--button-accent) 7%,
        rgba(3, 7, 18, 0.85)
      );

    box-shadow:
      inset 0 0 20px
      color-mix(
        in srgb,
        var(--button-accent) 3%,
        transparent
      );
  }


  .glow-button-primary
    .button-label {

    color:
      var(--color-text);
  }


  /* ========================================================
     SECONDARY
     ======================================================== */

  .glow-button-secondary {
    border-color:
      var(--color-border);

    background:
      rgba(148, 163, 184, 0.015);
  }


  .glow-button-secondary
    .button-label {

    color:
      var(--color-text-muted);
  }


  .glow-button-secondary:hover {
    border-color:
      color-mix(
        in srgb,
        var(--button-accent) 35%,
        var(--color-border)
      );
  }


  /* ========================================================
     GHOST
     ======================================================== */

  .glow-button-ghost {
    min-height:
      32px;

    padding:
      0 0.45rem;

    border-color:
      transparent;

    background:
      transparent;

    box-shadow:
      none;
  }


  .glow-button-ghost
    .button-border {

    display:
      none;
  }


  .glow-button-ghost
    .button-label {

    color:
      var(--color-text-muted);
  }


  .glow-button-ghost:hover {
    border-color:
      transparent;

    background:
      transparent;

    box-shadow:
      none;
  }


  /* ========================================================
     CYAN
     ======================================================== */

  .glow-button-cyan {
    --button-accent:
      #22d3ee;

    --button-accent-soft:
      rgba(34, 211, 238, 0.12);

    --button-accent-glow:
      rgba(34, 211, 238, 0.18);
  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .glow-button-violet {
    --button-accent:
      #8b5cf6;

    --button-accent-soft:
      rgba(139, 92, 246, 0.12);

    --button-accent-glow:
      rgba(139, 92, 246, 0.18);
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .glow-button-blue {
    --button-accent:
      #3b82f6;

    --button-accent-soft:
      rgba(59, 130, 246, 0.12);

    --button-accent-glow:
      rgba(59, 130, 246, 0.18);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .glow-button {

    background:
      rgba(248, 250, 252, 0.8);
  }


  :global([data-theme="light"])
    .glow-button-primary {

    background:
      color-mix(
        in srgb,
        var(--button-accent) 6%,
        rgba(248, 250, 252, 0.9)
      );
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 600px) {

    .glow-button {
      min-height:
        40px;

      padding:
        0 0.8rem;
    }


    .button-label {
      font-size:
        0.29rem;
    }


    .button-content {
      gap:
        0.55rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .glow-button,
    .button-icon,
    .button-scan {
      transition:
        none;
    }

  }
</style>
