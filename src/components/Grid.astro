---
/**
 * ============================================================
 * GRID
 * ============================================================
 *
 * Reusable responsive grid layout primitive.
 *
 * ============================================================
 */

interface Props {
  columns?:
    | 1
    | 2
    | 3
    | 4;

  gap?:
    | "sm"
    | "md"
    | "lg";

  minColumnWidth?:
    | "220px"
    | "260px"
    | "300px"
    | "340px";

  align?:
    | "start"
    | "stretch"
    | "center";

  class?: string;
}

const {
  columns = 3,
  gap = "md",
  minColumnWidth,
  align = "stretch",
  class: className = ""
} = Astro.props;

const gridStyle = minColumnWidth
  ? `--grid-min-column: ${minColumnWidth};`
  : undefined;
---

<div
  class:list={[
    "grid",
    `grid--columns-${columns}`,
    `grid--gap-${gap}`,
    `grid--align-${align}`,
    {
      "grid--auto": Boolean(
        minColumnWidth
      )
    },
    className
  ]}
  style={gridStyle}
>
  <slot />
</div>


<style>
  .grid {
    display: grid;

    width: 100%;
  }


  /* ========================================================
     COLUMNS
     ======================================================== */

  .grid--columns-1 {
    grid-template-columns:
      minmax(0, 1fr);
  }


  .grid--columns-2 {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .grid--columns-3 {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }


  .grid--columns-4 {
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }


  .grid--auto {
    grid-template-columns:
      repeat(
        auto-fit,
        minmax(
          var(--grid-min-column),
          1fr
        )
      );
  }


  /* ========================================================
     GAPS
     ======================================================== */

  .grid--gap-sm {
    gap: 0.75rem;
  }


  .grid--gap-md {
    gap: 1.25rem;
  }


  .grid--gap-lg {
    gap: 2rem;
  }


  /* ========================================================
     ALIGNMENT
     ======================================================== */

  .grid--align-start {
    align-items: start;
  }


  .grid--align-stretch {
    align-items: stretch;
  }


  .grid--align-center {
    align-items: center;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 900px) {
    .grid--columns-4 {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }


    .grid--columns-3 {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }


  @media (max-width: 640px) {
    .grid--columns-4,
    .grid--columns-3,
    .grid--columns-2 {
      grid-template-columns:
        minmax(0, 1fr);
    }
  }
</style>
