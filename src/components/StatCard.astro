---
/**
 * ============================================================
 * STAT CARD
 * ============================================================
 *
 * Reusable metric / profile statistic component.
 *
 * Designed for:
 * - Years of experience
 * - Specializations
 * - Technologies
 * - Certifications
 * - Project counts
 * - Career highlights
 *
 * ============================================================
 */

interface Props {
  value: string;
  label: string;
  description?: string;
  accent?: "cyan" | "violet" | "blue" | "green";
  index?: string;
  featured?: boolean;
}

const {
  value,
  label,
  description,
  accent = "cyan",
  index,
  featured = false
} = Astro.props;
---

<div
  class:list={[
    "stat-card",
    `stat-card-${accent}`,
    {
      "stat-card-featured": featured
    }
  ]}
>

  <!-- ======================================================
       TOP SYSTEM BAR
       ====================================================== -->

  <div
    class="stat-top"
    aria-hidden="true"
  >

    {
      index && (
        <span class="stat-index">
          {index}
        </span>
      )
    }

    <span class="stat-top-line"></span>

    <span class="stat-top-node"></span>

  </div>


  <!-- ======================================================
       VALUE
       ====================================================== -->

  <div class="stat-value">
    {value}
  </div>


  <!-- ======================================================
       LABEL
       ====================================================== -->

  <div class="stat-label">
    {label}
  </div>


  <!-- ======================================================
       DESCRIPTION
       ====================================================== -->

  {
    description && (
      <p class="stat-description">
        {description}
      </p>
    )
  }


  <!-- ======================================================
       BOTTOM SIGNAL
       ====================================================== -->

  <div
    class="stat-bottom"
    aria-hidden="true"
  >

    <span class="stat-bottom-node"></span>

    <span class="stat-bottom-line"></span>

    <span class="stat-bottom-node"></span>

  </div>

</div>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .stat-card {
    position:
      relative;

    min-width:
      0;

    padding:
      0.9rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.45rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .stat-card:hover {
    transform:
      translateY(-3px);

    border-color:
      rgba(34, 211, 238, 0.18);

    background:
      rgba(34, 211, 238, 0.012);

    box-shadow:
      0 15px 45px rgba(0, 0, 0, 0.08);
  }


  .stat-card::after {
    content:
      "";

    position:
      absolute;

    right:
      -35px;

    bottom:
      -35px;

    width:
      80px;

    height:
      80px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        rgba(34, 211, 238, 0.05),
        transparent 68%
      );

    pointer-events:
      none;
  }


  /* ========================================================
     TOP
     ======================================================== */

  .stat-top {
    display:
      flex;

    align-items:
      center;

    gap:
      0.4rem;

    margin-bottom:
      0.9rem;
  }


  .stat-index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.25rem;

    letter-spacing:
      0.03em;
  }


  .stat-top-line {
    flex:
      1;

    max-width:
      50px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        var(--color-border),
        transparent
      );
  }


  .stat-top-node {
    width:
      4px;

    height:
      4px;

    flex-shrink:
      0;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    box-shadow:
      0 0 6px rgba(34, 211, 238, 0.35);

    animation:
      stat-node-pulse 2.5s ease-in-out infinite;
  }


  @keyframes stat-node-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     VALUE
     ======================================================== */

  .stat-value {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1.55rem, 4vw, 2.4rem);

    font-weight:
      600;

    letter-spacing:
      -0.06em;

    line-height:
      1;
  }


  /* ========================================================
     LABEL
     ======================================================== */

  .stat-label {
    margin-top:
      0.45rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.31rem;

    font-weight:
      500;

    letter-spacing:
      0.045em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .stat-description {
    margin:
      0.55rem 0 0;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-body);

    font-size:
      0.62rem;

    line-height:
      1.55;
  }


  /* ========================================================
     BOTTOM
     ======================================================== */

  .stat-bottom {
    display:
      flex;

    align-items:
      center;

    gap:
      0.3rem;

    margin-top:
      0.8rem;
  }


  .stat-bottom-node {
    width:
      3px;

    height:
      3px;

    flex-shrink:
      0;

    border:
      1px solid var(--color-border);

    border-radius:
      50%;
  }


  .stat-bottom-line {
    flex:
      1;

    height:
      1px;

    background:
      var(--color-border);
  }


  /* ========================================================
     CYAN
     ======================================================== */

  .stat-card-cyan
    .stat-label {

    color:
      var(--color-cyan);
  }


  .stat-card-cyan
    .stat-top-node {

    border-color:
      var(--color-cyan);
  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .stat-card-violet
    .stat-label {

    color:
      var(--color-violet);
  }


  .stat-card-violet
    .stat-top-node {

    border-color:
      var(--color-violet);

    box-shadow:
      0 0 6px rgba(139, 92, 246, 0.35);
  }


  .stat-card-violet::after {

    background:
      radial-gradient(
        circle,
        rgba(139, 92, 246, 0.05),
        transparent 68%
      );
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .stat-card-blue
    .stat-label {

    color:
      var(--color-blue);
  }


  .stat-card-blue
    .stat-top-node {

    border-color:
      var(--color-blue);

    box-shadow:
      0 0 6px rgba(59, 130, 246, 0.35);
  }


  .stat-card-blue::after {

    background:
      radial-gradient(
        circle,
        rgba(59, 130, 246, 0.05),
        transparent 68%
      );
  }


  /* ========================================================
     GREEN
     ======================================================== */

  .stat-card-green
    .stat-label {

    color:
      #4ade80;
  }


  .stat-card-green
    .stat-top-node {

    border-color:
      #4ade80;

    box-shadow:
      0 0 6px rgba(74, 222, 128, 0.35);
  }


  .stat-card-green::after {

    background:
      radial-gradient(
        circle,
        rgba(74, 222, 128, 0.05),
        transparent 68%
      );
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .stat-card-featured {
    border-color:
      rgba(34, 211, 238, 0.14);

    box-shadow:
      inset 0 0 25px rgba(34, 211, 238, 0.012);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .stat-card {

    background:
      rgba(15, 23, 42, 0.012);
  }


  :global([data-theme="light"])
    .stat-card:hover {

    background:
      rgba(14, 116, 144, 0.015);

    box-shadow:
      0 15px 45px rgba(15, 23, 42, 0.06);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 600px) {

    .stat-card {
      padding:
        0.75rem;
    }


    .stat-value {
      font-size:
        1.6rem;
    }


    .stat-label {
      font-size:
        0.28rem;
    }


    .stat-description {
      font-size:
        0.58rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .stat-card,
    .stat-top-node {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
