---
/**
 * ============================================================
 * STAT CARD
 * ============================================================
 *
 * Reusable portfolio metric / statistic card.
 *
 * Intended for:
 * - Experience
 * - Projects
 * - Technologies
 * - Enterprise domains
 * - Certifications
 * - Current learning
 *
 * ============================================================
 */

interface Props {
  value: string;
  label: string;
  description?: string;
  icon?: string;
  accent?: "cyan" | "violet" | "blue" | "green";
  index?: string;
  compact?: boolean;
}

const {
  value,
  label,
  description,
  icon = "◇",
  accent = "cyan",
  index = "01",
  compact = false
} = Astro.props;
---

<article
  class:list={[
    "stat-card",
    `stat-card-${accent}`,
    {
      "stat-card-compact": compact
    }
  ]}
>

  <!-- ======================================================
       TOP BAR
       ====================================================== -->

  <div class="stat-top">

    <span class="stat-index">
      {index}
    </span>

    <span class="stat-system">
      METRIC
    </span>

    <span
      class="stat-status"
      aria-hidden="true"
    >
      <span></span>
    </span>

  </div>


  <!-- ======================================================
       ICON
       ====================================================== -->

  <div class="stat-icon-wrap">

    <span
      class="stat-icon"
      aria-hidden="true"
    >
      {icon}
    </span>

  </div>


  <!-- ======================================================
       VALUE
       ====================================================== -->

  <div class="stat-value">
    {value}
  </div>


  <!-- ======================================================
       LABEL
       ====================================================== -->

  <div class="stat-label">
    {label}
  </div>


  <!-- ======================================================
       DESCRIPTION
       ====================================================== -->

  {
    description && (
      <p class="stat-description">
        {description}
      </p>
    )
  }


  <!-- ======================================================
       NETWORK LINE
       ====================================================== -->

  <div
    class="stat-network"
    aria-hidden="true"
  >

    <span class="stat-network-line"></span>

    <span class="stat-network-node"></span>

  </div>

</article>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .stat-card {
    position:
      relative;

    min-width:
      0;

    min-height:
      190px;

    padding:
      1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.55rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .stat-card:hover {
    transform:
      translateY(-4px);

    border-color:
      rgba(34, 211, 238, 0.2);

    background:
      rgba(34, 211, 238, 0.018);

    box-shadow:
      0 18px 55px rgba(0, 0, 0, 0.12);
  }


  /* ========================================================
     TOP BAR
     ======================================================== */

  .stat-top {
    display:
      grid;

    grid-template-columns:
      auto 1fr auto;

    align-items:
      center;

    gap:
      0.5rem;

    margin-bottom:
      1.1rem;
  }


  .stat-index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.3rem;

    opacity:
      0.7;
  }


  .stat-system {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.27rem;

    letter-spacing:
      0.05em;

    text-transform:
      uppercase;
  }


  .stat-status {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      11px;

    height:
      11px;

    border:
      1px solid rgba(34, 211, 238, 0.16);

    border-radius:
      50%;
  }


  .stat-status span {
    width:
      3px;

    height:
      3px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 7px rgba(34, 211, 238, 0.7);

    animation:
      stat-status-pulse 2.4s ease-in-out infinite;
  }


  @keyframes stat-status-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     ICON
     ======================================================== */

  .stat-icon-wrap {
    display:
      flex;

    align-items:
      center;

    justify-content:
      flex-start;

    margin-bottom:
      0.75rem;
  }


  .stat-icon {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      30px;

    height:
      30px;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      0.3rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.025);

    font-family:
      var(--font-mono);

    font-size:
      0.7rem;

    box-shadow:
      inset 0 0 20px rgba(34, 211, 238, 0.015);

    transition:
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }


  .stat-card:hover
    .stat-icon {

    transform:
      rotate(6deg);

    box-shadow:
      0 0 18px rgba(34, 211, 238, 0.08);
  }


  /* ========================================================
     VALUE
     ======================================================== */

  .stat-value {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1.55rem, 4vw, 2.35rem);

    font-weight:
      650;

    letter-spacing:
      -0.04em;

    line-height:
      0.95;
  }


  /* ========================================================
     LABEL
     ======================================================== */

  .stat-label {
    margin-top:
      0.4rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.37rem;

    font-weight:
      500;

    letter-spacing:
      0.035em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .stat-description {
    max-width:
      250px;

    margin:
      0.6rem 0 0;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-body);

    font-size:
      0.72rem;

    line-height:
      1.6;
  }


  /* ========================================================
     NETWORK
     ======================================================== */

  .stat-network {
    position:
      absolute;

    right:
      0.9rem;

    bottom:
      0.8rem;

    width:
      60px;

    height:
      22px;

    opacity:
      0.7;
  }


  .stat-network-line {
    position:
      absolute;

    top:
      50%;

    left:
      0;

    width:
      100%;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--color-border),
        transparent
      );
  }


  .stat-network-node {
    position:
      absolute;

    top:
      50%;

    right:
      0;

    width:
      5px;

    height:
      5px;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      var(--color-bg);

    transform:
      translateY(-50%);

    box-shadow:
      0 0 8px rgba(34, 211, 238, 0.35);
  }


  /* ========================================================
     CYAN
     ======================================================== */

  .stat-card-cyan
    .stat-icon {

    color:
      var(--color-cyan);

    border-color:
      rgba(34, 211, 238, 0.18);

  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .stat-card-violet
    .stat-icon {

    color:
      var(--color-violet);

    border-color:
      rgba(139, 92, 246, 0.18);

    background:
      rgba(139, 92, 246, 0.025);

  }


  .stat-card-violet
    .stat-status {

    border-color:
      rgba(139, 92, 246, 0.16);

  }


  .stat-card-violet
    .stat-status span {

    background:
      var(--color-violet);

    box-shadow:
      0 0 7px rgba(139, 92, 246, 0.7);

  }


  .stat-card-violet
    .stat-network-node {

    border-color:
      var(--color-violet);

    box-shadow:
      0 0 8px rgba(139, 92, 246, 0.35);

  }


  .stat-card-violet:hover {
    border-color:
      rgba(139, 92, 246, 0.2);

    background:
      rgba(139, 92, 246, 0.018);

  }


  /* ========================================================
     BLUE
     ======================================================== */

  .stat-card-blue
    .stat-icon {

    color:
      var(--color-blue);

    border-color:
      rgba(59, 130, 246, 0.18);

    background:
      rgba(59, 130, 246, 0.025);

  }


  .stat-card-blue
    .stat-status {

    border-color:
      rgba(59, 130, 246, 0.16);

  }


  .stat-card-blue
    .stat-status span {

    background:
      var(--color-blue);

    box-shadow:
      0 0 7px rgba(59, 130, 246, 0.7);

  }


  .stat-card-blue
    .stat-network-node {

    border-color:
      var(--color-blue);

    box-shadow:
      0 0 8px rgba(59, 130, 246, 0.35);

  }


  .stat-card-blue:hover {
    border-color:
      rgba(59, 130, 246, 0.2);

    background:
      rgba(59, 130, 246, 0.018);

  }


  /* ========================================================
     GREEN
     ======================================================== */

  .stat-card-green
    .stat-icon {

    color:
      #4ade80;

    border-color:
      rgba(74, 222, 128, 0.18);

    background:
      rgba(74, 222, 128, 0.025);

  }


  .stat-card-green
    .stat-status {

    border-color:
      rgba(74, 222, 128, 0.16);

  }


  .stat-card-green
    .stat-status span {

    background:
      #4ade80;

    box-shadow:
      0 0 7px rgba(74, 222, 128, 0.7);

  }


  .stat-card-green
    .stat-network-node {

    border-color:
      #4ade80;

    box-shadow:
      0 0 8px rgba(74, 222, 128, 0.35);

  }


  .stat-card-green:hover {
    border-color:
      rgba(74, 222, 128, 0.2);

    background:
      rgba(74, 222, 128, 0.018);

  }


  /* ========================================================
     COMPACT
     ======================================================== */

  .stat-card-compact {
    min-height:
      150px;

    padding:
      0.8rem;
  }


  .stat-card-compact
    .stat-top {

    margin-bottom:
      0.7rem;
  }


  .stat-card-compact
    .stat-icon-wrap {

    margin-bottom:
      0.5rem;
  }


  .stat-card-compact
    .stat-icon {

    width:
      25px;

    height:
      25px;

    font-size:
      0.58rem;
  }


  .stat-card-compact
    .stat-value {

    font-size:
      1.5rem;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .stat-card {

    background:
      rgba(15, 23, 42, 0.012);

  }


  :global([data-theme="light"])
    .stat-card:hover {

    background:
      rgba(14, 116, 144, 0.018);

    box-shadow:
      0 18px 55px rgba(15, 23, 42, 0.07);

  }


  :global([data-theme="light"])
    .stat-icon {

    background:
      rgba(14, 116, 144, 0.025);

  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 600px) {

    .stat-card {
      min-height:
        170px;

      padding:
        0.85rem;
    }


    .stat-value {
      font-size:
        1.75rem;
    }


    .stat-description {
      font-size:
        0.67rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .stat-card,
    .stat-icon,
    .stat-status span {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
