---
/**
 * ============================================================
 * FOOTER
 * ============================================================
 *
 * Reusable site footer.
 *
 * ============================================================
 */

import Link from "./Link.astro";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";

interface FooterLink {
  label: string;
  href: string;
}

interface SocialLink {
  label: string;

  href: string;

  icon:
    | "github"
    | "linkedin"
    | "mail"
    | "external";
}

interface Props {
  description?: string;

  links?: FooterLink[];

  socialLinks?: SocialLink[];

  copyrightName?: string;

  class?: string;
}

const {
  description =
    "Software engineering, automation, and intelligent systems.",

  links = [
    {
      label: "ABOUT",
      href: "#about"
    },
    {
      label: "PROJECTS",
      href: "#projects"
    },
    {
      label: "EXPERIENCE",
      href: "#experience"
    },
    {
      label: "CONTACT",
      href: "#contact"
    }
  ],

  socialLinks = [],

  copyrightName = "YOUR NAME",

  class: className = ""
} = Astro.props;

const year =
  new Date().getFullYear();
---

<footer
  class:list={[
    "footer",
    className
  ]}
>
  <div class="footer__inner">

    <div class="footer__main">

      <div class="footer__identity">

        <Logo />

        <p class="footer__description">
          {description}
        </p>

      </div>


      <nav
        class="footer__nav"
        aria-label="Footer navigation"
      >
        <span class="footer__heading">
          NAVIGATION
        </span>

        <ul>
          {
            links.map((link) => (
              <li>
                <Link
                  href={link.href}
                  label={link.label}
                  icon="none"
                  variant="muted"
                />
              </li>
            ))
          }
        </ul>
      </nav>


      {
        socialLinks.length > 0 && (
          <div class="footer__social">
            <span class="footer__heading">
              CONNECT
            </span>

            <SocialLinks
              links={socialLinks}
              variant="muted"
              size="sm"
              showLabels={false}
            />
          </div>
        )
      }

    </div>


    <div class="footer__bottom">

      <span class="footer__copyright">
        © {year} {copyrightName}
      </span>


      <span class="footer__built">
        BUILT WITH ASTRO
      </span>


      <a
        href="#top"
        class="footer__top"
        aria-label="Back to top"
      >
        TOP ↑
      </a>

    </div>

  </div>
</footer>


<style>
  .footer {
    position: relative;

    margin-top: 6rem;

    border-top:
      1px solid
      rgba(148, 163, 184, 0.1);

    background:
      rgba(2, 6, 23, 0.65);
  }


  .footer::before {
    content: "";

    position: absolute;

    top: 0;
    left: 50%;

    width: min(80%, 60rem);
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(103, 232, 249, 0.3),
        transparent
      );

    transform:
      translateX(-50%);
  }


  .footer__inner {
    width:
      min(
        calc(100% - 2.5rem),
        76rem
      );

    margin-inline: auto;
  }


  /* ========================================================
     MAIN
     ======================================================== */

  .footer__main {
    display: grid;

    grid-template-columns:
      minmax(0, 1.6fr)
      minmax(8rem, 0.7fr)
      auto;

    gap:
      clamp(2rem, 5vw, 5rem);

    padding:
      4rem 0 3rem;
  }


  /* ========================================================
     IDENTITY
     ======================================================== */

  .footer__identity {
    max-width: 28rem;
  }


  .footer__description {
    max-width: 24rem;

    margin:
      1.1rem 0 0;

    color:
      rgba(148, 163, 184, 0.75);

    font-size: 0.8rem;

    line-height: 1.7;
  }


  /* ========================================================
     NAVIGATION
     ======================================================== */

  .footer__heading {
    display: block;

    margin-bottom: 0.9rem;

    color:
      rgba(148, 163, 184, 0.5);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.58rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    line-height: 1;

    text-transform: uppercase;
  }


  .footer__nav ul {
    display: flex;

    flex-direction: column;

    align-items: flex-start;

    gap: 0.65rem;

    margin: 0;
    padding: 0;

    list-style: none;
  }


  /* ========================================================
     SOCIAL
     ======================================================== */

  .footer__social {
    min-width: 5rem;
  }


  /* ========================================================
     BOTTOM
     ======================================================== */

  .footer__bottom {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1rem;

    min-height: 4rem;

    border-top:
      1px solid
      rgba(148, 163, 184, 0.08);

    color:
      rgba(100, 116, 139, 0.65);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.55rem;

    font-weight: 700;

    letter-spacing: 0.08em;

    line-height: 1.4;

    text-transform: uppercase;
  }


  .footer__top {
    color:
      rgba(148, 163, 184, 0.65);

    text-decoration: none;

    transition:
      color 160ms ease;
  }


  .footer__top:hover {
    color:
      #67e8f9;
  }


  @media (max-width: 700px) {
    .footer__main {
      grid-template-columns:
        1fr 1fr;
    }


    .footer__identity {
      grid-column:
        1 / -1;
    }
  }


  @media (max-width: 480px) {
    .footer__inner {
      width:
        min(
          calc(100% - 2rem),
          76rem
        );
    }


    .footer__main {
      grid-template-columns: 1fr;

      padding:
        3rem 0 2rem;
    }


    .footer__identity {
      grid-column: auto;
    }


    .footer__bottom {
      align-items: flex-start;

      flex-direction: column;

      justify-content: center;

      padding:
        1.25rem 0;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .footer__top {
      transition: none;
    }
  }
</style>
