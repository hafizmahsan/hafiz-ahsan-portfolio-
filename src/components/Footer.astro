---
/**
 * ============================================================
 * PORTFOLIO FOOTER
 * ============================================================
 *
 * Minimal technical footer.
 *
 * Content is controlled from:
 *
 *     src/data/site.ts
 *
 * ============================================================
 */

import { site } from "../data/site";
---

<footer class="site-footer">

  <div class="site-footer__inner">

    <!-- ======================================================
         FOOTER TOP
         ====================================================== -->

    <div class="site-footer__top">

      <a
        href="#top"
        class="site-footer__brand"
        aria-label={`${site.name} — Back to top`}
      >

        <span
          class="site-footer__mark"
          aria-hidden="true"
        >
          {site.shortName}
        </span>

        <span class="site-footer__brand-info">

          <span class="site-footer__name">
            {site.name}
          </span>

          <span class="site-footer__role">
            {site.professionalTitle}
          </span>

        </span>

      </a>


      <div class="site-footer__status">

        <span
          class="site-footer__status-dot"
          aria-hidden="true"
        ></span>

        <span>
          {site.system?.status ?? "ONLINE"}
        </span>

      </div>

    </div>


    <!-- ======================================================
         FOOTER NAVIGATION
         ====================================================== -->

    <div class="site-footer__navigation">

      <span class="site-footer__label">
        / NAVIGATION
      </span>


      <nav aria-label="Footer navigation">

        {
          site.navigation.map(
            (item, index) => (
              <a
                href={item.href}
                class="site-footer__link"
              >

                <span class="site-footer__link-number">
                  {(index + 1)
                    .toString()
                    .padStart(2, "0")}
                </span>

                <span>
                  {item.label}
                </span>

              </a>
            )
          )
        }

      </nav>

    </div>


    <!-- ======================================================
         FOOTER BOTTOM
         ====================================================== -->

    <div class="site-footer__bottom">

      <span>
        © {new Date().getFullYear()}
        {" "}
        {site.footer?.copyrightName ?? site.name}
      </span>


      <span class="site-footer__message">
        {site.footer?.message ??
          "ENGINEERED WITH PRECISION."}
      </span>


      <span>
        V{site.footer?.version ?? "1.0.0"}
      </span>

    </div>

  </div>

</footer>


<style>
  /* ==========================================================
     FOOTER
     ========================================================== */

  .site-footer {
    position:
      relative;

    padding:
      3rem 0 1.5rem;

    border-top:
      1px solid var(--color-border);

    background:
      var(--color-background);
  }


  .site-footer::before {
    content:
      "";

    position:
      absolute;

    top:
      -1px;

    left:
      10%;

    width:
      80%;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.3),
        transparent
      );
  }


  /* ==========================================================
     INNER
     ========================================================== */

  .site-footer__inner {
    width:
      min(
        calc(100% - 2.5rem),
        var(--container-width)
      );

    margin-inline:
      auto;
  }


  /* ==========================================================
     TOP
     ========================================================== */

  .site-footer__top {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      2rem;

    padding-bottom:
      2rem;

    border-bottom:
      1px solid var(--color-border);
  }


  /* ==========================================================
     BRAND
     ========================================================== */

  .site-footer__brand {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.65rem;

    color:
      var(--color-text);

    text-decoration:
      none;
  }


  .site-footer__mark {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      34px;

    height:
      34px;

    border:
      1px solid rgba(34, 211, 238, 0.25);

    border-radius:
      0.4rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.035);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;

    font-weight:
      700;
  }


  .site-footer__brand-info {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.15rem;
  }


  .site-footer__name {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.7rem;

    font-weight:
      600;

    letter-spacing:
      -0.02em;
  }


  .site-footer__role {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.36rem;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  /* ==========================================================
     STATUS
     ========================================================== */

  .site-footer__status {
    display:
      flex;

    align-items:
      center;

    gap:
      0.45rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;
  }


  .site-footer__status-dot {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 10px
      rgba(34, 211, 238, 0.6);
  }


  /* ==========================================================
     NAVIGATION
     ========================================================== */

  .site-footer__navigation {
    display:
      grid;

    grid-template-columns:
      9rem minmax(0, 1fr);

    gap:
      2rem;

    padding:
      2rem 0;
  }


  .site-footer__label {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;

    font-weight:
      700;

    letter-spacing:
      0.1em;
  }


  .site-footer__navigation nav {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.6rem 1.5rem;
  }


  .site-footer__link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.45rem;

    font-weight:
      600;

    letter-spacing:
      0.04em;

    text-decoration:
      none;

    text-transform:
      uppercase;

    transition:
      color var(--duration-fast)
      var(--ease-standard);
  }


  .site-footer__link:hover {
    color:
      var(--color-cyan);
  }


  .site-footer__link-number {
    color:
      var(--color-text-subtle);

    font-size:
      0.38rem;
  }


  /* ==========================================================
     BOTTOM
     ========================================================== */

  .site-footer__bottom {
    display:
      grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items:
      center;

    gap:
      1rem;

    padding-top:
      1.25rem;

    border-top:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  .site-footer__message {
    color:
      var(--color-text-muted);

    text-align:
      center;
  }


  .site-footer__bottom > span:last-child {
    text-align:
      right;
  }


  /* ==========================================================
     RESPONSIVE
     ========================================================== */

  @media (max-width: 700px) {

    .site-footer {
      padding:
        2.5rem 0 1.25rem;
    }


    .site-footer__top {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        1.25rem;
    }


    .site-footer__navigation {
      grid-template-columns:
        1fr;

      gap:
        1rem;
    }


    .site-footer__bottom {
      grid-template-columns:
        1fr;

      align-items:
        start;

      gap:
        0.65rem;
    }


    .site-footer__message {
      order:
        -1;

      text-align:
        left;
    }


    .site-footer__bottom > span:last-child {
      text-align:
        left;
    }

  }


  @media (max-width: 640px) {

    .site-footer__inner {
      width:
        min(
          calc(100% - 2rem),
          var(--container-width)
        );
    }

  }


  /* ==========================================================
     REDUCED MOTION
     ========================================================== */

  @media (prefers-reduced-motion: reduce) {

    .site-footer__link {
      transition:
        none;
    }

  }
</style>
