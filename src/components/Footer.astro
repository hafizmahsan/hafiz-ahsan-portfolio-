---
/**
 * ============================================================
 * PORTFOLIO FOOTER
 * ============================================================
 *
 * Footer information is controlled from:
 *
 *     src/data/site.ts
 *
 * ============================================================
 */

import { site, getSiteVersion } from "../data/site";
---

<footer class="site-footer">

  <div class="site-footer__inner">

    <!-- ======================================================
         TOP
         ====================================================== -->

    <div class="site-footer__top">

      <a
        href="#top"
        class="site-footer__brand"
        aria-label={`${site.name} — Back to top`}
      >

        <span
          class="site-footer__mark"
          aria-hidden="true"
        >
          {site.shortName}
        </span>


        <span class="site-footer__identity">

          <span class="site-footer__name">
            {site.name}
          </span>

          <span class="site-footer__role">
            {site.professionalTitle}
          </span>

        </span>

      </a>


      <div class="site-footer__status">

        <span
          class="site-footer__status-dot"
          aria-hidden="true"
        ></span>

        <span>
          {site.system?.status ?? "ONLINE"}
        </span>

      </div>

    </div>


    <!-- ======================================================
         DIVIDER
         ====================================================== -->

    <div
      class="site-footer__divider"
      aria-hidden="true"
    ></div>


    <!-- ======================================================
         BOTTOM
         ====================================================== -->

    <div class="site-footer__bottom">

      <span class="site-footer__copyright">

        © {new Date().getFullYear()}
        {site.footer?.copyrightName ?? site.name}

      </span>


      <span class="site-footer__message">

        {site.footer?.message ??
          "ENGINEERED WITH PRECISION."}

      </span>


      <span class="site-footer__version">

        SYS /
        {getSiteVersion()}

      </span>

    </div>

  </div>

</footer>


<style>
  /* ========================================================
     FOOTER
     ======================================================== */

  .site-footer {
    position:
      relative;

    padding:
      2rem 0 2.5rem;

    border-top:
      1px solid var(--color-border);

    background:
      var(--color-background);
  }


  /* ========================================================
     INNER
     ======================================================== */

  .site-footer__inner {
    width:
      min(
        calc(100% - 2.5rem),
        var(--container-width)
      );

    margin-inline:
      auto;
  }


  /* ========================================================
     TOP
     ======================================================== */

  .site-footer__top {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      2rem;
  }


  /* ========================================================
     BRAND
     ======================================================== */

  .site-footer__brand {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.65rem;

    color:
      var(--color-text);

    text-decoration:
      none;
  }


  .site-footer__mark {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      30px;

    height:
      30px;

    border:
      1px solid
      rgba(34, 211, 238, 0.22);

    border-radius:
      0.35rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.035);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;

    font-weight:
      700;
  }


  .site-footer__identity {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.15rem;
  }


  .site-footer__name {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.7rem;

    font-weight:
      600;

    letter-spacing:
      -0.02em;
  }


  .site-footer__role {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.35rem;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .site-footer__status {
    display:
      flex;

    align-items:
      center;

    gap:
      0.4rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    font-weight:
      700;

    letter-spacing:
      0.06em;
  }


  .site-footer__status-dot {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 8px
      rgba(34, 211, 238, 0.7);
  }


  /* ========================================================
     DIVIDER
     ======================================================== */

  .site-footer__divider {
    width:
      100%;

    height:
      1px;

    margin:
      1.5rem 0;

    background:
      var(--color-border);
  }


  /* ========================================================
     BOTTOM
     ======================================================== */

  .site-footer__bottom {
    display:
      grid;

    grid-template-columns:
      1fr auto 1fr;

    align-items:
      center;

    gap:
      1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  .site-footer__copyright {
    justify-self:
      start;
  }


  .site-footer__message {
    justify-self:
      center;

    color:
      rgba(34, 211, 238, 0.55);
  }


  .site-footer__version {
    justify-self:
      end;

    color:
      rgba(148, 163, 184, 0.45);
  }


  /* ========================================================
     HOVER
     ======================================================== */

  .site-footer__brand:hover
    .site-footer__mark {

    border-color:
      rgba(34, 211, 238, 0.5);

    background:
      rgba(34, 211, 238, 0.07);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .site-footer {
      padding:
        1.75rem 0 2rem;
    }


    .site-footer__top {
      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        1rem;
    }


    .site-footer__bottom {
      display:
        flex;

      align-items:
        flex-start;

      flex-direction:
        column;

      gap:
        0.6rem;
    }


    .site-footer__message,
    .site-footer__version,
    .site-footer__copyright {
      justify-self:
        auto;
    }


    .site-footer__message {
      order:
        -1;
    }

  }


  @media (max-width: 640px) {

    .site-footer__inner {
      width:
        min(
          calc(100% - 2rem),
          var(--container-width)
        );
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .site-footer__brand,
    .site-footer__mark {
      transition:
        none;
    }

  }
</style>
