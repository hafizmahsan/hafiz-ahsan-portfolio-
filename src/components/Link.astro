---
/**
 * ============================================================
 * LINK
 * ============================================================
 *
 * Reusable text-link component.
 *
 * ============================================================
 */

import Icon from "./Icon.astro";

interface Props {
  href: string;

  label: string;

  variant?:
    | "default"
    | "muted"
    | "accent";

  icon?:
    | "arrow-right"
    | "arrow-up-right"
    | "external"
    | "none";

  external?: boolean;

  class?: string;

  ariaLabel?: string;
}

const {
  href,
  label,
  variant = "default",
  icon = "arrow-right",
  external = false,
  class: className = "",
  ariaLabel
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "link",
    `link--${variant}`,
    className
  ]}
  target={
    external
      ? "_blank"
      : undefined
  }
  rel={
    external
      ? "noopener noreferrer"
      : undefined
  }
  aria-label={
    ariaLabel ?? label
  }
>
  <span class="link__label">
    {label}
  </span>

  {
    icon !== "none" && (
      <Icon
        name={icon}
        size={15}
      />
    )
  }
</a>


<style>
  .link {
    display: inline-flex;

    align-items: center;

    gap: 0.45rem;

    width: fit-content;

    color:
      #67e8f9;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.7rem;

    font-weight: 700;

    letter-spacing: 0.08em;

    line-height: 1.2;

    text-decoration: none;

    text-transform: uppercase;

    transition:
      color 160ms ease;
  }


  .link__label {
    position: relative;
  }


  .link__label::after {
    content: "";

    position: absolute;

    left: 0;
    right: 0;
    bottom: -0.25rem;

    height: 1px;

    background:
      currentColor;

    transform:
      scaleX(0);

    transform-origin:
      right center;

    transition:
      transform 180ms ease;
  }


  .link:hover {
    color:
      #a5f3fc;
  }


  .link:hover
  .link__label::after {
    transform:
      scaleX(1);

    transform-origin:
      left center;
  }


  .link :global(.icon) {
    transition:
      transform 180ms ease;
  }


  .link:hover
  :global(.icon) {
    transform:
      translateX(3px);
  }


  /* ========================================================
     MUTED
     ======================================================== */

  .link--muted {
    color:
      rgba(148, 163, 184, 0.9);
  }


  .link--muted:hover {
    color:
      #e2e8f0;
  }


  /* ========================================================
     ACCENT
     ======================================================== */

  .link--accent {
    color:
      #c4b5fd;
  }


  .link--accent:hover {
    color:
      #ddd6fe;
  }


  @media (prefers-reduced-motion: reduce) {
    .link__label::after,
    .link :global(.icon) {
      transition: none;
    }
  }
</style>
