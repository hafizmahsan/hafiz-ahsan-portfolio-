---
/**
 * ============================================================
 * TIMELINE ITEM
 * ============================================================
 *
 * Reusable chronological content item.
 *
 * ============================================================
 */

import TagList from "./TagList.astro";

interface Props {
  period: string;

  title: string;

  organization?: string;

  description?: string;

  technologies?: string[];

  current?: boolean;

  class?: string;
}

const {
  period,
  title,
  organization,
  description,
  technologies = [],
  current = false,
  class: className = ""
} = Astro.props;
---

<article
  class:list={[
    "timeline-item",
    {
      "timeline-item--current":
        current
    },
    className
  ]}
>
  <div class="timeline-item__rail">
    <span
      class="timeline-item__dot"
      aria-hidden="true"
    />
  </div>


  <div class="timeline-item__content">

    <div class="timeline-item__period">
      {period}
    </div>


    <h3 class="timeline-item__title">
      {title}
    </h3>


    {
      organization && (
        <div class="timeline-item__organization">
          {organization}
        </div>
      )
    }


    {
      description && (
        <p class="timeline-item__description">
          {description}
        </p>
      )
    }


    {
      technologies.length > 0 && (
        <TagList
          items={technologies}
          variant="default"
          size="sm"
        />
      )
    }

  </div>
</article>


<style>
  .timeline-item {
    position: relative;

    display: grid;

    grid-template-columns:
      1.5rem minmax(0, 1fr);

    gap: 1.25rem;

    min-width: 0;

    padding-bottom: 3rem;
  }


  .timeline-item:last-child {
    padding-bottom: 0;
  }


  /* ========================================================
     RAIL
     ======================================================== */

  .timeline-item__rail {
    position: relative;

    display: flex;

    justify-content: center;

    width: 1.5rem;
  }


  .timeline-item__rail::after {
    content: "";

    position: absolute;

    top: 1rem;
    bottom: -0.5rem;

    left: 50%;

    width: 1px;

    background:
      linear-gradient(
        180deg,
        rgba(103, 232, 249, 0.28),
        rgba(148, 163, 184, 0.06)
      );

    transform:
      translateX(-50%);
  }


  .timeline-item:last-child
  .timeline-item__rail::after {
    display: none;
  }


  .timeline-item__dot {
    position: relative;

    z-index: 1;

    display: block;

    width: 0.55rem;
    height: 0.55rem;

    margin-top: 0.3rem;

    border:
      1px solid
      rgba(103, 232, 249, 0.55);

    border-radius: 999px;

    background:
      #020617;

    box-shadow:
      0 0 0 4px
      rgba(34, 211, 238, 0.04);
  }


  .timeline-item--current
  .timeline-item__dot {
    border-color:
      #67e8f9;

    background:
      #67e8f9;

    box-shadow:
      0 0 0 4px
      rgba(34, 211, 238, 0.08),
      0 0 18px
      rgba(34, 211, 238, 0.35);
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .timeline-item__content {
    min-width: 0;
  }


  .timeline-item__period {
    margin-bottom: 0.7rem;

    color:
      #67e8f9;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.65rem;

    font-weight: 700;

    letter-spacing: 0.1em;

    line-height: 1.3;

    text-transform: uppercase;
  }


  .timeline-item__title {
    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(1.2rem, 2vw, 1.5rem);

    font-weight: 700;

    letter-spacing: -0.025em;

    line-height: 1.15;
  }


  .timeline-item__organization {
    margin-top: 0.45rem;

    color:
      rgba(203, 213, 225, 0.75);

    font-size: 0.85rem;

    font-weight: 600;

    line-height: 1.5;
  }


  .timeline-item__description {
    max-width: 44rem;

    margin:
      1rem 0 0;

    color:
      rgba(148, 163, 184, 0.88);

    font-size: 0.9rem;

    line-height: 1.75;
  }


  .timeline-item__content
  :global(.tag-list) {
    margin-top: 1rem;
  }


  @media (max-width: 640px) {
    .timeline-item {
      grid-template-columns:
        1.15rem minmax(0, 1fr);

      gap: 0.9rem;

      padding-bottom: 2.5rem;
    }


    .timeline-item__rail {
      width: 1.15rem;
    }
  }
</style>
