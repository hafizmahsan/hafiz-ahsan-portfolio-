---
/**
 * ============================================================
 * PAGE SHELL
 * ============================================================
 *
 * Global page composition.
 *
 * Navbar
 *   ↓
 * Main content
 *   ↓
 * Footer
 *
 * ============================================================
 */

import Footer from "./Footer.astro";
import Navbar from "./Navbar.astro";
import SEO from "./SEO.astro";

import { portfolio } from "../data/portfolio";

interface Props {
  class?: string;
}

const {
  class: className = ""
} = Astro.props;
---

<div
  id="top"
  class:list={[
    "page-shell",
    className
  ]}
>
  <SEO
    title={portfolio.seo.title}
    description={portfolio.seo.description}
    siteUrl={portfolio.seo.siteUrl}
    image={portfolio.seo.image}
    imageAlt={portfolio.seo.imageAlt}
    themeColor={portfolio.seo.themeColor}
  />


  <Navbar />


  <main class="page-shell__main">
    <slot />
  </main>


  <Footer />
</div>


<style is:global>
  html {
    scroll-behavior: smooth;
  }


  body.menu-open {
    overflow: hidden;
  }


  .page-shell {
    position: relative;

    min-height: 100vh;

    overflow-x: clip;
  }


  .page-shell__main {
    position: relative;

    width: 100%;
  }


  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
