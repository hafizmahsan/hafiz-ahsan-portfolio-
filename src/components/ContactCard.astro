---
/**
 * ============================================================
 * CONTACT CARD
 * ============================================================
 *
 * Reusable contact / profile action card.
 *
 * Designed for:
 * - Email
 * - LinkedIn
 * - GitHub
 * - Resume
 * - Location
 * - Availability
 * - Other professional contact channels
 *
 * Content is supplied through props and can later be driven
 * entirely from the central portfolio data files.
 *
 * ============================================================
 */

interface ContactItem {
  label: string;
  value: string;
  href?: string;
  icon?: string;
  external?: boolean;
  accent?: "cyan" | "violet" | "blue" | "green";
}

interface Props {
  contact: ContactItem;
  index?: string;
  featured?: boolean;
}

const {
  contact,
  index = "01",
  featured = false
} = Astro.props;

const accent =
  contact.accent ?? "cyan";
---

<article
  class:list={[
    "contact-card",
    `contact-card-${accent}`,
    {
      "contact-card-featured": featured
    }
  ]}
>

  <!-- ======================================================
       CARD HEADER
       ====================================================== -->

  <div class="contact-card-header">

    <div class="contact-index">
      {index}
    </div>

    <div class="contact-signal">

      <span class="signal-dot"></span>

      <span class="signal-line"></span>

      <span class="signal-text">
        CONTACT.NODE
      </span>

    </div>

  </div>


  <!-- ======================================================
       ICON
       ====================================================== -->

  <div class="contact-icon-wrapper">

    <div class="contact-icon-ring">

      <span class="contact-icon">

        {
          contact.icon ?? "◇"
        }

      </span>

    </div>

  </div>


  <!-- ======================================================
       LABEL
       ====================================================== -->

  <div class="contact-label">
    {contact.label}
  </div>


  <!-- ======================================================
       VALUE / LINK
       ====================================================== -->

  {
    contact.href ? (
      <a
        href={contact.href}
        class="contact-value"
        target={contact.external ? "_blank" : undefined}
        rel={
          contact.external
            ? "noopener noreferrer"
            : undefined
        }
      >

        <span class="contact-value-text">
          {contact.value}
        </span>

        <span
          class="contact-arrow"
          aria-hidden="true"
        >
          ↗
        </span>

      </a>
    ) : (
      <span class="contact-value contact-value-static">

        <span class="contact-value-text">
          {contact.value}
        </span>

      </span>
    )
  }


  <!-- ======================================================
       FOOTER
       ====================================================== -->

  <div
    class="contact-card-footer"
    aria-hidden="true"
  >

    <span class="footer-node footer-node-active"></span>

    <span class="footer-line"></span>

    <span class="footer-code">
      LINK_{index}
    </span>

    <span class="footer-line footer-line-short"></span>

    <span class="footer-node"></span>

  </div>

</article>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .contact-card {
    --contact-accent:
      #22d3ee;

    --contact-accent-soft:
      rgba(34, 211, 238, 0.08);

    --contact-accent-border:
      rgba(34, 211, 238, 0.16);

    position:
      relative;

    display:
      flex;

    flex-direction:
      column;

    min-height:
      210px;

    padding:
      1.1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.55rem;

    background:
      rgba(148, 163, 184, 0.012);

    overflow:
      hidden;

    transition:
      transform var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .contact-card::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      2px;

    height:
      100%;

    background:
      linear-gradient(
        180deg,
        var(--contact-accent),
        transparent
      );

    opacity:
      0.45;
  }


  .contact-card::after {
    content:
      "";

    position:
      absolute;

    right:
      -60px;

    bottom:
      -60px;

    width:
      160px;

    height:
      160px;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        var(--contact-accent-soft),
        transparent 70%
      );

    pointer-events:
      none;
  }


  .contact-card:hover {
    transform:
      translateY(-4px);

    border-color:
      var(--contact-accent-border);

    background:
      rgba(148, 163, 184, 0.018);

    box-shadow:
      0 18px 55px rgba(0, 0, 0, 0.15),
      0 0 30px var(--contact-accent-soft);
  }


  /* ========================================================
     FEATURED
     ======================================================== */

  .contact-card-featured {
    border-color:
      var(--contact-accent-border);

    box-shadow:
      inset 0 0 35px var(--contact-accent-soft);
  }


  /* ========================================================
     HEADER
     ======================================================== */

  .contact-card-header {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;
  }


  .contact-index {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    min-width:
      25px;

    height:
      20px;

    padding:
      0 0.35rem;

    border:
      1px solid var(--contact-accent-border);

    border-radius:
      0.15rem;

    color:
      var(--contact-accent);

    background:
      var(--contact-accent-soft);

    font-family:
      var(--font-mono);

    font-size:
      0.2rem;

    letter-spacing:
      0.025em;
  }


  .contact-signal {
    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;
  }


  .signal-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--contact-accent);

    box-shadow:
      0 0 8px var(--contact-accent);

    animation:
      contact-signal-pulse 2s ease-in-out infinite;
  }


  .signal-line {
    width:
      22px;

    height:
      1px;

    background:
      var(--contact-accent-border);
  }


  .signal-text {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.17rem;

    letter-spacing:
      0.03em;
  }


  @keyframes contact-signal-pulse {

    0%,
    100% {
      opacity:
        0.35;
    }

    50% {
      opacity:
        1;
    }

  }


  /* ========================================================
     ICON
     ======================================================== */

  .contact-icon-wrapper {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      center;

    justify-content:
      flex-start;

    margin-top:
      1.15rem;
  }


  .contact-icon-ring {
    position:
      relative;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      45px;

    height:
      45px;

    border:
      1px solid var(--contact-accent-border);

    border-radius:
      50%;

    background:
      var(--contact-accent-soft);

    box-shadow:
      0 0 25px var(--contact-accent-soft);
  }


  .contact-icon-ring::before {
    content:
      "";

    position:
      absolute;

    inset:
      6px;

    border:
      1px dashed
      color-mix(
        in srgb,
        var(--contact-accent) 18%,
        transparent
      );

    border-radius:
      50%;

    animation:
      contact-ring-spin 14s linear infinite;
  }


  .contact-icon {
    position:
      relative;

    z-index:
      1;

    color:
      var(--contact-accent);

    font-family:
      var(--font-mono);

    font-size:
      0.8rem;

    line-height:
      1;
  }


  @keyframes contact-ring-spin {

    from {
      transform:
        rotate(0deg);
    }

    to {
      transform:
        rotate(360deg);
    }

  }


  /* ========================================================
     LABEL
     ======================================================== */

  .contact-label {
    position:
      relative;

    z-index:
      1;

    margin-top:
      0.9rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.22rem;

    letter-spacing:
      0.045em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     VALUE
     ======================================================== */

  .contact-value {
    position:
      relative;

    z-index:
      1;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.5rem;

    width:
      fit-content;

    max-width:
      100%;

    margin-top:
      0.3rem;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.85rem;

    font-weight:
      500;

    letter-spacing:
      -0.02em;

    line-height:
      1.25;

    text-decoration:
      none;

    overflow:
      hidden;
  }


  .contact-value-text {
    overflow:
      hidden;

    text-overflow:
      ellipsis;
  }


  .contact-value:hover {
    color:
      var(--contact-accent);
  }


  .contact-value-static {
    cursor:
      default;
  }


  .contact-arrow {
    flex-shrink:
      0;

    color:
      var(--contact-accent);

    font-family:
      var(--font-mono);

    font-size:
      0.65rem;

    transition:
      transform var(--duration-fast) var(--ease-standard);
  }


  .contact-value:hover
    .contact-arrow {

    transform:
      translate(2px, -2px);
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .contact-card-footer {
    position:
      relative;

    z-index:
      1;

    display:
      flex;

    align-items:
      center;

    gap:
      0.3rem;

    margin-top:
      auto;

    padding-top:
      1rem;
  }


  .footer-node {
    width:
      4px;

    height:
      4px;

    flex-shrink:
      0;

    border:
      1px solid var(--color-border);

    border-radius:
      50%;
  }


  .footer-node-active {
    border-color:
      var(--contact-accent-border);

    background:
      var(--contact-accent);

    box-shadow:
      0 0 7px var(--contact-accent);
  }


  .footer-line {
    width:
      30px;

    height:
      1px;

    background:
      var(--color-border);
  }


  .footer-line-short {
    width:
      15px;

    background:
      linear-gradient(
        90deg,
        var(--color-border),
        var(--contact-accent-border)
      );
  }


  .footer-code {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.17rem;

    letter-spacing:
      0.025em;

    white-space:
      nowrap;
  }


  /* ========================================================
     ACCENTS
     ======================================================== */

  .contact-card-cyan {
    --contact-accent:
      #22d3ee;

    --contact-accent-soft:
      rgba(34, 211, 238, 0.08);

    --contact-accent-border:
      rgba(34, 211, 238, 0.16);
  }


  .contact-card-violet {
    --contact-accent:
      #8b5cf6;

    --contact-accent-soft:
      rgba(139, 92, 246, 0.08);

    --contact-accent-border:
      rgba(139, 92, 246, 0.16);
  }


  .contact-card-blue {
    --contact-accent:
      #3b82f6;

    --contact-accent-soft:
      rgba(59, 130, 246, 0.08);

    --contact-accent-border:
      rgba(59, 130, 246, 0.16);
  }


  .contact-card-green {
    --contact-accent:
      #4ade80;

    --contact-accent-soft:
      rgba(74, 222, 128, 0.08);

    --contact-accent-border:
      rgba(74, 222, 128, 0.16);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .contact-card {

    background:
      rgba(15, 23, 42, 0.012);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 700px) {

    .contact-card {
      min-height:
        195px;

      padding:
        0.9rem;
    }


    .contact-value {
      font-size:
        0.76rem;
    }


    .contact-icon-ring {
      width:
        40px;

      height:
        40px;
    }

  }


  @media (max-width: 430px) {

    .contact-card {
      min-height:
        180px;
    }


    .contact-label {
      font-size:
        0.2rem;
    }


    .contact-value {
      font-size:
        0.68rem;
    }


    .signal-text {
      display:
        none;
    }


    .footer-code {
      font-size:
        0.15rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .signal-dot,
    .contact-icon-ring::before {
      animation:
        none;
    }


    .contact-card,
    .contact-value,
    .contact-arrow {
      transition:
        none;
    }

  }
</style>
