---
/**
 * ============================================================
 * CONTACT CARD
 * ============================================================
 *
 * Reusable contact / communication method.
 *
 * ============================================================
 */

import Icon from "./Icon.astro";
import Link from "./Link.astro";

interface Props {
  label: string;

  value: string;

  href?: string;

  icon?:
    | "mail"
    | "github"
    | "linkedin"
    | "external";

  description?: string;

  variant?:
    | "default"
    | "accent"
    | "muted";

  class?: string;
}

const {
  label,
  value,
  href,
  icon = "external",
  description,
  variant = "default",
  class: className = ""
} = Astro.props;

const isExternal =
  href?.startsWith("http://") ||
  href?.startsWith("https://");
---

<article
  class:list={[
    "contact-card",
    `contact-card--${variant}`,
    className
  ]}
>
  <div class="contact-card__icon">
    <Icon
      name={icon}
      size={20}
    />
  </div>


  <div class="contact-card__content">

    <span class="contact-card__label">
      {label}
    </span>


    {
      href ? (
        <a
          href={href}
          class="contact-card__value"
          target={
            isExternal
              ? "_blank"
              : undefined
          }
          rel={
            isExternal
              ? "noopener noreferrer"
              : undefined
          }
        >
          {value}
        </a>
      ) : (
        <span class="contact-card__value">
          {value}
        </span>
      )
    }


    {
      description && (
        <p class="contact-card__description">
          {description}
        </p>
      )
    }


    {
      href && (
        <Link
          href={href}
          label="CONNECT"
          icon="arrow-up-right"
          variant={
            variant === "accent"
              ? "accent"
              : "muted"
          }
          external={Boolean(isExternal)}
        />
      )
    }

  </div>
</article>


<style>
  .contact-card {
    display: grid;

    grid-template-columns:
      2.75rem minmax(0, 1fr);

    gap: 1rem;

    min-width: 0;

    padding:
      1.35rem;

    border:
      1px solid
      rgba(148, 163, 184, 0.11);

    border-radius:
      0.45rem;

    background:
      rgba(15, 23, 42, 0.3);

    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }


  .contact-card:hover {
    border-color:
      rgba(103, 232, 249, 0.25);

    background:
      rgba(15, 23, 42, 0.48);

    transform:
      translateY(-2px);
  }


  /* ========================================================
     ICON
     ======================================================== */

  .contact-card__icon {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 2.75rem;
    height: 2.75rem;

    border:
      1px solid
      rgba(103, 232, 249, 0.16);

    border-radius:
      0.35rem;

    color:
      #67e8f9;

    background:
      rgba(34, 211, 238, 0.045);
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .contact-card__content {
    display: flex;

    min-width: 0;

    flex-direction: column;

    align-items: flex-start;

    gap: 0.45rem;
  }


  .contact-card__label {
    color:
      rgba(148, 163, 184, 0.65);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.6rem;

    font-weight: 700;

    letter-spacing: 0.12em;

    line-height: 1;

    text-transform: uppercase;
  }


  .contact-card__value {
    max-width: 100%;

    overflow: hidden;

    color:
      #f8fafc;

    font-size:
      clamp(0.9rem, 1.5vw, 1rem);

    font-weight: 600;

    line-height: 1.4;

    text-decoration: none;

    text-overflow: ellipsis;

    white-space: nowrap;
  }


  a.contact-card__value:hover {
    color:
      #67e8f9;
  }


  .contact-card__description {
    max-width: 28rem;

    margin: 0 0 0.35rem;

    color:
      rgba(148, 163, 184, 0.78);

    font-size: 0.78rem;

    line-height: 1.6;
  }


  /* ========================================================
     VARIANTS
     ======================================================== */

  .contact-card--accent {
    border-color:
      rgba(103, 232, 249, 0.18);

    background:
      linear-gradient(
        145deg,
        rgba(8, 47, 73, 0.28),
        rgba(15, 23, 42, 0.3)
      );
  }


  .contact-card--accent
  .contact-card__icon {
    color:
      #a5f3fc;

    border-color:
      rgba(103, 232, 249, 0.28);

    background:
      rgba(34, 211, 238, 0.07);
  }


  .contact-card--muted {
    background:
      rgba(15, 23, 42, 0.18);
  }


  @media (max-width: 480px) {
    .contact-card {
      grid-template-columns:
        2.4rem minmax(0, 1fr);

      gap: 0.8rem;

      padding:
        1.1rem;
    }


    .contact-card__icon {
      width: 2.4rem;
      height: 2.4rem;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      transition: none;
    }
  }
</style>
