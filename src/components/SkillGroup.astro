---
/**
 * ============================================================
 * SKILL GROUP
 * ============================================================
 *
 * Reusable grouped skills / technologies component.
 *
 * ============================================================
 */

import Stack from "./Stack.astro";
import TagList from "./TagList.astro";

interface Props {
  number?: string;

  title: string;

  description?: string;

  skills: string[];

  variant?:
    | "default"
    | "cyan"
    | "violet"
    | "blue"
    | "green";

  class?: string;
}

const {
  number,
  title,
  description,
  skills,
  variant = "default",
  class: className = ""
} = Astro.props;
---

<article
  class:list={[
    "skill-group",
    `skill-group--${variant}`,
    className
  ]}
>
  <Stack gap="md">

    <div class="skill-group__header">

      {
        number && (
          <span class="skill-group__number">
            {number}
          </span>
        )
      }

      <h3 class="skill-group__title">
        {title}
      </h3>

    </div>


    {
      description && (
        <p class="skill-group__description">
          {description}
        </p>
      )
    }


    <TagList
      items={skills}
      variant={variant}
      size="sm"
      gap="sm"
    />

  </Stack>
</article>


<style>
  .skill-group {
    position: relative;

    min-width: 0;

    padding:
      1.4rem;

    border:
      1px solid
      rgba(148, 163, 184, 0.1);

    border-radius:
      0.45rem;

    background:
      rgba(15, 23, 42, 0.28);
  }


  .skill-group::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 2rem;
    height: 1px;

    background:
      rgba(103, 232, 249, 0.55);
  }


  /* ========================================================
     HEADER
     ======================================================== */

  .skill-group__header {
    display: flex;

    align-items: baseline;

    gap: 0.65rem;
  }


  .skill-group__number {
    color:
      rgba(103, 232, 249, 0.55);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.62rem;

    font-weight: 700;

    letter-spacing: 0.08em;
  }


  .skill-group__title {
    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(1rem, 1.8vw, 1.2rem);

    font-weight: 700;

    letter-spacing: -0.02em;

    line-height: 1.2;
  }


  /* ========================================================
     DESCRIPTION
     ======================================================== */

  .skill-group__description {
    max-width: 32rem;

    margin: 0;

    color:
      rgba(148, 163, 184, 0.8);

    font-size: 0.8rem;

    line-height: 1.65;
  }


  /* ========================================================
     VARIANTS
     ======================================================== */

  .skill-group--cyan::before {
    background:
      #67e8f9;
  }


  .skill-group--violet::before {
    background:
      #c4b5fd;
  }


  .skill-group--blue::before {
    background:
      #93c5fd;
  }


  .skill-group--green::before {
    background:
      #86efac;
  }


  @media (max-width: 640px) {
    .skill-group {
      padding:
        1.15rem;
    }
  }
</style>
