---
/**
 * ============================================================
 * PROJECTS SHOWCASE
 * ============================================================
 *
 * Presentation layer for the project portfolio.
 *
 * Project information comes from:
 *
 *     src/data/projects.ts
 *
 * To add/edit/remove a project, edit the data file instead
 * of modifying this component.
 * ============================================================
 */

import SectionHeading from "./SectionHeading.astro";
import { projects } from "../data/projects";
---

<section
  id="projects"
  class="projects-section section"
  aria-labelledby="projects-title"
>
  <!-- ======================================================
       BACKGROUND
       ====================================================== -->

  <div
    class="projects-background"
    aria-hidden="true"
  >

    <div class="projects-grid"></div>

    <div class="projects-glow projects-glow-one"></div>
    <div class="projects-glow projects-glow-two"></div>

    <!-- Technology connection lines -->

    <svg
      class="projects-network"
      viewBox="0 0 1000 500"
      preserveAspectRatio="none"
    >
      <path
        d="M0 120 C180 40 280 220 450 120 S720 50 1000 160"
      />

      <path
        d="M0 380 C200 300 300 460 500 350 S760 280 1000 400"
      />

      <circle cx="170" cy="110" r="3" />
      <circle cx="450" cy="120" r="3" />
      <circle cx="735" cy="85" r="3" />
      <circle cx="280" cy="405" r="3" />
      <circle cx="500" cy="350" r="3" />
      <circle cx="820" cy="330" r="3" />
    </svg>

  </div>


  <div class="container">

    <SectionHeading
      eyebrow="05 / Projects"
      title="Selected work & technical explorations."
      description="A curated collection of enterprise automation concepts, architecture work and ongoing experiments across RPA, integration and intelligent automation."
    />


    <!-- ====================================================
         PROJECT COUNTER
         ==================================================== -->

    <div class="projects-meta">

      <span>
        PROJECT DATABASE
      </span>

      <span class="projects-count">
        {String(projects.length).padStart(2, "0")}
        ENTRIES
      </span>

    </div>


    <!-- ====================================================
         PROJECT GRID
         ==================================================== -->

    <div class="projects-grid-list">

      {
        projects.map((project, index) => (
          <article
            class:list={[
              "project-card",
              {
                "project-featured": project.featured,
              },
            ]}
            style={`--project-accent: ${project.accent ?? "#22d3ee"};`}
          >

            <!-- ============================================
                 CARD VISUAL
                 ============================================ -->

            <div class="project-visual">

              <div class="visual-grid"></div>

              <div class="visual-orbit visual-orbit-one"></div>

              <div class="visual-orbit visual-orbit-two"></div>

              <div class="visual-node">

                <span class="visual-node-core"></span>

              </div>


              <div class="visual-code">
                {project.code ?? "SYS"}
              </div>


              <span class="visual-line visual-line-one"></span>
              <span class="visual-line visual-line-two"></span>
              <span class="visual-line visual-line-three"></span>


              <div class="visual-index">
                {String(index + 1).padStart(2, "0")}
              </div>

            </div>


            <!-- ============================================
                 CARD CONTENT
                 ============================================ -->

            <div class="project-content">

              <div class="project-header">

                <div>

                  <span class="project-category">
                    {project.category}
                  </span>

                  <h3 class="project-title">
                    {project.title}
                  </h3>

                </div>


                {
                  project.status && (
                    <span class="project-status">
                      <span class="status-dot"></span>
                      {project.status}
                    </span>
                  )
                }

              </div>


              {
                project.subtitle && (
                  <p class="project-subtitle">
                    {project.subtitle}
                  </p>
                )
              }


              <p class="project-description">
                {project.description}
              </p>


              <!-- ==========================================
                   HIGHLIGHTS
                   ========================================== -->

              {
                project.highlights?.length > 0 && (
                  <div class="project-highlights">

                    {
                      project.highlights.slice(0, 3).map((highlight) => (
                        <div class="project-highlight">

                          <span
                            class="highlight-icon"
                            aria-hidden="true"
                          >
                            +
                          </span>

                          <span>
                            {highlight}
                          </span>

                        </div>
                      ))
                    }

                  </div>
                )
              }


              <!-- ==========================================
                   TECHNOLOGIES
                   ========================================== -->

              {
                project.technologies?.length > 0 && (
                  <div class="project-technologies">

                    {
                      project.technologies.map((technology) => (
                        <span>
                          {technology}
                        </span>
                      ))
                    }

                  </div>
                )
              }


              <!-- ==========================================
                   FOOTER
                   ========================================== -->

              <div class="project-footer">

                <span class="project-id">
                  ID / {String(index + 1).padStart(3, "0")}
                </span>


                <div class="project-links">

                  {
                    project.github && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`View ${project.title} source code on GitHub`}
                      >
                        GitHub
                        <span aria-hidden="true">↗</span>
                      </a>
                    )
                  }


                  {
                    project.demo && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open live demo of ${project.title}`}
                      >
                        Live
                        <span aria-hidden="true">↗</span>
                      </a>
                    )
                  }

                </div>

              </div>

            </div>

          </article>
        ))
      }

    </div>


    <!-- ====================================================
         PROJECT CTA
         ==================================================== -->

    <div class="projects-cta">

      <div class="cta-line"></div>

      <p>
        Want to discuss an automation challenge?
      </p>

      <a
        href="#contact"
        class="projects-contact-link"
      >
        Start a conversation
        <span aria-hidden="true">→</span>
      </a>

    </div>

  </div>
</section>


<style>
  /* ========================================================
     SECTION
     ======================================================== */

  .projects-section {
    position:
      relative;

    overflow:
      hidden;
  }


  .projects-background {
    position:
      absolute;

    inset:
      0;

    z-index:
      -1;

    pointer-events:
      none;
  }


  .projects-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.18;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      70px 70px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 15%,
        black 85%,
        transparent
      );
  }


  .projects-glow {
    position:
      absolute;

    width:
      32rem;

    height:
      32rem;

    border-radius:
      50%;

    filter:
      blur(140px);
  }


  .projects-glow-one {
    top:
      5%;

    left:
      -15%;

    background:
      rgba(34, 211, 238, 0.025);
  }


  .projects-glow-two {
    right:
      -15%;

    bottom:
      5%;

    background:
      rgba(139, 92, 246, 0.025);
  }


  /* ========================================================
     NETWORK SVG
     ======================================================== */

  .projects-network {
    position:
      absolute;

    top:
      10%;

    left:
      0;

    width:
      100%;

    height:
      80%;

    opacity:
      0.12;

    overflow:
      visible;
  }


  .projects-network path {
    fill:
      none;

    stroke:
      var(--color-cyan);

    stroke-width:
      0.7;

    stroke-dasharray:
      5 10;

    animation:
      network-flow 12s linear infinite;
  }


  .projects-network path:nth-child(2) {
    stroke:
      var(--color-violet);

    animation-duration:
      16s;
  }


  .projects-network circle {
    fill:
      var(--color-cyan);

    filter:
      drop-shadow(
        0 0 5px
        var(--color-cyan)
      );
  }


  @keyframes network-flow {
    to {
      stroke-dashoffset:
        -150;
    }
  }


  /* ========================================================
     META
     ======================================================== */

  .projects-meta {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    margin-bottom:
      1rem;

    padding-bottom:
      0.7rem;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.46rem;

    letter-spacing:
      0.07em;
  }


  .projects-count {
    color:
      var(--color-cyan);
  }


  /* ========================================================
     GRID
     ======================================================== */

  .projects-grid-list {
    display:
      grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      1rem;
  }


  /* ========================================================
     CARD
     ======================================================== */

  .project-card {
    position:
      relative;

    display:
      flex;

    flex-direction:
      column;

    min-width:
      0;

    overflow:
      hidden;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(148, 163, 184, 0.012);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard);
  }


  .project-card:hover {
    transform:
      translateY(-4px);

    border-color:
      color-mix(
        in srgb,
        var(--project-accent) 35%,
        transparent
      );

    background:
      rgba(148, 163, 184, 0.025);
  }


  .project-featured {
    grid-column:
      span 2;

    display:
      grid;

    grid-template-columns:
      minmax(250px, 0.75fr)
      minmax(0, 1.25fr);
  }


  /* ========================================================
     VISUAL
     ======================================================== */

  .project-visual {
    position:
      relative;

    min-height:
      230px;

    overflow:
      hidden;

    border-bottom:
      1px solid var(--color-border);

    background:
      linear-gradient(
        135deg,
        color-mix(
          in srgb,
          var(--project-accent) 4%,
          transparent
        ),
        rgba(5, 9, 15, 0.7)
      );
  }


  .project-featured .project-visual {
    min-height:
      100%;
    
    border-right:
      1px solid var(--color-border);

    border-bottom:
      0;
  }


  .visual-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.3;

    background-image:
      linear-gradient(
        color-mix(
          in srgb,
          var(--project-accent) 10%,
          transparent
        ) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        color-mix(
          in srgb,
          var(--project-accent) 10%,
          transparent
        ) 1px,
        transparent 1px
      );

    background-size:
      32px 32px;

    mask-image:
      radial-gradient(
        circle at center,
        black,
        transparent 75%
      );
  }


  /* ========================================================
     ORBITS
     ======================================================== */

  .visual-orbit {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--project-accent) 22%,
        transparent
      );

    border-radius:
      50%;

    transform:
      translate(-50%, -50%)
      rotate(-15deg);
  }


  .visual-orbit-one {
    width:
      150px;

    height:
      80px;

    animation:
      orbit-rotate 10s linear infinite;
  }


  .visual-orbit-two {
    width:
      80px;

    height:
      150px;

    transform:
      translate(-50%, -50%)
      rotate(65deg);

    animation:
      orbit-rotate-reverse 14s linear infinite;
  }


  @keyframes orbit-rotate {
    to {
      transform:
        translate(-50%, -50%)
        rotate(345deg);
    }
  }


  @keyframes orbit-rotate-reverse {
    to {
      transform:
        translate(-50%, -50%)
        rotate(-295deg);
    }
  }


  /* ========================================================
     CENTRAL NODE
     ======================================================== */

  .visual-node {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      34px;

    height:
      34px;

    border:
      1px solid
      color-mix(
        in srgb,
        var(--project-accent) 45%,
        transparent
      );

    border-radius:
      50%;

    background:
      rgba(5, 9, 15, 0.8);

    box-shadow:
      0 0 30px
      color-mix(
        in srgb,
        var(--project-accent) 18%,
        transparent
      );

    transform:
      translate(-50%, -50%);
  }


  .visual-node-core {
    width:
      7px;

    height:
      7px;

    border-radius:
      50%;

    background:
      var(--project-accent);

    box-shadow:
      0 0 14px
      var(--project-accent);

    animation:
      core-pulse 2.4s ease-in-out infinite;
  }


  @keyframes core-pulse {
    0%,
    100% {
      transform:
        scale(0.8);

      opacity:
        0.65;
    }

    50% {
      transform:
        scale(1.35);

      opacity:
        1;
    }
  }


  /* ========================================================
     VISUAL CODE
     ======================================================== */

  .visual-code {
    position:
      absolute;

    top:
      1rem;

    left:
      1rem;

    color:
      color-mix(
        in srgb,
        var(--project-accent) 70%,
        white
      );

    font-family:
      var(--font-mono);

    font-size:
      0.55rem;

    letter-spacing:
      0.08em;
  }


  .visual-index {
    position:
      absolute;

    right:
      1rem;

    bottom:
      1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;
  }


  /* ========================================================
     CONNECTION LINES
     ======================================================== */

  .visual-line {
    position:
      absolute;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        color-mix(
          in srgb,
          var(--project-accent) 45%,
          transparent
        ),
        transparent
      );

    transform-origin:
      left center;
  }


  .visual-line-one {
    top:
      38%;

    left:
      8%;

    width:
      32%;

    transform:
      rotate(18deg);
  }


  .visual-line-two {
    top:
      60%;

    right:
      5%;

    width:
      35%;

    transform:
      rotate(-20deg);
  }


  .visual-line-three {
    top:
      72%;

    left:
      25%;

    width:
      25%;

    transform:
      rotate(4deg);
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .project-content {
    display:
      flex;

    flex:
      1;

    flex-direction:
      column;

    min-width:
      0;

    padding:
      1.3rem;
  }


  .project-header {
    display:
      flex;

    align-items:
      flex-start;

    justify-content:
      space-between;

    gap:
      1rem;
  }


  .project-category {
    display:
      block;

    margin-bottom:
      0.35rem;

    color:
      var(--project-accent);

    font-family:
      var(--font-mono);

    font-size:
      0.46rem;

    letter-spacing:
      0.07em;
  }


  .project-title {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(1rem, 1.8vw, 1.25rem);

    font-weight:
      500;

    letter-spacing:
      -0.035em;
  }


  .project-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    flex:
      0 0 auto;

    padding:
      0.28rem 0.4rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-pill);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    letter-spacing:
      0.05em;
  }


  .status-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--project-accent);

    box-shadow:
      0 0 7px var(--project-accent);
  }


  .project-subtitle {
    margin:
      0.55rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      0.62rem;

    line-height:
      1.55;
  }


  .project-description {
    margin:
      1rem 0 0;

    color:
      var(--color-text-subtle);

    font-size:
      0.61rem;

    line-height:
      1.7;
  }


  /* ========================================================
     HIGHLIGHTS
     ======================================================== */

  .project-highlights {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.45rem;

    margin-top:
      1rem;
  }


  .project-highlight {
    display:
      flex;

    align-items:
      flex-start;

    gap:
      0.45rem;

    color:
      var(--color-text-subtle);

    font-size:
      0.55rem;

    line-height:
      1.5;
  }


  .highlight-icon {
    color:
      var(--project-accent);

    font-family:
      var(--font-mono);
  }


  /* ========================================================
     TECHNOLOGIES
     ======================================================== */

  .project-technologies {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.35rem;

    margin-top:
      1.2rem;
  }


  .project-technologies span {
    padding:
      0.3rem 0.45rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.3rem;

    color:
      var(--color-text-subtle);

    background:
      rgba(148, 163, 184, 0.015);

    font-family:
      var(--font-mono);

    font-size:
      0.43rem;
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .project-footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-top:
      auto;

    padding-top:
      1.1rem;

    border-top:
      1px solid var(--color-border);
  }


  .project-id {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;
  }


  .project-links {
    display:
      flex;

    gap:
      0.7rem;
  }


  .project-links a {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.45rem;

    text-decoration:
      none;

    transition:
      color var(--duration-fast) var(--ease-standard);
  }


  .project-links a:hover {
    color:
      var(--project-accent);
  }


  /* ========================================================
     CTA
     ======================================================== */

  .projects-cta {
    display:
      flex;

    align-items:
      center;

    gap:
      1rem;

    margin-top:
      3rem;
  }


  .cta-line {
    width:
      40px;

    height:
      1px;

    background:
      var(--color-cyan);
  }


  .projects-cta p {
    margin:
      0;

    color:
      var(--color-text-subtle);

    font-size:
      0.58rem;
  }


  .projects-contact-link {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.4rem;

    color:
      var(--color-text);

    font-family:
      var(--font-mono);

    font-size:
      0.5rem;

    text-decoration:
      none;

    transition:
      color var(--duration-fast) var(--ease-standard);
  }


  .projects-contact-link:hover {
    color:
      var(--color-cyan);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 850px) {
    .projects-grid-list {
      grid-template-columns:
        1fr;
    }

    .project-featured {
      grid-column:
        span 1;

      display:
        flex;
    }

    .project-featured .project-visual {
      min-height:
        230px;

      border-right:
        0;

      border-bottom:
        1px solid var(--color-border);
    }
  }


  @media (max-width: 550px) {
    .projects-meta {
      font-size:
        0.4rem;
    }

    .project-header {
      flex-direction:
        column;
    }

    .project-status {
      align-self:
        flex-start;
    }

    .projects-cta {
      flex-wrap:
        wrap;
    }
  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {
    .projects-network path,
    .visual-orbit-one,
    .visual-orbit-two,
    .visual-node-core {
      animation:
        none;
    }

    .project-card {
      transition:
        none;
    }
  }
</style>
