---
/**
 * ============================================================
 * CONTACT SECTION
 * ============================================================
 *
 * Presentation layer for the contact section.
 *
 * Editable content:
 *
 *     src/data/contact.ts
 *
 * This component intentionally does not require a backend.
 * It is therefore fully compatible with GitHub Pages.
 * ============================================================
 */

import { contact } from "../data/contact";
---

<section
  id="contact"
  class="contact-section section"
  aria-labelledby="contact-title"
>
  <!-- ======================================================
       BACKGROUND SYSTEM
       ====================================================== -->

  <div
    class="contact-background"
    aria-hidden="true"
  >
    <div class="contact-grid"></div>

    <div class="contact-glow contact-glow-one"></div>
    <div class="contact-glow contact-glow-two"></div>

    <div class="signal-field">

      <span class="signal-node signal-node-one"></span>
      <span class="signal-node signal-node-two"></span>
      <span class="signal-node signal-node-three"></span>
      <span class="signal-node signal-node-four"></span>

      <span class="signal-line signal-line-one"></span>
      <span class="signal-line signal-line-two"></span>
      <span class="signal-line signal-line-three"></span>

    </div>
  </div>


  <div class="container">

    <!-- ====================================================
         HEADER
         ==================================================== -->

    <div class="contact-heading">

      <div class="heading-marker">
        <span></span>
        {contact.eyebrow}
      </div>


      <h2 id="contact-title">
        {contact.title}
      </h2>


      <p>
        {contact.description}
      </p>

    </div>


    <!-- ====================================================
         MAIN CONTACT INTERFACE
         ==================================================== -->

    <div class="contact-interface">

      <!-- ==============================================
           AVAILABILITY PANEL
           ============================================== -->

      <div class="availability-panel">

        <div class="panel-top">

          <span class="panel-label">
            CONNECTION STATUS
          </span>

          <span class="panel-id">
            CONTACT / 07
          </span>

        </div>


        <div class="availability-visual">

          <div class="availability-rings">

            <div class="availability-ring ring-one"></div>
            <div class="availability-ring ring-two"></div>
            <div class="availability-ring ring-three"></div>

          </div>


          <div class="availability-core">

            <span class="core-pulse"></span>

            <span class="core-text">
              ONLINE
            </span>

          </div>


          <div class="availability-orbit-node"></div>

        </div>


        <div class="availability-copy">

          <div class="availability-status">

            <span class="status-indicator"></span>

            <span>
              {contact.availability}
            </span>

          </div>


          <p>
            {contact.availabilityDescription}
          </p>

        </div>


        <div class="availability-meta">

          <div>
            <span>LOCATION</span>
            <strong>{contact.location}</strong>
          </div>

          <div>
            <span>RESPONSE</span>
            <strong>{contact.responseTime}</strong>
          </div>

        </div>

      </div>


      <!-- ==============================================
           CONTACT CHANNELS
           ============================================== -->

      <div class="contact-channels">

        <div class="channels-header">

          <span>
            DIRECT CHANNELS
          </span>

          <span>
            SECURE / OPEN
          </span>

        </div>


        <div class="channel-list">

          {
            contact.links.map((link, index) => (
              <div class="channel-wrapper">

                <a
                  class="channel-card"
                  href={link.href}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  aria-label={`${link.label}: ${link.value}`}
                  data-contact-link={link.label}
                  data-copy-value={
                    link.icon === "email"
                      ? link.value
                      : undefined
                  }
                >

                  <!-- ==================================
                       ICON
                       ================================== -->

                  <span
                    class="channel-icon"
                    aria-hidden="true"
                  >

                    {
                      link.icon === "email" && (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <rect
                            x="3"
                            y="5"
                            width="18"
                            height="14"
                            rx="2"
                          />
                          <path d="m3 7 9 6 9-6" />
                        </svg>
                      )
                    }


                    {
                      link.icon === "linkedin" && (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path
                            d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z"
                          />
                          <rect
                            x="2"
                            y="9"
                            width="4"
                            height="12"
                          />
                          <circle
                            cx="4"
                            cy="4"
                            r="2"
                          />
                        </svg>
                      )
                    }


                    {
                      link.icon === "github" && (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path
                            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.2 0 6.5-1.6 6.5-7A5.4 5.4 0 0 0 19 3.8 5 5 0 0 0 18.9 0S17.3-.5 15 1.5a13.4 13.4 0 0 0-7 0C5.7-.5 4.1 0 4.1 0A5 5 0 0 0 4 3.8a5.4 5.4 0 0 0-1.5 3.7c0 5.4 3.3 7 6.5 7a4.8 4.8 0 0 0-1 3.5v4"
                          />
                          <path d="M9 18c-4.5 2-5-2-7-2" />
                        </svg>
                      )
                    }


                    {
                      link.icon === "phone" && (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path
                            d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12.8 12.8 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5 12.8 12.8 0 0 0 2.8.7A2 2 0 0 1 22 16.9Z"
                          />
                        </svg>
                      )
                    }


                    {
                      link.icon === "location" && (
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                        >
                          <path
                            d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
                          />
                          <circle
                            cx="12"
                            cy="10"
                            r="2.5"
                          />
                        </svg>
                      )
                    }

                  </span>


                  <!-- ==================================
                       TEXT
                       ================================== -->

                  <span class="channel-content">

                    <span class="channel-label">
                      {link.label}
                    </span>

                    <span class="channel-value">
                      {link.value}
                    </span>

                    {
                      link.description && (
                        <span class="channel-description">
                          {link.description}
                        </span>
                      )
                    }

                  </span>


                  <!-- ==================================
                       ACTION
                       ================================== -->

                  <span
                    class="channel-arrow"
                    aria-hidden="true"
                  >
                    ↗
                  </span>

                </a>


                {
                  link.icon === "email" && (
                    <button
                      class="copy-button"
                      type="button"
                      data-copy-email={link.value}
                      aria-label="Copy email address"
                    >
                      COPY
                    </button>
                  )
                }

              </div>
            ))
          }

        </div>

      </div>

    </div>


    <!-- ====================================================
         CLOSING MESSAGE
         ==================================================== -->

    <div class="contact-closing">

      <div class="closing-line"></div>

      <div class="closing-content">

        <span>
          AUTOMATION / ARCHITECTURE / AI
        </span>

        <p>
          Good automation starts with understanding the problem.
        </p>

      </div>


      <a
        href="#top"
        class="back-top"
        aria-label="Back to top"
      >
        <span>BACK TO TOP</span>
        <strong>↑</strong>
      </a>

    </div>

  </div>
</section>


<script>
  /**
   * ==========================================================
   * COPY EMAIL
   * ==========================================================
   *
   * Uses the Clipboard API where available.
   *
   * No backend is required.
   */

  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-copy-email]"
    );


  copyButtons.forEach((button) => {

    button.addEventListener("click", async (event) => {

      event.preventDefault();

      event.stopPropagation();

      const email =
        button.dataset.copyEmail;


      if (!email) {
        return;
      }


      try {

        await navigator.clipboard.writeText(email);

        const originalText =
          button.textContent;


        button.textContent =
          "COPIED";


        button.classList.add(
          "is-copied"
        );


        window.setTimeout(() => {

          button.textContent =
            originalText;

          button.classList.remove(
            "is-copied"
          );

        }, 1800);

      } catch {

        /**
         * Clipboard access may be unavailable in
         * some browsers or restricted contexts.
         *
         * The email link itself still remains usable.
         */

        button.textContent =
          "USE EMAIL";


        window.setTimeout(() => {

          button.textContent =
            "COPY";

        }, 1800);

      }

    });

  });
</script>


<style>
  /* ========================================================
     SECTION
     ======================================================== */

  .contact-section {
    position:
      relative;

    overflow:
      hidden;

    padding-bottom:
      4rem;
  }


  .contact-background {
    position:
      absolute;

    inset:
      0;

    z-index:
      -1;

    pointer-events:
      none;
  }


  .contact-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.16;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      70px 70px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 15%,
        black 85%,
        transparent
      );
  }


  .contact-glow {
    position:
      absolute;

    width:
      30rem;

    height:
      30rem;

    border-radius:
      50%;

    filter:
      blur(150px);
  }


  .contact-glow-one {
    top:
      5%;

    right:
      -15%;

    background:
      rgba(34, 211, 238, 0.035);
  }


  .contact-glow-two {
    bottom:
      0;

    left:
      -15%;

    background:
      rgba(139, 92, 246, 0.025);
  }


  /* ========================================================
     SIGNAL FIELD
     ======================================================== */

  .signal-field {
    position:
      absolute;

    top:
      12%;

    right:
      10%;

    width:
      230px;

    height:
      180px;

    opacity:
      0.35;
  }


  .signal-node {
    position:
      absolute;

    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 9px var(--color-cyan);

    animation:
      signal-float 5s ease-in-out infinite;
  }


  .signal-node-one {
    top:
      15%;

    left:
      20%;
  }


  .signal-node-two {
    top:
      50%;

    left:
      50%;

    animation-delay:
      -1.2s;
  }


  .signal-node-three {
    right:
      12%;

    top:
      25%;

    background:
      var(--color-violet);

    box-shadow:
      0 0 9px var(--color-violet);

    animation-delay:
      -2.5s;
  }


  .signal-node-four {
    right:
      25%;

    bottom:
      10%;

    animation-delay:
      -3.5s;
  }


  .signal-line {
    position:
      absolute;

    width:
      100px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.25),
        transparent
      );

    transform-origin:
      left center;
  }


  .signal-line-one {
    top:
      17%;

    left:
      21%;

    transform:
      rotate(25deg);
  }


  .signal-line-two {
    top:
      50%;

    left:
      25%;

    transform:
      rotate(-17deg);
  }


  .signal-line-three {
    top:
      52%;

    left:
      52%;

    transform:
      rotate(38deg);
  }


  @keyframes signal-float {
    0%,
    100% {
      transform:
        translate(0, 0);

      opacity:
        0.35;
    }

    50% {
      transform:
        translate(5px, -7px);

      opacity:
        1;
    }
  }


  /* ========================================================
     HEADING
     ======================================================== */

  .contact-heading {
    max-width:
      760px;

    margin-bottom:
      2.5rem;
  }


  .heading-marker {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.45rem;

    margin-bottom:
      0.75rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.46rem;

    letter-spacing:
      0.07em;
  }


  .heading-marker span {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan);
  }


  .contact-heading h2 {
    max-width:
      700px;

    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(2rem, 5vw, 4rem);

    font-weight:
      500;

    line-height:
      0.98;

    letter-spacing:
      -0.055em;
  }


  .contact-heading p {
    max-width:
      650px;

    margin:
      1rem 0 0;

    color:
      var(--color-text-muted);

    font-size:
      0.66rem;

    line-height:
      1.8;
  }


  /* ========================================================
     INTERFACE
     ======================================================== */

  .contact-interface {
    display:
      grid;

    grid-template-columns:
      minmax(260px, 0.72fr)
      minmax(0, 1.28fr);

    gap:
      1rem;
  }


  .availability-panel,
  .contact-channels {
    overflow:
      hidden;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(148, 163, 184, 0.012);
  }


  /* ========================================================
     AVAILABILITY PANEL
     ======================================================== */

  .availability-panel {
    display:
      flex;

    flex-direction:
      column;
  }


  .panel-top {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    padding:
      0.8rem 1rem;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.43rem;

    letter-spacing:
      0.06em;
  }


  .panel-id {
    color:
      var(--color-cyan);
  }


  /* ========================================================
     AVAILABILITY VISUAL
     ======================================================== */

  .availability-visual {
    position:
      relative;

    width:
      190px;

    height:
      190px;

    margin:
      2rem auto 1.5rem;
  }


  .availability-rings {
    position:
      absolute;

    inset:
      0;
  }


  .availability-ring {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    border:
      1px solid rgba(34, 211, 238, 0.12);

    border-radius:
      50%;

    transform:
      translate(-50%, -50%);
  }


  .ring-one {
    width:
      100%;

    height:
      100%;

    animation:
      contact-ring 9s linear infinite;
  }


  .ring-two {
    width:
      70%;

    height:
      70%;

    border-color:
      rgba(59, 130, 246, 0.12);

    animation:
      contact-ring-reverse 12s linear infinite;
  }


  .ring-three {
    width:
      42%;

    height:
      42%;

    border-color:
      rgba(139, 92, 246, 0.14);
  }


  @keyframes contact-ring {
    to {
      transform:
        translate(-50%, -50%)
        rotate(360deg);
    }
  }


  @keyframes contact-ring-reverse {
    to {
      transform:
        translate(-50%, -50%)
        rotate(-360deg);
    }
  }


  .availability-core {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    display:
      flex;

    flex-direction:
      column;

    align-items:
      center;

    justify-content:
      center;

    width:
      74px;

    height:
      74px;

    border:
      1px solid rgba(34, 211, 238, 0.25);

    border-radius:
      50%;

    background:
      rgba(5, 9, 15, 0.9);

    box-shadow:
      0 0 40px rgba(34, 211, 238, 0.07);

    transform:
      translate(-50%, -50%);
  }


  .core-pulse {
    width:
      8px;

    height:
      8px;

    margin-bottom:
      0.4rem;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 16px var(--color-cyan);

    animation:
      contact-pulse 2.3s ease-in-out infinite;
  }


  @keyframes contact-pulse {
    0%,
    100% {
      transform:
        scale(0.75);

      opacity:
        0.6;
    }

    50% {
      transform:
        scale(1.25);

      opacity:
        1;
    }
  }


  .core-text {
    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;

    letter-spacing:
      0.06em;
  }


  .availability-orbit-node {
    position:
      absolute;

    top:
      5px;

    left:
      50%;

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 9px var(--color-cyan);

    transform:
      translateX(-50%);
  }


  /* ========================================================
     AVAILABILITY COPY
     ======================================================== */

  .availability-copy {
    padding:
      0 1.2rem 1.2rem;

    text-align:
      center;
  }


  .availability-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.4rem;

    color:
      var(--color-text);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;

    letter-spacing:
      0.05em;
  }


  .status-indicator {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 8px var(--color-cyan);
  }


  .availability-copy p {
    max-width:
      320px;

    margin:
      0.65rem auto 0;

    color:
      var(--color-text-subtle);

    font-size:
      0.55rem;

    line-height:
      1.65;
  }


  /* ========================================================
     AVAILABILITY META
     ======================================================== */

  .availability-meta {
    display:
      grid;

    grid-template-columns:
      1fr 1fr;

    margin-top:
      auto;

    border-top:
      1px solid var(--color-border);
  }


  .availability-meta > div {
    padding:
      0.8rem 1rem;
  }


  .availability-meta > div + div {
    border-left:
      1px solid var(--color-border);
  }


  .availability-meta span {
    display:
      block;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    letter-spacing:
      0.05em;
  }


  .availability-meta strong {
    display:
      block;

    margin-top:
      0.3rem;

    color:
      var(--color-text-muted);

    font-size:
      0.5rem;

    font-weight:
      400;
  }


  /* ========================================================
     CHANNELS
     ======================================================== */

  .contact-channels {
    padding:
      1rem;
  }


  .channels-header {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    padding:
      0 0 0.8rem;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.43rem;

    letter-spacing:
      0.06em;
  }


  .channels-header span:last-child {
    color:
      var(--color-cyan);
  }


  .channel-list {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.6rem;

    padding-top:
      0.8rem;
  }


  .channel-wrapper {
    position:
      relative;
  }


  .channel-card {
    position:
      relative;

    display:
      grid;

    grid-template-columns:
      42px 1fr auto;

    gap:
      0.8rem;

    align-items:
      center;

    min-height:
      82px;

    padding:
      0.8rem;

    overflow:
      hidden;

    border:
      1px solid var(--color-border);

    border-radius:
      0.55rem;

    color:
      inherit;

    text-decoration:
      none;

    background:
      rgba(148, 163, 184, 0.008);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      background var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
  }


  .channel-card::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    bottom:
      0;

    left:
      0;

    width:
      2px;

    background:
      linear-gradient(
        to bottom,
        transparent,
        var(--color-cyan),
        transparent
      );

    opacity:
      0;

    transition:
      opacity var(--duration-normal) var(--ease-standard);
  }


  .channel-card:hover {
    transform:
      translateX(3px);

    border-color:
      rgba(34, 211, 238, 0.16);

    background:
      rgba(34, 211, 238, 0.018);
  }


  .channel-card:hover::before {
    opacity:
      1;
  }


  /* ========================================================
     CHANNEL ICON
     ======================================================== */

  .channel-icon {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      42px;

    height:
      42px;

    border:
      1px solid var(--color-border);

    border-radius:
      0.45rem;

    color:
