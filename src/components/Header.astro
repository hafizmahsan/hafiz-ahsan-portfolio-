---
/**
 * ============================================================
 * PORTFOLIO HEADER / NAVIGATION
 * ============================================================
 *
 * Content is controlled from:
 *
 *     src/data/site.ts
 *
 * The header is intentionally reusable and does not contain
 * hardcoded navigation destinations.
 * ============================================================
 */

import { site } from "../data/site";
---

<header
  class="site-header"
  data-header
>

  <!-- ======================================================
       DECORATIVE TECHNICAL LINE
       ====================================================== -->

  <div
    class="header-scanline"
    aria-hidden="true"
  ></div>


  <div class="header-container">

    <!-- ====================================================
         BRAND
         ==================================================== -->

    <a
      href="#top"
      class="brand"
      aria-label={`${site.name} — Home`}
    >

      <span
        class="brand-mark"
        aria-hidden="true"
      >
        <span class="brand-mark-inner">
          {site.shortName}
        </span>
      </span>


      <span class="brand-information">

        <span class="brand-name">
          {site.name}
        </span>

        <span class="brand-role">
          {site.professionalTitle}
        </span>

      </span>

    </a>


    <!-- ====================================================
         DESKTOP NAVIGATION
         ==================================================== -->

    <nav
      class="desktop-navigation"
      aria-label="Primary navigation"
    >

      {
        site.navigation.map((item, index) => (
          <a
            href={item.href}
            class:list={[
              "navigation-link",
              {
                "navigation-link-active": index === 0
              }
            ]}
          >

            <span class="navigation-index">
              {(index + 1)
                .toString()
                .padStart(2, "0")}
            </span>

            <span class="navigation-label">
              {item.label}
            </span>

          </a>
        ))
      }

    </nav>


    <!-- ====================================================
         HEADER ACTIONS
         ==================================================== -->

    <div class="header-actions">

      <!-- ================================================
           SYSTEM STATUS
           ================================================ -->

      <div
        class="header-status"
        title="Portfolio system status"
      >

        <span class="status-indicator"></span>

        <span class="status-text">
          ONLINE
        </span>

      </div>


      <!-- ================================================
           THEME TOGGLE
           ================================================ -->

      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label="Switch to light theme"
        title="Toggle theme"
      >

        <span
          class="theme-icon theme-icon-sun"
          aria-hidden="true"
        >
          ☼
        </span>

        <span
          class="theme-icon theme-icon-moon"
          aria-hidden="true"
        >
          ◐
        </span>

      </button>


      <!-- ================================================
           CV BUTTON
           ================================================ -->

      {
        site.cv.enabled && (
          <a
            href="#contact"
            class="header-cv"
          >
            <span>
              CV
            </span>

            <span
              aria-hidden="true"
            >
              ↓
            </span>
          </a>
        )
      }


      <!-- ================================================
           MOBILE MENU
           ================================================ -->

      <button
        class="mobile-menu-toggle"
        type="button"
        data-menu-toggle
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >

        <span class="menu-line menu-line-one"></span>
        <span class="menu-line menu-line-two"></span>
        <span class="menu-line menu-line-three"></span>

      </button>

    </div>

  </div>


  <!-- ======================================================
       MOBILE NAVIGATION
       ====================================================== -->

  <div
    id="mobile-navigation"
    class="mobile-navigation"
    data-mobile-navigation
    aria-hidden="true"
  >

    <div class="mobile-navigation-inner">

      <div class="mobile-navigation-header">

        <span>
          NAVIGATION
        </span>

        <span>
          {site.shortName}
        </span>

      </div>


      <nav
        aria-label="Mobile navigation"
      >

        {
          site.navigation.map((item, index) => (
            <a
              href={item.href}
              class="mobile-navigation-link"
              data-mobile-link
            >

              <span class="mobile-navigation-number">
                {(index + 1)
                  .toString()
                  .padStart(2, "0")}
              </span>

              <span class="mobile-navigation-label">
                {item.label}
              </span>

              <span
                class="mobile-navigation-arrow"
                aria-hidden="true"
              >
                ↗
              </span>

            </a>
          ))
        }

      </nav>


      <div class="mobile-navigation-footer">

        <span>
          {site.location}
        </span>

        <span>
          RPA / AUTOMATION
        </span>

      </div>

    </div>

  </div>

</header>


<script>
  /**
   * ==========================================================
   * HEADER INTERACTION
   * ==========================================================
   */

  const header =
    document.querySelector<HTMLElement>(
      "[data-header]"
    );


  const menuToggle =
    document.querySelector<HTMLButtonElement>(
      "[data-menu-toggle]"
    );


  const mobileNavigation =
    document.querySelector<HTMLElement>(
      "[data-mobile-navigation]"
    );


  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>(
      "[data-mobile-link]"
    );


  const themeToggle =
    document.querySelector<HTMLButtonElement>(
      "[data-theme-toggle]"
    );


  /* ========================================================
     HEADER SCROLL EFFECT
     ======================================================== */

  const updateHeader =
    () => {

      if (!header) {
        return;
      }


      if (window.scrollY > 24) {

        header.setAttribute(
          "data-scrolled",
          "true"
        );

      } else {

        header.removeAttribute(
          "data-scrolled"
        );

      }

    };


  updateHeader();


  window.addEventListener(
    "scroll",
    updateHeader,
    {
      passive: true
    }
  );


  /* ========================================================
     MOBILE MENU
     ======================================================== */

  const closeMobileMenu =
    () => {

      if (!menuToggle || !mobileNavigation) {
        return;
      }


      menuToggle.setAttribute(
        "aria-expanded",
        "false"
      );


      menuToggle.setAttribute(
        "aria-label",
        "Open navigation menu"
      );


      mobileNavigation.setAttribute(
        "aria-hidden",
        "true"
      );


      document.body.removeAttribute(
        "data-menu-open"
      );

    };


  const openMobileMenu =
    () => {

      if (!menuToggle || !mobileNavigation) {
        return;
      }


      menuToggle.setAttribute(
        "aria-expanded",
        "true"
      );


      menuToggle.setAttribute(
        "aria-label",
        "Close navigation menu"
      );


      mobileNavigation.setAttribute(
        "aria-hidden",
        "false"
      );


      document.body.setAttribute(
        "data-menu-open",
        "true"
      );

    };


  menuToggle?.addEventListener(
    "click",
    () => {

      const isOpen =
        menuToggle.getAttribute(
          "aria-expanded"
        ) === "true";


      if (isOpen) {

        closeMobileMenu();

      } else {

        openMobileMenu();

      }

    }
  );


  /* ========================================================
     CLOSE MENU AFTER NAVIGATION
     ======================================================== */

  mobileLinks.forEach(
    (link) => {

      link.addEventListener(
        "click",
        () => {
          closeMobileMenu();
        }
      );

    }
  );


  /* ========================================================
     CLOSE MENU WITH ESCAPE
     ======================================================== */

  document.addEventListener(
    "keydown",
    (event) => {

      if (event.key === "Escape") {
        closeMobileMenu();
      }

    }
  );


  /* ========================================================
     CLOSE MENU WHEN RESIZING TO DESKTOP
     ======================================================== */

  window.addEventListener(
    "resize",
    () => {

      if (
        window.innerWidth > 900
      ) {

        closeMobileMenu();

      }

    }
  );


  /* ========================================================
     THEME TOGGLE
     ========================================================
     
     We intentionally use a tiny compatibility layer here.
     
     The complete theme system will be established in the
     global theme utility later.
     ======================================================== */

  const applyTheme =
    (theme: "dark" | "light") => {

      document.documentElement.setAttribute(
        "data-theme",
        theme
      );


      localStorage.setItem(
        "portfolio-theme",
        theme
      );


      if (themeToggle) {

        themeToggle.setAttribute(
          "aria-label",
          theme === "dark"
            ? "Switch to light theme"
            : "Switch to dark theme"
        );

      }

    };


  const getInitialTheme =
    (): "dark" | "light" => {

      const storedTheme =
        localStorage.getItem(
          "portfolio-theme"
        );


      if (
        storedTheme === "dark" ||
        storedTheme === "light"
      ) {

        return storedTheme;

      }


      const prefersLight =
        window.matchMedia(
          "(prefers-color-scheme: light)"
        ).matches;


      return prefersLight
        ? "light"
        : "dark";

    };


  const initialTheme =
    getInitialTheme();


  applyTheme(
    initialTheme
  );


  themeToggle?.addEventListener(
    "click",
    () => {

      const currentTheme =
        document.documentElement.getAttribute(
          "data-theme"
        );


      applyTheme(
        currentTheme === "light"
          ? "dark"
          : "light"
      );

    }
  );
</script>


<style>
  /* ========================================================
     HEADER
     ======================================================== */

  .site-header {
    position:
      fixed;

    top:
      0;

    left:
      0;

    right:
      0;

    z-index:
      1000;

    height:
      var(--header-height);

    border-bottom:
      1px solid transparent;

    background:
      rgba(7, 10, 15, 0.35);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    transition:
      background var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) var(--ease-standard),
      box-shadow var(--duration-normal) var(--ease-standard);
  }


  .site-header[data-scrolled="true"] {
    border-color:
      var(--color-border);

    background:
      rgba(7, 10, 15, 0.78);

    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.16);
  }


  /* ========================================================
     SCANLINE
     ======================================================== */

  .header-scanline {
    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      100%;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.5),
        transparent
      );

    opacity:
      0.6;

    animation:
      header-scan 7s linear infinite;
  }


  @keyframes header-scan {

    0% {
      transform:
        translateX(-100%);
    }

    100% {
      transform:
        translateX(100%);
    }

  }


  /* ========================================================
     CONTAINER
     ======================================================== */

  .header-container {
    width:
      min(
        calc(100% - 2rem),
        var(--container-width)
      );

    height:
      100%;

    margin:
      0 auto;

    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;
  }


  /* ========================================================
     BRAND
     ======================================================== */

  .brand {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.65rem;

    flex-shrink:
      0;

    color:
      var(--color-text);

    text-decoration:
      none;
  }


  .brand-mark {
    position:
      relative;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      34px;

    height:
      34px;

    border:
      1px solid rgba(34, 211, 238, 0.3);

    border-radius:
      0.45rem;

    background:
      linear-gradient(
        135deg,
        rgba(34, 211, 238, 0.08),
        rgba(139, 92, 246, 0.06)
      );

    overflow:
      hidden;
  }


  .brand-mark::before {
    content:
      "";

    position:
      absolute;

    inset:
      4px;

    border:
      1px solid rgba(34, 211, 238, 0.08);

    border-radius:
      0.3rem;
  }


  .brand-mark-inner {
    position:
      relative;

    z-index:
      1;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;

    letter-spacing:
      -0.04em;
  }


  .brand-information {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.12rem;
  }


  .brand-name {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.72rem;

    font-weight:
      600;

    letter-spacing:
      -0.025em;
  }


  .brand-role {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.37rem;

    letter-spacing:
      0.025em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     DESKTOP NAVIGATION
     ======================================================== */

  .desktop-navigation {
    display:
      flex;

    align-items:
      center;

    gap:
      0.15rem;

    margin-left:
      auto;

    margin-right:
      0.8rem;
  }


  .navigation-link {
    position:
      relative;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.5rem 0.6rem;

    color:
      var(--color-text-subtle);

    text-decoration:
      none;

    transition:
      color var(--duration-fast) var(--ease-standard);
  }


  .navigation-link::after {
    content:
      "";

    position:
      absolute;

    right:
      0.6rem;

    bottom:
      0.15rem;

    left:
      0.6rem;

    height:
      1px;

    background:
      var(--color-cyan);

    transform:
      scaleX(0);

    transform-origin:
      right;

    transition:
      transform var(--duration-fast) var(--ease-standard);
  }


  .navigation-link:hover,
  .navigation-link-active {
    color:
      var(--color-text);
  }


  .navigation-link:hover::after,
  .navigation-link-active::after {
    transform:
      scaleX(1);

    transform-origin:
      left;
  }


  .navigation-index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.34rem;

    opacity:
      0.55;
  }


  .navigation-label {
    font-family:
      var(--font-mono);

    font-size:
      0.42rem;

    letter-spacing:
      0.02em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     ACTIONS
     ======================================================== */

  .header-actions {
    display:
      flex;

    align-items:
      center;

    gap:
      0.45rem;

    flex-shrink:
      0;
  }


  /* ========================================================
     STATUS
     ======================================================== */

  .header-status {
    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    margin-right:
      0.15rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.35rem;

    letter-spacing:
      0.04em;
  }


  .status-indicator {
    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 9px rgba(34, 211, 238, 0.75);

    animation:
      header-status-pulse 2.2s ease-in-out infinite;
  }


  @keyframes header-status-pulse {

    0%,
    100% {
      opacity:
        0.45;

      transform:
        scale(0.85);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1);
    }

  }


  /* ========================================================
     THEME BUTTON
     ======================================================== */

  .theme-toggle {
    position:
      relative;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      30px;

    height:
      30px;

    padding:
      0;

    border:
      1px solid var(--color-border);

    border-radius:
      0.35rem;

    color:
      var(--color-text-muted);

    background:
      rgba(148, 163, 184, 0.025);

    cursor:
      pointer;

    overflow:
      hidden;

    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }


  .theme-toggle:hover {
    border-color:
      rgba(34, 211, 238, 0.3);

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.05);
  }


  .theme-icon {
    position:
      absolute;

    font-size:
      0.8rem;

    line-height:
      1;

    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }


  .theme-icon-sun {
    opacity:
      0;

    transform:
      rotate(-45deg) scale(0.7);
  }


  .theme-icon-moon {
    opacity:
      1;

    transform:
      rotate(0) scale(1);
  }


  [data-theme="light"] .theme-icon-sun {
    opacity:
      1;

    transform:
      rotate(0) scale(1);
  }


  [data-theme="light"] .theme-icon-moon {
    opacity:
      0;

    transform:
      rotate(45deg) scale(0.7);
  }


  /* ========================================================
     CV BUTTON
     ======================================================== */

  .header-cv {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.3rem;

    padding:
      0.48rem 0.7rem;

    border:
      1px solid rgba(34, 211, 238, 0.2);

    border-radius:
      0.35rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.035);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    letter-spacing:
      0.025em;

    text-decoration:
      none;

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }


  .header-cv:hover {
    border-color:
      rgba(34, 211, 238, 0.5);

    background:
      rgba(34, 211, 238, 0.08);

    box-shadow:
      0 0 20px rgba(34, 211, 238, 0.08);
  }


  /* ========================================================
     MOBILE MENU BUTTON
     ======================================================== */

  .mobile-menu-toggle {
    display:
      none;

    position:
      relative;

    width:
      34px;

    height:
      34px;

    padding:
      0;

    border:
      1px solid var(--color-border);

    border-radius:
      0.35rem;

    background:
      rgba(148, 163, 184, 0.025);

    cursor:
      pointer;
  }


  .menu-line {
    position:
      absolute;

    left:
      9px;

    width:
      14px;

    height:
      1px;

    background:
      var(--color-text-muted);

    transition:
      transform var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }


  .menu-line-one {
    top:
      11px;
  }


  .menu-line-two {
    top:
      16px;
  }


  .menu-line-three {
    top:
      21px;
  }


  .mobile-menu-toggle[aria-expanded="true"]
    .menu-line-one {

    transform:
      translateY(5px) rotate(45deg);

  }


  .mobile-menu-toggle[aria-expanded="true"]
    .menu-line-two {

    opacity:
      0;

  }


  .mobile-menu-toggle[aria-expanded="true"]
    .menu-line-three {

    transform:
      translateY(-5px) rotate(-45deg);

  }


  /* ========================================================
     MOBILE NAVIGATION
     ======================================================== */

  .mobile-navigation {
    position:
      fixed;

    top:
      var(--header-height);

    right:
      0;

    bottom:
      0;

    left:
      0;

    z-index:
      -1;

    visibility:
      hidden;

    opacity:
      0;

    background:
      rgba(7, 10, 15, 0.96);

    backdrop-filter:
      blur(20px);

    -webkit-backdrop-filter:
      blur(20px);

    transform:
      translateY(-10px);

    transition:
      opacity var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard),
      visibility var(--duration-normal);
  }


  .mobile-navigation[aria-hidden="false"] {
    visibility:
      visible;

    opacity:
      1;

    transform:
      translateY(0);
  }


  .mobile-navigation-inner {
    width:
      min(
        calc(100% - 2rem),
        650px
      );

    margin:
      0 auto;

    padding:
      1.5rem 0;
  }


  .mobile-navigation-header {
    display:
      flex;

    justify-content:
      space-between;

    padding-bottom:
      0.8rem;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    letter-spacing:
      0.05em;
  }


  .mobile-navigation-header span:last-child {
    color:
      var(--color-cyan);
  }


  .mobile-navigation nav {
    display:
      flex;

    flex-direction:
      column;
  }


  .mobile-navigation-link {
    display:
      grid;

    grid-template-columns:
      30px 1fr auto;

    align-items:
      center;

    gap:
      0.8rem;

    padding:
      1rem 0;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-muted);

    text-decoration:
      none;

    transition:
      color var(--duration-fast) var(--ease-standard),
      padding-left var(--duration-fast) var(--ease-standard);
  }


  .mobile-navigation-link:hover {
    padding-left:
      0.4rem;

    color:
      var(--color-cyan);
  }


  .mobile-navigation-number {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;
  }


  .mobile-navigation-label {
    font-family:
      var(--font-display);

    font-size:
      1.1rem;

    letter-spacing:
      -0.03em;
  }


  .mobile-navigation-arrow {
    color:
      var(--color-text-subtle);

    font-size:
      1rem;
  }


  .mobile-navigation-footer {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      1rem;

    padding-top:
      1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    letter-spacing:
      0.04em;
  }


  /* ========================================================
     MOBILE BODY LOCK
     ======================================================== */

  :global(body[data-menu-open]) {
    overflow:
      hidden;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"]) .site-header {
    background:
      rgba(248, 250, 252, 0.55);
