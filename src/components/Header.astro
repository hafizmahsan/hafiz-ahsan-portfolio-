---
/**
 * ============================================================
 * GLOBAL HEADER / NAVIGATION
 * ============================================================
 *
 * Responsibilities:
 *
 * - Desktop navigation
 * - Mobile navigation
 * - Theme switcher
 * - CV button
 * - Accessible menu controls
 * - Scroll-aware header
 *
 * Navigation content comes from:
 *
 * src/data/navigation.ts
 *
 * This means menu changes can be made without editing the
 * component itself.
 * ============================================================
 */

import {
  getPrimaryNavigation
} from "../data/navigation";

import { siteConfig } from "../data/site";

const navigationItems =
  getPrimaryNavigation();

/**
 * Small inline SVG icons.
 *
 * We are keeping these lightweight and dependency-free for
 * now. A larger icon system can be introduced later for the
 * rest of the application.
 */
const icons = {
  menu: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  `,

  close: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  `,

  sun: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
    </svg>
  `,

  moon: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
  `,

  download: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3v12" />
      <path d="m7 10 5 5 5-5" />
      <path d="M5 21h14" />
    </svg>
  `,

  arrow: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
  `
};
---

<header
  class="site-header"
  id="site-header"
>
  <div class="header-shell">
    <!-- ====================================================
         BRAND
         ==================================================== -->

    <a
      href="#home"
      class="brand"
      aria-label={`${siteConfig.siteName} home`}
    >
      <span
        class="brand-mark"
        aria-hidden="true"
      >
        <span>H</span>
        <span>A</span>
      </span>

      <span class="brand-copy">
        <span class="brand-name">
          Hafiz Ahsan
        </span>

        <span class="brand-role">
          RPA · Automation · AI
        </span>
      </span>
    </a>


    <!-- ====================================================
         DESKTOP NAVIGATION
         ==================================================== -->

    <nav
      class="desktop-navigation"
      aria-label="Primary navigation"
    >
      <div class="navigation-list">
        {
          navigationItems.map((item) => (
            <a
              href={item.href}
              class="navigation-link"
              data-nav-link={item.id}
              aria-label={item.ariaLabel}
            >
              <span class="navigation-index">
                {String(item.order).padStart(2, "0")}
              </span>

              <span>
                {item.label}
              </span>

              <span
                class="navigation-dot"
                aria-hidden="true"
              />
            </a>
          ))
        }
      </div>
    </nav>


    <!-- ====================================================
         HEADER ACTIONS
         ==================================================== -->

    <div class="header-actions">
      <!-- CV -->

      <a
        href="/resume.pdf"
        class="cv-button"
        download
        aria-label="Download CV"
      >
        <span>
          CV
        </span>

        <span
          class="icon"
          set:html={icons.download}
        />
      </a>


      <!-- Theme -->

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Switch theme"
        aria-pressed="false"
      >
        <span
          class="theme-icon theme-icon-sun"
          set:html={icons.sun}
        />

        <span
          class="theme-icon theme-icon-moon"
          set:html={icons.moon}
        />
      </button>


      <!-- Mobile menu -->

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-navigation"
      >
        <span
          class="menu-icon menu-icon-open"
          set:html={icons.menu}
        />

        <span
          class="menu-icon menu-icon-close"
          set:html={icons.close}
        />
      </button>
    </div>
  </div>


  <!-- ======================================================
       MOBILE NAVIGATION
       ====================================================== -->

  <div
    class="mobile-navigation"
    id="mobile-navigation"
    aria-hidden="true"
  >
    <div class="mobile-navigation-inner">
      <div class="mobile-navigation-label">
        <span class="tech-node"></span>

        <span>
          NAVIGATION
        </span>
      </div>

      <nav aria-label="Mobile navigation">
        <div class="mobile-navigation-list">
          {
            navigationItems.map((item) => (
              <a
                href={item.href}
                class="mobile-navigation-link"
                data-mobile-nav-link={item.id}
              >
                <span class="mobile-navigation-number">
                  {String(item.order).padStart(2, "0")}
                </span>

                <span class="mobile-navigation-name">
                  {item.label}
                </span>

                <span
                  class="mobile-navigation-arrow"
                  set:html={icons.arrow}
                />
              </a>
            ))
          }
        </div>
      </nav>

      <div class="mobile-navigation-footer">
        <span>
          RPA · AUTOMATION · AI
        </span>

        <span>
          {siteConfig.location}
        </span>
      </div>
    </div>
  </div>
</header>


<style>
  /* ========================================================
     HEADER
     ======================================================== */

  .site-header {
    position: fixed;

    top: 0;
    left: 0;

    z-index: var(--z-header);

    width: 100%;

    padding:
      1rem var(--content-padding);

    pointer-events: none;

    transition:
      padding var(--duration-normal) var(--ease-standard);
  }


  .header-shell {
    pointer-events: auto;

    width:
      min(
        100%,
        var(--content-width-wide)
      );

    min-height: 4.5rem;

    margin-inline: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 1.5rem;

    padding:
      0.7rem 0.8rem 0.7rem 1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-xl);

    background:
      color-mix(
        in srgb,
        var(--color-surface-solid) 72%,
        transparent
      );

    box-shadow:
      var(--shadow-md);

    backdrop-filter:
      blur(22px);

    -webkit-backdrop-filter:
      blur(22px);

    transition:
      background-color var(--duration-normal) ease,
      border-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease,
      transform var(--duration-normal) var(--ease-standard);
  }


  .site-header.scrolled {
    padding-top: 0.65rem;
    padding-bottom: 0.65rem;
  }


  .site-header.scrolled .header-shell {
    border-color:
      var(--color-border-strong);

    box-shadow:
      var(--shadow-lg),
      0 0 30px rgba(34, 211, 238, 0.04);
  }


  /* ========================================================
     BRAND
     ======================================================== */

  .brand {
    display: flex;

    align-items: center;

    gap: 0.75rem;

    min-width: max-content;
  }


  .brand-mark {
    position: relative;

    width: 2.45rem;
    height: 2.45rem;

    display: grid;

    place-items: center;

    border:
      1px solid rgba(34, 211, 238, 0.35);

    border-radius:
      0.8rem;

    background:
      linear-gradient(
        135deg,
        rgba(34, 211, 238, 0.12),
        rgba(139, 92, 246, 0.12)
      );

    box-shadow:
      0 0 25px rgba(34, 211, 238, 0.08);

    overflow: hidden;
  }


  .brand-mark::before {
    content: "";

    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        135deg,
        transparent 35%,
        rgba(255, 255, 255, 0.08),
        transparent 65%
      );

    transform:
      translateX(-100%);

    transition:
      transform 700ms var(--ease-standard);
  }


  .brand:hover .brand-mark::before {
    transform:
      translateX(100%);
  }


  .brand-mark span {
    position: absolute;

    font-family:
      var(--font-display);

    font-size:
      0.65rem;

    font-weight:
      700;

    line-height: 1;
  }


  .brand-mark span:first-child {
    transform:
      translate(-0.28rem, -0.18rem);

    color:
      var(--color-cyan);
  }


  .brand-mark span:last-child {
    transform:
      translate(0.28rem, 0.18rem);

    color:
      var(--color-violet-bright);
  }


  .brand-copy {
    display: flex;

    flex-direction: column;

    gap: 0.05rem;
  }


  .brand-name {
    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.92rem;

    font-weight:
      600;

    line-height:
      1.1;
  }


  .brand-role {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.55rem;

    letter-spacing:
      0.05em;

    line-height:
      1.2;

    text-transform:
      uppercase;
  }


  /* ========================================================
     DESKTOP NAVIGATION
     ======================================================== */

  .desktop-navigation {
    flex: 1;

    display: flex;

    justify-content: center;
  }


  .navigation-list {
    display: flex;

    align-items: center;

    gap: 0.15rem;

    padding: 0.25rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-pill);

    background:
      rgba(148, 163, 184, 0.025);
  }


  .navigation-link {
    position: relative;

    display: flex;

    align-items: center;

    gap: 0.42rem;

    padding:
      0.55rem 0.7rem;

    border-radius:
      var(--radius-pill);

    color:
      var(--color-text-muted);

    font-size:
      0.7rem;

    font-weight:
      500;

    transition:
      color var(--duration-fast) ease,
      background-color var(--duration-fast) ease;
  }


  .navigation-link:hover,
  .navigation-link.active {
    color:
      var(--color-text);

    background:
      rgba(148, 163, 184, 0.07);
  }


  .navigation-index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.52rem;

    opacity:
      0.75;
  }


  .navigation-dot {
    width:
      3px;

    height:
      3px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    opacity:
      0;

    box-shadow:
      0 0 8px var(--color-cyan);

    transition:
      opacity var(--duration-fast) ease;
  }


  .navigation-link:hover .navigation-dot,
  .navigation-link.active .navigation-dot {
    opacity:
      1;
  }


  /* ========================================================
     HEADER ACTIONS
     ======================================================== */

  .header-actions {
    display: flex;

    align-items: center;

    gap: 0.45rem;
  }


  .cv-button {
    display: inline-flex;

    align-items: center;

    gap: 0.4rem;

    min-height: 2.65rem;

    padding:
      0.55rem 0.8rem;

    border:
      1px solid rgba(34, 211, 238, 0.22);

    border-radius:
      var(--radius-pill);

    background:
      rgba(34, 211, 238, 0.06);

    color:
      var(--color-cyan-bright);

    font-family:
      var(--font-mono);

    font-size:
      0.66rem;

    font-weight:
      600;

    letter-spacing:
      0.05em;

    transition:
      transform var(--duration-normal) var(--ease-standard),
      border-color var(--duration-normal) ease,
      background-color var(--duration-normal) ease,
      box-shadow var(--duration-normal) ease;
  }


  .cv-button:hover {
    transform:
      translateY(-2px);

    border-color:
      rgba(34, 211, 238, 0.5);

    background:
      rgba(34, 211, 238, 0.1);

    box-shadow:
      0 0 24px rgba(34, 211, 238, 0.12);
  }


  .icon,
  .theme-icon,
  .menu-icon,
  .mobile-navigation-arrow {
    display: flex;

    width: 1rem;
    height: 1rem;
  }


  .icon :global(svg),
  .theme-icon :global(svg),
  .menu-icon :global(svg),
  .mobile-navigation-arrow :global(svg) {
    width: 100%;
    height: 100%;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;

    stroke-linejoin: round;
  }


  .theme-toggle,
  .menu-toggle {
    position: relative;

    width: 2.65rem;
    height: 2.65rem;

    display: grid;

    place-items: center;

    padding: 0;

    border:
      1px solid var(--color-border);

    border-radius:
      50%;

    background:
      rgba(148, 163, 184, 0.04);

    color:
      var(--color-text-secondary);

    transition:
      transform var(--duration-normal) var(--ease-standard),
      color var(--duration-fast) ease,
      border-color var(--duration-normal) ease,
      background-color var(--duration-normal) ease;
  }


  .theme-toggle:hover,
  .menu-toggle:hover {
    transform:
      translateY(-2px);

    border-color:
      var(--color-border-strong);

    background:
      rgba(148, 163, 184, 0.08);

    color:
      var(--color-text);
  }


  .theme-icon {
    position: absolute;

    transition:
      opacity var(--duration-normal) ease,
      transform var(--duration-normal) var(--ease-standard);
  }


  html[data-theme="dark"] .theme-icon-sun {
    opacity: 0;

    transform:
      rotate(-45deg)
      scale(0.5);
  }


  html[data-theme="dark"] .theme-icon-moon {
    opacity: 1;

    transform:
      rotate(0)
      scale(1);
  }


  html[data-theme="light"] .theme-icon-sun {
    opacity: 1;

    transform:
      rotate(0)
      scale(1);
  }


  html[data-theme="light"] .theme-icon-moon {
    opacity: 0;

    transform:
      rotate(45deg)
      scale(0.5);
  }


  .menu-toggle {
    display: none;
  }


  .menu-icon {
    position: absolute;

    transition:
      opacity var(--duration-normal) ease,
      transform var(--duration-normal) var(--ease-standard);
  }


  .menu-icon-open {
    opacity: 1;
  }


  .menu-icon-close {
    opacity: 0;

    transform:
      rotate(-45deg)
      scale(0.5);
  }


  .site-header.menu-open .menu-icon-open {
    opacity: 0;

    transform:
      rotate(45deg)
      scale(0.5);
  }


  .site-header.menu-open .menu-icon-close {
    opacity: 1;

    transform:
      rotate(0)
      scale(1);
  }


  /* ========================================================
     MOBILE NAVIGATION
     ======================================================== */

  .mobile-navigation {
    position: fixed;

    inset:
      0;

    z-index: -1;

    display: flex;

    align-items: flex-start;

    padding:
      7.2rem var(--content-padding) 2rem;

    background:
      color-mix(
        in srgb,
        var(--color-background) 94%,
        transparent
      );

    backdrop-filter:
      blur(24px);

    -webkit-backdrop-filter:
      blur(24px);

    opacity:
      0;

    visibility:
      hidden;

    transform:
      translateY(-1rem);

    transition:
      opacity 400ms var(--ease-standard),
      visibility 400ms var(--ease-standard),
      transform 500ms var(--ease-standard);
  }


  .site-header.menu-open .mobile-navigation {
    opacity:
      1;

    visibility:
      visible;

    transform:
      translateY(0);
  }


  .mobile-navigation::before {
    content: "";

    position: absolute;

    top: 7rem;
    left: 8%;
    right: 8%;

    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        var(--color-cyan),
        var(--color-violet),
        transparent
      );

    opacity:
      0.35;
  }


  .mobile-navigation-inner {
    width:
      min(
        100%,
        700px
      );

    margin-inline:
      auto;
  }


  .mobile-navigation-label {
    display: flex;

    align-items: center;

    gap: 0.7rem;

    margin-bottom:
      1.5rem;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.68rem;

    letter-spacing:
      0.12em;
  }


  .mobile-navigation-list {
    display:
      flex;

    flex-direction:
      column;
  }


  .mobile-navigation-link {
    display:
      grid;

    grid-template-columns:
      2.5rem 1fr auto;

    align-items:
      center;

    gap:
      1rem;

    padding:
      1.1rem 0;

    border-bottom:
      1px solid var(--color-border);

    color:
      var(--color-text-secondary);

    transition:
      color var(--duration-normal) ease,
      padding-left var(--duration-normal) var(--ease-standard);
  }


  .mobile-navigation-link:hover {
    padding-left:
      0.5rem;

    color:
      var(--color-text);
  }


  .mobile-navigation-number {
    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.65rem;
  }


  .mobile-navigation-name {
    font-family:
      var(--font-display);

    font-size:
      clamp(1.35rem, 6vw, 2rem);

    font-weight:
      500;
  }


  .mobile-navigation-arrow {
    color:
      var(--color-text-muted);

    transition:
      transform var(--duration-normal) var(--ease-standard),
      color var(--duration-normal) ease;
  }


  .mobile-navigation-link:hover .mobile-navigation-arrow {
    color:
      var(--color-cyan);

    transform:
      translateX(0.25rem);
  }


  .mobile-navigation-footer {
    display:
      flex;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-top:
      2.5rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.58rem;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 1080px) {
    .navigation-link {
      padding-inline:
        0.5rem;

      font-size:
        0.64rem;
    }

    .navigation-index {
      display:
        none;
    }

    .brand-role {
      display:
        none;
    }
  }


  @media (max-width: 900px) {
    .desktop-navigation {
      display:
        none;
    }

    .menu-toggle {
      display:
        grid;
    }

    .cv-button {
      padding-inline:
        0.7rem;
    }
  }


  @media (max-width: 520px) {
    .site-header {
      padding:
        0.7rem 0.75rem;
    }

    .header-shell {
      min-height:
        4rem;

      padding:
        0.55rem 0.6rem 0.55rem 0.75rem;

      border-radius:
        var(--radius-lg);
    }

    .brand-copy {
      display:
        none;
    }

    .brand-mark {
      width:
        2.35rem;

      height:
        2.35rem;
    }

    .cv-button span:first-child {
      display:
        none;
    }

    .cv-button {
      width:
        2.65rem;

      height:
        2.65rem;

      justify-content:
        center;

      padding:
        0;
    }

    .mobile-navigation {
      padding-top:
        6.5rem;
    }

    .mobile-navigation::before {
      top:
        6.2rem;
    }

    .mobile-navigation-footer {
      flex-direction:
        column;
    }
  }
</style>


<script>
  /**
   * ==========================================================
   * HEADER INTERACTION
   * ==========================================================
   */

  const header =
    document.querySelector<HTMLElement>(
      "#site-header"
    );

  const menuToggle =
    document.querySelector<HTMLButtonElement>(
      "#menu-toggle"
    );

  const mobileNavigation =
    document.querySelector<HTMLElement>(
      "#mobile-navigation"
    );

  const themeToggle =
    document.querySelector<HTMLButtonElement>(
      "#theme-toggle"
    );

  const mobileLinks =
    document.querySelectorAll<HTMLAnchorElement>(
      "[data-mobile-nav-link]"
    );

  const navigationLinks =
    document.querySelectorAll<HTMLAnchorElement>(
      "[data-nav-link]"
    );


  /* ========================================================
     SCROLL STATE
     ======================================================== */

  const updateHeaderState = () => {
    if (!header) {
      return;
    }

    header.classList.toggle(
      "scrolled",
      window.scrollY > 24
    );
  };

  updateHeaderState();

  window.addEventListener(
    "scroll",
    updateHeaderState,
    { passive: true }
  );


  /* ========================================================
     MOBILE MENU
     ======================================================== */

  const closeMobileMenu = () => {
    if (!header || !menuToggle || !mobileNavigation) {
      return;
    }

    header.classList.remove(
      "menu-open"
    );

    menuToggle.setAttribute(
      "aria-expanded",
      "false"
    );

    menuToggle.setAttribute(
      "aria-label",
      "Open navigation menu"
    );

    mobileNavigation.setAttribute(
      "aria-hidden",
      "true"
    );

    document.body.style.overflow = "";
  };


  const openMobileMenu = () => {
    if (!header || !menuToggle || !mobileNavigation) {
      return;
    }

    header.classList.add(
      "menu-open"
    );

    menuToggle.setAttribute(
      "aria-expanded",
      "true"
    );

    menuToggle.setAttribute(
      "aria-label",
      "Close navigation menu"
    );

    mobileNavigation.setAttribute(
      "aria-hidden",
      "false"
    );

    document.body.style.overflow =
      "hidden";
  };


  menuToggle?.addEventListener(
    "click",
    () => {
      const isOpen =
        header?.classList.contains(
          "menu-open"
        );

      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    }
  );


  mobileLinks.forEach((link) => {
    link.addEventListener(
      "click",
      () => {
        closeMobileMenu();
      }
    );
  });


  /* ========================================================
     ESCAPE KEY
     ======================================================== */

  document.addEventListener(
    "keydown",
    (event) => {
      if (
        event.key === "Escape" &&
        header?.classList.contains(
          "menu-open"
        )
      ) {
        closeMobileMenu();

        menuToggle?.focus();
      }
    }
  );


  /* ========================================================
     THEME SWITCHER
     ======================================================== */

  const getCurrentTheme = () => {
    return (
      document.documentElement.dataset
        .theme === "light"
        ? "light"
        : "dark"
    );
  };


  const updateThemeButton = () => {
    if (!themeToggle) {
      return;
    }

    const isLight =
      getCurrentTheme() === "light";

    themeToggle.setAttribute(
      "aria-pressed",
      String(isLight)
    );

    themeToggle.setAttribute(
      "aria-label",
      isLight
        ? "Switch to dark theme"
        : "Switch to light theme"
    );
  };


  themeToggle?.addEventListener(
    "click",
    () => {
      const nextTheme =
        getCurrentTheme() === "dark"
          ? "light"
          : "dark";

      document.documentElement.dataset.theme =
        nextTheme;

      try {
        localStorage.setItem(
          "hafiz-portfolio-theme",
          nextTheme
        );
      } catch {
        // Storage may be unavailable in some browser contexts.
      }

      updateThemeButton();
    }
  );


  updateThemeButton();


  /* ========================================================
     ACTIVE SECTION
     ========================================================
     *
     * The header will eventually highlight the section the
     * visitor is currently viewing.
     *
     * IntersectionObserver is used instead of continuously
     * calculating scroll positions.
     */

  const sectionIds =
    Array.from(
      navigationLinks
    )
      .map(
        (link) =>
          link.getAttribute("href")
      )
      .filter(
        (
          href
        ): href is string =>
          Boolean(
            href &&
            href.startsWith("#")
          )
      );


  const sections =
    sectionIds
      .map(
        (id) =>
          document.querySelector(
            id
          )
      )
      .filter(
        (
          section
        ): section is Element =>
          Boolean(section)
      );


  if (
    sections.length > 0 &&
    "IntersectionObserver" in window
  ) {
    const sectionObserver =
      new IntersectionObserver(
        (entries) => {
          entries.forEach(
            (entry) => {
              if (!entry.isIntersecting) {
                return;
              }

              const id =
                `#${entry.target.id}`;

              navigationLinks.forEach(
                (link) => {
                  link.classList.toggle(
                    "active",
                    link.getAttribute(
                      "href"
                    ) === id
                  );
                }
              );
            }
          );
        },
        {
          rootMargin:
            "-35% 0px -55% 0px",
          threshold:
            0
        }
      );

    sections.forEach(
      (section) => {
        sectionObserver.observe(
          section
        );
      }
    );
  }


  /* ========================================================
     RESIZE SAFETY
     ======================================================== */

  window.addEventListener(
    "resize",
    () => {
      if (
        window.innerWidth > 900 &&
        header?.classList.contains(
          "menu-open"
        )
      ) {
        closeMobileMenu();
      }
    }
  );
</script>
