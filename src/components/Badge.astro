---
/**
 * ============================================================
 * BADGE
 * ============================================================
 *
 * Small reusable label/tag component.
 *
 * ============================================================
 */

interface Props {
  label: string;

  variant?:
    | "default"
    | "cyan"
    | "violet"
    | "blue"
    | "green"
    | "warning"
    | "danger";

  size?:
    | "sm"
    | "md";

  dot?: boolean;

  uppercase?: boolean;

  class?: string;

  ariaLabel?: string;
}

const {
  label,
  variant = "default",
  size = "sm",
  dot = false,
  uppercase = true,
  class: className = "",
  ariaLabel
} = Astro.props;
---

<span
  class:list={[
    "badge",
    `badge--${variant}`,
    `badge--${size}`,
    {
      "badge--uppercase": uppercase
    },
    className
  ]}
  aria-label={ariaLabel}
>
  {
    dot && (
      <span
        class="badge__dot"
        aria-hidden="true"
      />
    )
  }

  <span class="badge__label">
    {label}
  </span>
</span>


<style>
  .badge {
    display: inline-flex;
    align-items: center;

    width: fit-content;

    border: 1px solid transparent;
    border-radius: 999px;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-weight: 600;

    white-space: nowrap;

    line-height: 1;

    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease;
  }


  .badge--sm {
    min-height: 1.7rem;

    padding:
      0.4rem 0.65rem;

    gap: 0.4rem;

    font-size: 0.62rem;

    letter-spacing: 0.08em;
  }


  .badge--md {
    min-height: 2rem;

    padding:
      0.5rem 0.8rem;

    gap: 0.45rem;

    font-size: 0.68rem;

    letter-spacing: 0.08em;
  }


  .badge--uppercase
  .badge__label {
    text-transform: uppercase;
  }


  /* ========================================================
     DEFAULT
     ======================================================== */

  .badge--default {
    color:
      rgba(203, 213, 225, 0.9);

    background:
      rgba(148, 163, 184, 0.06);

    border-color:
      rgba(148, 163, 184, 0.18);
  }


  /* ========================================================
     CYAN
     ======================================================== */

  .badge--cyan {
    color:
      rgba(103, 232, 249, 0.95);

    background:
      rgba(34, 211, 238, 0.07);

    border-color:
      rgba(34, 211, 238, 0.25);
  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .badge--violet {
    color:
      rgba(196, 181, 253, 0.95);

    background:
      rgba(139, 92, 246, 0.08);

    border-color:
      rgba(139, 92, 246, 0.25);
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .badge--blue {
    color:
      rgba(147, 197, 253, 0.95);

    background:
      rgba(59, 130, 246, 0.08);

    border-color:
      rgba(59, 130, 246, 0.25);
  }


  /* ========================================================
     GREEN
     ======================================================== */

  .badge--green {
    color:
      rgba(134, 239, 172, 0.95);

    background:
      rgba(34, 197, 94, 0.08);

    border-color:
      rgba(34, 197, 94, 0.25);
  }


  /* ========================================================
     WARNING
     ======================================================== */

  .badge--warning {
    color:
      rgba(253, 224, 71, 0.95);

    background:
      rgba(234, 179, 8, 0.08);

    border-color:
      rgba(234, 179, 8, 0.25);
  }


  /* ========================================================
     DANGER
     ======================================================== */

  .badge--danger {
    color:
      rgba(252, 165, 165, 0.95);

    background:
      rgba(239, 68, 68, 0.08);

    border-color:
      rgba(239, 68, 68, 0.25);
  }


  /* ========================================================
     STATUS DOT
     ======================================================== */

  .badge__dot {
    width: 0.4rem;
    height: 0.4rem;

    flex: 0 0 auto;

    border-radius: 999px;

    background:
      currentColor;

    box-shadow:
      0 0 8px
      currentColor;
  }


  @media (prefers-reduced-motion: reduce) {
    .badge {
      transition: none;
    }
  }
</style>
