---
/**
 * ============================================================
 * TECH BADGE
 * ============================================================
 *
 * Reusable technology / skill badge.
 *
 * Examples:
 *
 * <TechBadge label="UiPath" />
 *
 * <TechBadge
 *   label="LangChain"
 *   category="AI"
 *   accent="violet"
 * />
 *
 * <TechBadge
 *   label="Python"
 *   icon="◆"
 * />
 *
 * ============================================================
 */

interface Props {
  label: string;
  category?: string;
  icon?: string;
  accent?: "cyan" | "violet" | "blue" | "green" | "neutral";
  size?: "small" | "medium";
}

const {
  label,
  category,
  icon = "◇",
  accent = "cyan",
  size = "medium"
} = Astro.props;
---

<div
  class:list={[
    "tech-badge",
    `tech-badge-${accent}`,
    `tech-badge-${size}`
  ]}
  data-tech-badge
>

  <!-- ======================================================
       ICON
       ====================================================== -->

  <span
    class="tech-badge-icon"
    aria-hidden="true"
  >
    {icon}
  </span>


  <!-- ======================================================
       CONTENT
       ====================================================== -->

  <span class="tech-badge-content">

    <span class="tech-badge-label">
      {label}
    </span>

    {
      category && (
        <span class="tech-badge-category">
          {category}
        </span>
      )
    }

  </span>


  <!-- ======================================================
       DECORATIVE NODE
       ====================================================== -->

  <span
    class="tech-badge-node"
    aria-hidden="true"
  ></span>

</div>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .tech-badge {
    position:
      relative;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.55rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.4rem;

    color:
      var(--color-text-muted);

    background:
      rgba(148, 163, 184, 0.018);

    overflow:
      hidden;

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }


  /* ========================================================
     SIZES
     ======================================================== */

  .tech-badge-small {
    padding:
      0.35rem 0.5rem;
  }


  .tech-badge-medium {
    padding:
      0.5rem 0.65rem;
  }


  /* ========================================================
     ICON
     ======================================================== */

  .tech-badge-icon {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      18px;

    height:
      18px;

    flex-shrink:
      0;

    border:
      1px solid rgba(34, 211, 238, 0.15);

    border-radius:
      0.25rem;

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.035);

    font-family:
      var(--font-mono);

    font-size:
      0.45rem;

    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }


  .tech-badge-small
    .tech-badge-icon {

    width:
      16px;

    height:
      16px;

    font-size:
      0.4rem;
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .tech-badge-content {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.08rem;

    min-width:
      0;
  }


  .tech-badge-label {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.47rem;

    line-height:
      1.2;

    letter-spacing:
      0.02em;

    white-space:
      nowrap;

    transition:
      color var(--duration-fast) var(--ease-standard);
  }


  .tech-badge-small
    .tech-badge-label {

    font-size:
      0.42rem;

  }


  .tech-badge-category {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.34rem;

    line-height:
      1.2;

    letter-spacing:
      0.04em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     NODE
     ======================================================== */

  .tech-badge-node {
    position:
      absolute;

    right:
      -2px;

    bottom:
      -2px;

    width:
      5px;

    height:
      5px;

    border:
      1px solid var(--color-cyan);

    border-radius:
      50%;

    background:
      var(--color-bg);

    box-shadow:
      0 0 8px rgba(34, 211, 238, 0.35);

    opacity:
      0.7;
  }


  /* ========================================================
     HOVER
     ======================================================== */

  .tech-badge:hover {
    border-color:
      rgba(34, 211, 238, 0.3);

    background:
      rgba(34, 211, 238, 0.035);

    transform:
      translateY(-2px);

    box-shadow:
      0 8px 25px rgba(0, 0, 0, 0.12);
  }


  .tech-badge:hover
    .tech-badge-label {

    color:
      var(--color-text);

  }


  .tech-badge:hover
    .tech-badge-icon {

    border-color:
      rgba(34, 211, 238, 0.35);

    background:
      rgba(34, 211, 238, 0.08);

    color:
      var(--color-cyan);

  }


  /* ========================================================
     CYAN
     ======================================================== */

  .tech-badge-cyan
    .tech-badge-icon {

    color:
      var(--color-cyan);

  }


  .tech-badge-cyan
    .tech-badge-node {

    border-color:
      var(--color-cyan);

  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .tech-badge-violet
    .tech-badge-icon {

    color:
      var(--color-violet);

    border-color:
      rgba(139, 92, 246, 0.18);

    background:
      rgba(139, 92, 246, 0.035);

  }


  .tech-badge-violet
    .tech-badge-node {

    border-color:
      var(--color-violet);

    box-shadow:
      0 0 8px rgba(139, 92, 246, 0.35);

  }


  .tech-badge-violet:hover {
    border-color:
      rgba(139, 92, 246, 0.3);

    background:
      rgba(139, 92, 246, 0.035);
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .tech-badge-blue
    .tech-badge-icon {

    color:
      var(--color-blue);

    border-color:
      rgba(59, 130, 246, 0.18);

    background:
      rgba(59, 130, 246, 0.035);

  }


  .tech-badge-blue
    .tech-badge-node {

    border-color:
      var(--color-blue);

    box-shadow:
      0 0 8px rgba(59, 130, 246, 0.35);

  }


  .tech-badge-blue:hover {
    border-color:
      rgba(59, 130, 246, 0.3);

    background:
      rgba(59, 130, 246, 0.035);
  }


  /* ========================================================
     GREEN
     ======================================================== */

  .tech-badge-green
    .tech-badge-icon {

    color:
      #4ade80;

    border-color:
      rgba(74, 222, 128, 0.18);

    background:
      rgba(74, 222, 128, 0.035);

  }


  .tech-badge-green
    .tech-badge-node {

    border-color:
      #4ade80;

    box-shadow:
      0 0 8px rgba(74, 222, 128, 0.35);

  }


  .tech-badge-green:hover {
    border-color:
      rgba(74, 222, 128, 0.3);

    background:
      rgba(74, 222, 128, 0.035);
  }


  /* ========================================================
     NEUTRAL
     ======================================================== */

  .tech-badge-neutral
    .tech-badge-icon {

    color:
      var(--color-text-muted);

    border-color:
      var(--color-border);

    background:
      rgba(148, 163, 184, 0.025);

  }


  .tech-badge-neutral
    .tech-badge-node {

    border-color:
      var(--color-text-subtle);

    box-shadow:
      none;

  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .tech-badge {

    background:
      rgba(15, 23, 42, 0.015);

  }


  :global([data-theme="light"])
    .tech-badge:hover {

    background:
      rgba(34, 211, 238, 0.025);

    box-shadow:
      0 8px 25px rgba(15, 23, 42, 0.06);

  }


  /* ========================================================
     ACCESSIBILITY
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .tech-badge,
    .tech-badge-icon,
    .tech-badge-label {
      transition:
        none;
    }

  }
</style>
