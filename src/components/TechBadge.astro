---
/**
 * ============================================================
 * TECH BADGE
 * ============================================================
 *
 * Small reusable technology / skill badge.
 *
 * Designed for:
 * - Skills
 * - Project technology stacks
 * - Experience technology stacks
 * - AI / RPA technologies
 * - Tools and platforms
 *
 * ============================================================
 */

interface Props {
  name: string;
  category?: string;
  icon?: string;
  accent?: "cyan" | "violet" | "blue" | "green";
  href?: string;
  size?: "small" | "normal" | "large";
}

const {
  name,
  category,
  icon = "◇",
  accent = "cyan",
  href,
  size = "normal"
} = Astro.props;

const Tag = href ? "a" : "span";
---

<Tag
  class:list={[
    "tech-badge",
    `tech-badge-${accent}`,
    `tech-badge-${size}`,
    {
      "tech-badge-link": Boolean(href)
    }
  ]}
  {...(href
    ? {
        href,
        target: "_blank",
        rel: "noopener noreferrer"
      }
    : {})}
>

  <!-- ======================================================
       NODE
       ====================================================== -->

  <span
    class="tech-node"
    aria-hidden="true"
  >

    <span class="tech-node-core">
      {icon}
    </span>

  </span>


  <!-- ======================================================
       CONTENT
       ====================================================== -->

  <span class="tech-content">

    <span class="tech-name">
      {name}
    </span>

    {
      category && (
        <span class="tech-category">
          {category}
        </span>
      )
    }

  </span>


  <!-- ======================================================
       SIGNAL
       ====================================================== -->

  <span
    class="tech-signal"
    aria-hidden="true"
  >
    <span></span>
  </span>

</Tag>


<style>
  /* ========================================================
     BASE
     ======================================================== */

  .tech-badge {
    position:
      relative;

    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.5rem;

    min-width:
      0;

    padding:
      0.45rem 0.6rem;

    border:
      1px solid var(--color-border);

    border-radius:
      0.3rem;

    color:
      var(--color-text-muted);

    background:
      rgba(148, 163, 184, 0.012);

    font-family:
      var(--font-mono);

    text-decoration:
      none;

    overflow:
      hidden;

    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }


  .tech-badge:hover {
    border-color:
      rgba(34, 211, 238, 0.25);

    color:
      var(--color-cyan);

    background:
      rgba(34, 211, 238, 0.025);

    transform:
      translateY(-1px);
  }


  /* ========================================================
     NODE
     ======================================================== */

  .tech-node {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      18px;

    height:
      18px;

    flex-shrink:
      0;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      50%;

    background:
      rgba(34, 211, 238, 0.025);

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }


  .tech-node-core {
    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    color:
      var(--color-cyan);

    font-size:
      0.45rem;

    line-height:
      1;
  }


  .tech-badge:hover
    .tech-node {

    border-color:
      rgba(34, 211, 238, 0.4);

    box-shadow:
      0 0 12px rgba(34, 211, 238, 0.08);

    transform:
      rotate(10deg);
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .tech-content {
    display:
      flex;

    min-width:
      0;

    flex-direction:
      column;

    gap:
      0.08rem;
  }


  .tech-name {
    overflow:
      hidden;

    color:
      inherit;

    font-size:
      0.4rem;

    line-height:
      1.2;

    letter-spacing:
      0.02em;

    text-overflow:
      ellipsis;

    white-space:
      nowrap;
  }


  .tech-category {
    color:
      var(--color-text-subtle);

    font-size:
      0.28rem;

    line-height:
      1.2;

    letter-spacing:
      0.025em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     SIGNAL
     ======================================================== */

  .tech-signal {
    position:
      relative;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      5px;

    height:
      5px;

    margin-left:
      0.1rem;

    border:
      1px solid rgba(34, 211, 238, 0.18);

    border-radius:
      50%;
  }


  .tech-signal span {
    width:
      2px;

    height:
      2px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 5px rgba(34, 211, 238, 0.6);

    animation:
      tech-signal-pulse 2s ease-in-out infinite;
  }


  @keyframes tech-signal-pulse {

    0%,
    100% {
      opacity:
        0.35;

      transform:
        scale(0.8);
    }

    50% {
      opacity:
        1;

      transform:
        scale(1.25);
    }

  }


  /* ========================================================
     SIZES
     ======================================================== */

  .tech-badge-small {
    gap:
      0.35rem;

    padding:
      0.3rem 0.4rem;
  }


  .tech-badge-small
    .tech-node {

    width:
      14px;

    height:
      14px;
  }


  .tech-badge-small
    .tech-node-core {

    font-size:
      0.34rem;
  }


  .tech-badge-small
    .tech-name {

    font-size:
      0.32rem;
  }


  .tech-badge-small
    .tech-category {

    display:
      none;
  }


  .tech-badge-large {
    gap:
      0.65rem;

    padding:
      0.6rem 0.75rem;
  }


  .tech-badge-large
    .tech-node {

    width:
      24px;

    height:
      24px;
  }


  .tech-badge-large
    .tech-node-core {

    font-size:
      0.55rem;
  }


  .tech-badge-large
    .tech-name {

    font-size:
      0.46rem;
  }


  .tech-badge-large
    .tech-category {

    font-size:
      0.3rem;
  }


  /* ========================================================
     VIOLET
     ======================================================== */

  .tech-badge-violet
    .tech-node {

    border-color:
      rgba(139, 92, 246, 0.2);

    background:
      rgba(139, 92, 246, 0.025);
  }


  .tech-badge-violet
    .tech-node-core {

    color:
      var(--color-violet);
  }


  .tech-badge-violet
    .tech-signal {

    border-color:
      rgba(139, 92, 246, 0.2);
  }


  .tech-badge-violet
    .tech-signal span {

    background:
      var(--color-violet);

    box-shadow:
      0 0 5px rgba(139, 92, 246, 0.6);
  }


  .tech-badge-violet:hover {
    border-color:
      rgba(139, 92, 246, 0.28);

    color:
      var(--color-violet);

    background:
      rgba(139, 92, 246, 0.025);
  }


  /* ========================================================
     BLUE
     ======================================================== */

  .tech-badge-blue
    .tech-node {

    border-color:
      rgba(59, 130, 246, 0.2);

    background:
      rgba(59, 130, 246, 0.025);
  }


  .tech-badge-blue
    .tech-node-core {

    color:
      var(--color-blue);
  }


  .tech-badge-blue
    .tech-signal {

    border-color:
      rgba(59, 130, 246, 0.2);
  }


  .tech-badge-blue
    .tech-signal span {

    background:
      var(--color-blue);

    box-shadow:
      0 0 5px rgba(59, 130, 246, 0.6);
  }


  .tech-badge-blue:hover {
    border-color:
      rgba(59, 130, 246, 0.28);

    color:
      var(--color-blue);

    background:
      rgba(59, 130, 246, 0.025);
  }


  /* ========================================================
     GREEN
     ======================================================== */

  .tech-badge-green
    .tech-node {

    border-color:
      rgba(74, 222, 128, 0.2);

    background:
      rgba(74, 222, 128, 0.025);
  }


  .tech-badge-green
    .tech-node-core {

    color:
      #4ade80;
  }


  .tech-badge-green
    .tech-signal {

    border-color:
      rgba(74, 222, 128, 0.2);
  }


  .tech-badge-green
    .tech-signal span {

    background:
      #4ade80;

    box-shadow:
      0 0 5px rgba(74, 222, 128, 0.6);
  }


  .tech-badge-green:hover {
    border-color:
      rgba(74, 222, 128, 0.28);

    color:
      #4ade80;

    background:
      rgba(74, 222, 128, 0.025);
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .tech-badge {

    background:
      rgba(15, 23, 42, 0.015);

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .tech-signal span,
    .tech-badge,
    .tech-node {
      animation:
        none;

      transition:
        none;
    }

  }
</style>
