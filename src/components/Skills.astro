---
/**
 * ============================================================
 * SKILLS / TECHNOLOGY MATRIX
 * ============================================================
 *
 * Presentation layer for the technical skills section.
 *
 * Content is controlled from:
 *
 *     src/data/skills.ts
 *
 * This component is responsible only for presentation.
 *
 * ============================================================
 */

import SectionHeader from "./SectionHeader.astro";

import {
  skillGroups
} from "../data/skills";


interface Props {
  groups?: typeof skillGroups;

  class?: string;
}


const {
  groups = skillGroups,

  class: className = ""
} = Astro.props;


/**
 * ============================================================
 * HELPERS
 * ============================================================
 */

const getGroupCode =
  (index: number): string =>
    `SYS-${String(index + 1).padStart(2, "0")}`;


const getSkillCount =
  (group: typeof skillGroups[number]): number =>
    group.skills.length;
---

<section
  id="skills"
  class:list={[
    "skills-section",
    className
  ]}
>

  <div class="skills-section__inner">

    <!-- ======================================================
         SECTION HEADER
         ====================================================== -->

    <SectionHeader
      number="04"
      eyebrow="CAPABILITIES"
      title="Tools, systems, and technologies."
      description="A practical technology stack focused on automation, software engineering, intelligent systems, integration, and reliable delivery."
    />


    <!-- ======================================================
         SKILL MATRIX
         ====================================================== -->

    <div class="skills-matrix">

      {
        groups.map(
          (group, index) => (

            <article
              class:list={[
                "skill-group",
                `skill-group-${(index % 4) + 1}`
              ]}
            >

              <!-- ============================================
                   GROUP HEADER
                   ============================================ -->

              <header class="skill-group__header">

                <div class="skill-group__meta">

                  <span class="skill-group__code">
                    {getGroupCode(index)}
                  </span>

                  <span class="skill-group__count">
                    {String(
                      getSkillCount(group)
                    ).padStart(2, "0")}
                    {" "}
                    SKILLS
                  </span>

                </div>


                <h3 class="skill-group__title">
                  {group.title}
                </h3>


                {
                  group.description && (
                    <p class="skill-group__description">
                      {group.description}
                    </p>
                  )
                }

              </header>


              <!-- ============================================
                   SKILL LIST
                   ============================================ -->

              <div class="skill-group__skills">

                {
                  group.skills.map(
                    (skill, skillIndex) => (

                      <div
                        class="skill-item"
                      >

                        <div class="skill-item__top">

                          <span class="skill-item__index">
                            {String(
                              skillIndex + 1
                            ).padStart(2, "0")}
                          </span>


                          <span class="skill-item__name">
                            {skill.name}
                          </span>


                          {
                            skill.level && (
                              <span class="skill-item__level">
                                {skill.level}
                              </span>
                            )
                          }

                        </div>


                        <div
                          class="skill-item__line"
                          aria-hidden="true"
                        >
                          <span></span>
                        </div>

                      </div>

                    )
                  )
                }

              </div>


              <!-- ============================================
                   GROUP FOOTER
                   ============================================ -->

              <footer class="skill-group__footer">

                <span>
                  CAPABILITY GROUP
                </span>

                <span>
                  {getGroupCode(index)}
                </span>

              </footer>

            </article>

          )
        )
      }

    </div>

  </div>

</section>


<style>

  /* ========================================================
     SECTION
     ======================================================== */

  .skills-section {
    padding:
      7rem 0 8rem;
  }


  .skills-section__inner {
    width:
      min(
        calc(100% - 2.5rem),
        var(--container-width)
      );

    margin-inline:
      auto;
  }


  /* ========================================================
     MATRIX
     ======================================================== */

  .skills-matrix {
    display:
      grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      1px;

    margin-top:
      4rem;

    border:
      1px solid var(--color-border);

    background:
      var(--color-border);
  }


  /* ========================================================
     GROUP
     ======================================================== */

  .skill-group {
    position:
      relative;

    min-width:
      0;

    padding:
      clamp(1.35rem, 3vw, 2rem);

    background:
      var(--color-surface);

    overflow:
      hidden;
  }


  .skill-group::before {
    content:
      "";

    position:
      absolute;

    top:
      0;

    left:
      0;

    width:
      3rem;

    height:
      1px;

    background:
      var(--color-cyan);

    opacity:
      0.7;
  }


  .skill-group-2::before {
    background:
      var(--color-violet);
  }


  .skill-group-3::before {
    background:
      var(--color-blue);
  }


  .skill-group-4::before {
    background:
      var(--color-green);
  }


  /* ========================================================
     GROUP HEADER
     ======================================================== */

  .skill-group__header {
    padding-bottom:
      1.35rem;

    border-bottom:
      1px solid var(--color-border);
  }


  .skill-group__meta {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    margin-bottom:
      0.85rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.42rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }


  .skill-group__code {
    color:
      var(--color-cyan);
  }


  .skill-group-2 .skill-group__code {
    color:
      var(--color-violet);
  }


  .skill-group-3 .skill-group__code {
    color:
      var(--color-blue);
  }


  .skill-group-4 .skill-group__code {
    color:
      var(--color-green);
  }


  .skill-group__count {
    color:
      var(--color-text-subtle);

    opacity:
      0.7;
  }


  .skill-group__title {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      clamp(
        1.2rem,
        2vw,
        1.6rem
      );

    font-weight:
      600;

    letter-spacing:
      -0.04em;

    line-height:
      1.1;
  }


  .skill-group__description {
    max-width:
      38rem;

    margin:
      0.7rem 0 0;

    color:
      var(--color-text-muted);

    font-family:
      var(--font-body);

    font-size:
      0.78rem;

    line-height:
      1.65;
  }


  /* ========================================================
     SKILL LIST
     ======================================================== */

  .skill-group__skills {
    display:
      flex;

    flex-direction:
      column;
  }


  .skill-item {
    padding:
      0.9rem 0;

    border-bottom:
      1px solid var(--color-border);
  }


  .skill-item:last-child {
    border-bottom:
      none;
  }


  .skill-item__top {
    display:
      grid;

    grid-template-columns:
      1.8rem minmax(0, 1fr) auto;

    align-items:
      center;

    gap:
      0.65rem;
  }


  .skill-item__index {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    opacity:
      0.65;
  }


  .skill-item__name {
    min-width:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-body);

    font-size:
      0.78rem;

    font-weight:
      600;

    line-height:
      1.35;
  }


  .skill-item__level {
    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.38rem;

    font-weight:
      700;

    letter-spacing:
      0.06em;

    text-transform:
      uppercase;
  }


  .skill-group-2 .skill-item__level {
    color:
      var(--color-violet);
  }


  .skill-group-3 .skill-item__level {
    color:
      var(--color-blue);
  }


  .skill-group-4 .skill-item__level {
    color:
      var(--color-green);
  }


  /* ========================================================
     SKILL LINE
     ======================================================== */

  .skill-item__line {
    position:
      relative;

    height:
      1px;

    margin:
      0.55rem 0 0 2.45rem;

    background:
      rgba(148, 163, 184, 0.08);

    overflow:
      hidden;
  }


  .skill-item__line span {
    display:
      block;

    width:
      32%;

    height:
      100%;

    background:
      linear-gradient(
        90deg,
        var(--color-cyan),
        transparent
      );

    opacity:
      0.55;
  }


  .skill-item:nth-child(2)
    .skill-item__line span {
    width:
      48%;
  }


  .skill-item:nth-child(3)
    .skill-item__line span {
    width:
      64%;
  }


  .skill-item:nth-child(4)
    .skill-item__line span {
    width:
      78%;
  }


  /* ========================================================
     FOOTER
     ======================================================== */

  .skill-group__footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    gap:
      1rem;

    padding-top:
      1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.37rem;

    font-weight:
      700;

    letter-spacing:
      0.08em;

    text-transform:
      uppercase;
  }


  /* ========================================================
     LIGHT THEME
     ======================================================== */

  :global([data-theme="light"])
    .skill-group {
    background:
      rgba(255, 255, 255, 0.7);
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 800px) {

    .skills-section {
      padding:
        5rem 0 6rem;
    }


    .skills-matrix {
      grid-template-columns:
        1fr;

      margin-top:
        3rem;
    }

  }


  @media (max-width: 640px) {

    .skills-section__inner {
      width:
        min(
          calc(100% - 2rem),
          var(--container-width)
        );
    }


    .skill-group {
      padding:
        1.25rem;
    }


    .skill-item__top {
      grid-template-columns:
        1.6rem minmax(0, 1fr);

      gap:
        0.55rem;
    }


    .skill-item__level {
      grid-column:
        2;

      margin-top:
        -0.2rem;
    }


    .skill-item__line {
      margin-left:
        2.15rem;
    }

  }


  /* ========================================================
     REDUCED MOTION
     ======================================================== */

  @media (prefers-reduced-motion: reduce) {

    .skill-item__line span {
      transition:
        none;
    }

  }

</style>
