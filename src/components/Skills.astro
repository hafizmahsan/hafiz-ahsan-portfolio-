---
/**
 * ============================================================
 * SKILLS / TECHNOLOGY MATRIX
 * ============================================================
 *
 * Presentation layer for the technical skills section.
 *
 * Skill content is maintained separately in:
 *
 *     src/data/skills.ts
 *
 * This component should generally not need to be edited when
 * adding or removing technologies.
 * ============================================================
 */

import SectionHeading from "./SectionHeading.astro";
import { skillGroups } from "../data/skills";
---

<section
  id="skills"
  class="skills-section section"
  aria-labelledby="skills-title"
>
  <!-- ======================================================
       BACKGROUND
       ====================================================== -->

  <div
    class="skills-background"
    aria-hidden="true"
  >
    <div class="skills-grid"></div>

    <div class="skills-glow skills-glow-one"></div>
    <div class="skills-glow skills-glow-two"></div>

    <div class="skills-network">

      <span class="network-node node-one"></span>
      <span class="network-node node-two"></span>
      <span class="network-node node-three"></span>
      <span class="network-node node-four"></span>
      <span class="network-node node-five"></span>

      <span class="network-line line-one"></span>
      <span class="network-line line-two"></span>
      <span class="network-line line-three"></span>
      <span class="network-line line-four"></span>

    </div>
  </div>


  <div class="container">

    <SectionHeading
      eyebrow="06 / Skills"
      title="A technology stack built around automation."
      description="A practical combination of RPA, enterprise integration, software engineering and emerging Generative AI capabilities."
    />


    <!-- ====================================================
         SKILL MATRIX
         ==================================================== -->

    <div class="skills-layout">

      <!-- ==============================================
           LEFT: SYSTEM MAP
           ============================================== -->

      <div class="skills-system">

        <div class="system-header">

          <span class="system-label">
            TECHNOLOGY MAP
          </span>

          <span class="system-status">
            <span></span>
            ACTIVE
          </span>

        </div>


        <div class="system-map">

          <div class="map-rings">
            <div></div>
            <div></div>
            <div></div>
          </div>


          <div class="map-lines">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>


          <!-- Core node -->

          <div class="core-node">

            <div class="core-node-ring"></div>

            <div class="core-node-inner">
              <span>RPA</span>
              <small>CORE</small>
            </div>

          </div>


          <!-- Satellite nodes -->

          {
            skillGroups.slice(0, 5).map((group, index) => (
              <div
                class:list={[
                  "satellite-node",
                  `satellite-${index + 1}`,
                ]}
              >
                <span class="satellite-dot"></span>
                <span>{group.shortName ?? group.title}</span>
              </div>
            ))
          }

        </div>


        <div class="system-footer">

          <span>
            ENTERPRISE AUTOMATION
          </span>

          <span>
            SYS / 06
          </span>

        </div>

      </div>


      <!-- ==============================================
           RIGHT: SKILL GROUPS
           ============================================== -->

      <div class="skill-groups">

        {
          skillGroups.map((group, index) => (
            <article class="skill-group">

              <div class="skill-group-header">

                <div class="skill-group-number">
                  {String(index + 1).padStart(2, "0")}
                </div>


                <div>

                  <span class="skill-group-code">
                    {group.code ?? `SYS-${String(index + 1).padStart(2, "0")}`}
                  </span>

                  <h3>
                    {group.title}
                  </h3>

                </div>

              </div>


              {
                group.description && (
                  <p class="skill-group-description">
                    {group.description}
                  </p>
                )
              }


              <div class="skill-items">

                {
                  group.skills.map((skill) => (
                    <div class="skill-item">

                      <span
                        class="skill-indicator"
                        aria-hidden="true"
                      ></span>

                      <span class="skill-name">
                        {skill.name}
                      </span>

                      {
                        skill.level && (
                          <span class="skill-level">
                            {skill.level}
                          </span>
                        )
                      }

                    </div>
                  ))
                }

              </div>

            </article>
          ))
        }

      </div>

    </div>


    <!-- ====================================================
         AI FOCUS
         ==================================================== -->

    <div class="ai-focus">

      <div class="ai-focus-visual" aria-hidden="true">

        <div class="ai-orbit ai-orbit-one"></div>
        <div class="ai-orbit ai-orbit-two"></div>

        <div class="ai-core">
          <span></span>
        </div>

      </div>


      <div class="ai-focus-content">

        <span class="ai-eyebrow">
          CURRENT LEARNING VECTOR
        </span>

        <h3>
          Exploring the convergence of RPA &amp; Generative AI.
        </h3>

        <p>
          Currently expanding into LangChain, LLM-based applications,
          AI agents and intelligent automation patterns to complement
          traditional enterprise RPA.
        </p>

        <div class="ai-tags">
          <span>GenAI</span>
          <span>LLMs</span>
          <span>LangChain</span>
          <span>AI Agents</span>
          <span>Intelligent Automation</span>
        </div>

      </div>

    </div>

  </div>
</section>


<style>
  /* ========================================================
     SECTION
     ======================================================== */

  .skills-section {
    position:
      relative;

    overflow:
      hidden;
  }


  .skills-background {
    position:
      absolute;

    inset:
      0;

    z-index:
      -1;

    pointer-events:
      none;
  }


  .skills-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.18;

    background-image:
      linear-gradient(
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(148, 163, 184, 0.025) 1px,
        transparent 1px
      );

    background-size:
      70px 70px;

    mask-image:
      linear-gradient(
        to bottom,
        transparent,
        black 15%,
        black 85%,
        transparent
      );
  }


  .skills-glow {
    position:
      absolute;

    width:
      30rem;

    height:
      30rem;

    border-radius:
      50%;

    filter:
      blur(150px);
  }


  .skills-glow-one {
    top:
      10%;

    left:
      -18%;

    background:
      rgba(34, 211, 238, 0.03);
  }


  .skills-glow-two {
    right:
      -18%;

    bottom:
      10%;

    background:
      rgba(139, 92, 246, 0.03);
  }


  /* ========================================================
     NETWORK
     ======================================================== */

  .skills-network {
    position:
      absolute;

    top:
      10%;

    right:
      7%;

    width:
      200px;

    height:
      200px;

    opacity:
      0.3;
  }


  .network-node {
    position:
      absolute;

    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 10px var(--color-cyan);

    animation:
      node-float 5s ease-in-out infinite;
  }


  .node-one {
    top:
      15%;

    left:
      20%;
  }


  .node-two {
    top:
      45%;

    left:
      55%;

    animation-delay:
      -1s;
  }


  .node-three {
    top:
      70%;

    left:
      20%;

    background:
      var(--color-violet);

    box-shadow:
      0 0 10px var(--color-violet);

    animation-delay:
      -2s;
  }


  .node-four {
    top:
      25%;

    right:
      10%;

    background:
      var(--color-blue);

    box-shadow:
      0 0 10px var(--color-blue);

    animation-delay:
      -3s;
  }


  .node-five {
    right:
      20%;

    bottom:
      10%;

    animation-delay:
      -4s;
  }


  .network-line {
    position:
      absolute;

    height:
      1px;

    width:
      70px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.2),
        transparent
      );

    transform-origin:
      left center;
  }


  .line-one {
    top:
      20%;

    left:
      22%;

    transform:
      rotate(28deg);
  }


  .line-two {
    top:
      47%;

    left:
      25%;

    transform:
      rotate(-18deg);
  }


  .line-three {
    top:
      48%;

    left:
      55%;

    transform:
      rotate(-38deg);
  }


  .line-four {
    top:
      70%;

    left:
      22%;

    transform:
      rotate(18deg);
  }


  @keyframes node-float {
    0%,
    100% {
      transform:
        translate(0, 0);

      opacity:
        0.4;
    }

    50% {
      transform:
        translate(5px, -7px);

      opacity:
        1;
    }
  }


  /* ========================================================
     LAYOUT
     ======================================================== */

  .skills-layout {
    display:
      grid;

    grid-template-columns:
      minmax(320px, 0.9fr)
      minmax(0, 1.1fr);

    gap:
      1rem;

    align-items:
      stretch;
  }


  /* ========================================================
     SYSTEM MAP
     ======================================================== */

  .skills-system {
    display:
      flex;

    flex-direction:
      column;

    min-height:
      600px;

    overflow:
      hidden;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(148, 163, 184, 0.012);
  }


  .system-header,
  .system-footer {
    display:
      flex;

    align-items:
      center;

    justify-content:
      space-between;

    padding:
      0.8rem 1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.45rem;

    letter-spacing:
      0.06em;
  }


  .system-header {
    border-bottom:
      1px solid var(--color-border);
  }


  .system-footer {
    margin-top:
      auto;

    border-top:
      1px solid var(--color-border);
  }


  .system-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.35rem;

    color:
      var(--color-cyan);
  }


  .system-status span {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 7px var(--color-cyan);
  }


  .system-map {
    position:
      relative;

    flex:
      1;

    min-height:
      500px;

    overflow:
      hidden;

    background:
      radial-gradient(
        circle at center,
        rgba(34, 211, 238, 0.035),
        transparent 48%
      );
  }


  /* ========================================================
     MAP RINGS
     ======================================================== */

  .map-rings {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    width:
      330px;

    height:
      330px;

    transform:
      translate(-50%, -50%);
  }


  .map-rings div {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    border:
      1px solid rgba(34, 211, 238, 0.08);

    border-radius:
      50%;

    transform:
      translate(-50%, -50%);
  }


  .map-rings div:nth-child(1) {
    width:
      100%;

    height:
      100%;

    animation:
      ring-pulse 7s ease-in-out infinite;
  }


  .map-rings div:nth-child(2) {
    width:
      68%;

    height:
      68%;

    border-color:
      rgba(59, 130, 246, 0.08);

    animation:
      ring-pulse 7s ease-in-out -2s infinite;
  }


  .map-rings div:nth-child(3) {
    width:
      36%;

    height:
      36%;

    border-color:
      rgba(139, 92, 246, 0.08);

    animation:
      ring-pulse 7s ease-in-out -4s infinite;
  }


  @keyframes ring-pulse {
    0%,
    100% {
      opacity:
        0.45;
    }

    50% {
      opacity:
        1;
    }
  }


  /* ========================================================
     MAP CONNECTIONS
     ======================================================== */

  .map-lines span {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    width:
      145px;

    height:
      1px;

    background:
      linear-gradient(
        90deg,
        rgba(34, 211, 238, 0.25),
        transparent
      );

    transform-origin:
      left center;
  }


  .map-lines span:nth-child(1) {
    transform:
      rotate(-35deg);
  }


  .map-lines span:nth-child(2) {
    transform:
      rotate(30deg);
  }


  .map-lines span:nth-child(3) {
    transform:
      rotate(145deg);
  }


  .map-lines span:nth-child(4) {
    transform:
      rotate(210deg);
  }


  /* ========================================================
     CORE NODE
     ======================================================== */

  .core-node {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    width:
      92px;

    height:
      92px;

    transform:
      translate(-50%, -50%);
  }


  .core-node-ring {
    position:
      absolute;

    inset:
      0;

    border:
      1px solid rgba(34, 211, 238, 0.25);

    border-radius:
      50%;

    animation:
      core-rotate 12s linear infinite;
  }


  .core-node-ring::before,
  .core-node-ring::after {
    content:
      "";

    position:
      absolute;

    width:
      5px;

    height:
      5px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 10px var(--color-cyan);
  }


  .core-node-ring::before {
    top:
      -3px;

    left:
      50%;

    transform:
      translateX(-50%);
  }


  .core-node-ring::after {
    right:
      -3px;

    top:
      50%;

    transform:
      translateY(-50%);
  }


  @keyframes core-rotate {
    to {
      transform:
        rotate(360deg);
    }
  }


  .core-node-inner {
    position:
      absolute;

    inset:
      15px;

    display:
      flex;

    flex-direction:
      column;

    align-items:
      center;

    justify-content:
      center;

    border:
      1px solid rgba(34, 211, 238, 0.15);

    border-radius:
      50%;

    background:
      rgba(5, 9, 15, 0.85);

    box-shadow:
      0 0 35px rgba(34, 211, 238, 0.07);
  }


  .core-node-inner span {
    color:
      var(--color-cyan);

    font-family:
      var(--font-display);

    font-size:
      0.7rem;

    font-weight:
      600;

    letter-spacing:
      0.05em;
  }


  .core-node-inner small {
    margin-top:
      0.1rem;

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.34rem;
  }


  /* ========================================================
     SATELLITE NODES
     ======================================================== */

  .satellite-node {
    position:
      absolute;

    display:
      flex;

    align-items:
      center;

    gap:
      0.35rem;

    padding:
      0.35rem 0.5rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-pill);

    background:
      rgba(5, 9, 15, 0.7);

    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    white-space:
      nowrap;

    transition:
      border-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }


  .satellite-node:hover {
    border-color:
      rgba(34, 211, 238, 0.2);

    color:
      var(--color-cyan);
  }


  .satellite-dot {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 7px var(--color-cyan);
  }


  .satellite-1 {
    top:
      25%;

    left:
      12%;
  }


  .satellite-2 {
    top:
      25%;

    right:
      10%;
  }


  .satellite-3 {
    right:
      7%;

    bottom:
      27%;
  }


  .satellite-4 {
    bottom:
      22%;

    left:
      9%;
  }


  .satellite-5 {
    top:
      47%;

    left:
      4%;
  }


  /* ========================================================
     SKILL GROUPS
     ======================================================== */

  .skill-groups {
    display:
      grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap:
      0.8rem;
  }


  .skill-group {
    padding:
      1rem;

    border:
      1px solid var(--color-border);

    border-radius:
      var(--radius-lg);

    background:
      rgba(148, 163, 184, 0.012);

    transition:
      border-color var(--duration-normal) var(--ease-standard),
      transform var(--duration-normal) var(--ease-standard);
  }


  .skill-group:hover {
    transform:
      translateY(-2px);

    border-color:
      rgba(34, 211, 238, 0.14);
  }


  .skill-group-header {
    display:
      grid;

    grid-template-columns:
      26px 1fr;

    gap:
      0.65rem;

    align-items:
      start;
  }


  .skill-group-number {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.43rem;
  }


  .skill-group-code {
    display:
      block;

    margin-bottom:
      0.2rem;

    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.4rem;

    letter-spacing:
      0.05em;
  }


  .skill-group h3 {
    margin:
      0;

    color:
      var(--color-text);

    font-family:
      var(--font-display);

    font-size:
      0.8rem;

    font-weight:
      500;

    letter-spacing:
      -0.025em;
  }


  .skill-group-description {
    margin:
      0.75rem 0 0;

    color:
      var(--color-text-subtle);

    font-size:
      0.54rem;

    line-height:
      1.6;
  }


  /* ========================================================
     SKILL ITEMS
     ======================================================== */

  .skill-items {
    display:
      flex;

    flex-direction:
      column;

    gap:
      0.35rem;

    margin-top:
      0.9rem;
  }


  .skill-item {
    display:
      grid;

    grid-template-columns:
      7px 1fr auto;

    gap:
      0.45rem;

    align-items:
      center;

    min-height:
      24px;

    padding:
      0.3rem 0.4rem;

    border:
      1px solid transparent;

    border-radius:
      0.25rem;

    transition:
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }


  .skill-item:hover {
    border-color:
      var(--color-border);

    background:
      rgba(148, 163, 184, 0.025);
  }


  .skill-indicator {
    width:
      4px;

    height:
      4px;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 6px rgba(34, 211, 238, 0.5);
  }


  .skill-name {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.48rem;
  }


  .skill-level {
    color:
      var(--color-text-subtle);

    font-family:
      var(--font-mono);

    font-size:
      0.37rem;

    text-transform:
      uppercase;
  }


  /* ========================================================
     AI FOCUS
     ======================================================== */

  .ai-focus {
    position:
      relative;

    display:
      grid;

    grid-template-columns:
      150px 1fr;

    gap:
      2rem;

    align-items:
      center;

    margin-top:
      1rem;

    padding:
      1.5rem;

    overflow:
      hidden;

    border:
      1px solid rgba(139, 92, 246, 0.12);

    border-radius:
      var(--radius-lg);

    background:
      linear-gradient(
        120deg,
        rgba(139, 92, 246, 0.025),
        rgba(34, 211, 238, 0.018)
      );
  }


  .ai-focus-visual {
    position:
      relative;

    width:
      120px;

    height:
      120px;

    margin:
      auto;
  }


  .ai-orbit {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    border:
      1px solid rgba(139, 92, 246, 0.18);

    border-radius:
      50%;

    transform:
      translate(-50%, -50%);
  }


  .ai-orbit-one {
    width:
      110px;

    height:
      55px;

    animation:
      ai-orbit 8s linear infinite;
  }


  .ai-orbit-two {
    width:
      55px;

    height:
      110px;

    transform:
      translate(-50%, -50%)
      rotate(60deg);

    animation:
      ai-orbit-reverse 11s linear infinite;
  }


  @keyframes ai-orbit {
    to {
      transform:
        translate(-50%, -50%)
        rotate(360deg);
    }
  }


  @keyframes ai-orbit-reverse {
    to {
      transform:
        translate(-50%, -50%)
        rotate(-300deg);
    }
  }


  .ai-core {
    position:
      absolute;

    top:
      50%;

    left:
      50%;

    display:
      flex;

    align-items:
      center;

    justify-content:
      center;

    width:
      38px;

    height:
      38px;

    border:
      1px solid rgba(139, 92, 246, 0.3);

    border-radius:
      50%;

    background:
      rgba(5, 9, 15, 0.85);

    transform:
      translate(-50%, -50%);
  }


  .ai-core span {
    width:
      8px;

    height:
      8px;

    border-radius:
      50%;

    background:
      linear-gradient(
        135deg,
        var(--color-violet),
        var(--color-cyan)
      );

    box-shadow:
      0 0 18px rgba(139, 92, 246, 0.5);

    animation:
      ai-pulse 2.5s ease-in-out infinite;
  }


  @keyframes ai-pulse {
    0%,
    100% {
      transform:
        scale(0.8);
    }

    50% {
      transform:
        scale(1.35);
    }
  }


  .ai-eyebrow {
    color:
      var(--color-violet);

    font-family:
