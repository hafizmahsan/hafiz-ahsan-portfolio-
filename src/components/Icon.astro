---
/**
 * ============================================================
 * ICON
 * ============================================================
 *
 * Small dependency-free SVG icon system.
 *
 * ============================================================
 */

type IconName =
  | "arrow-right"
  | "arrow-up-right"
  | "arrow-down"
  | "arrow-left"
  | "external"
  | "github"
  | "linkedin"
  | "mail"
  | "download"
  | "menu"
  | "close"
  | "check"
  | "plus"
  | "minus"
  | "location"
  | "calendar"
  | "terminal"
  | "code"
  | "globe"
  | "file"
  | "chevron-down"
  | "chevron-right"
  | "spark"
  | "circle";

interface Props {
  name: IconName;

  size?: number;

  strokeWidth?: number;

  label?: string;

  class?: string;
}

const {
  name,
  size = 18,
  strokeWidth = 1.7,
  label,
  class: className = ""
} = Astro.props;

const decorative =
  !label;
---

<span
  class:list={[
    "icon",
    className
  ]}
  aria-hidden={
    decorative
      ? "true"
      : undefined
  }
  aria-label={
    label
  }
>
  <svg
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    focusable="false"
  >

    {
      name === "arrow-right" && (
        <>
          <path d="M4 12h15" />
          <path d="m13 6 6 6-6 6" />
        </>
      )
    }


    {
      name === "arrow-up-right" && (
        <>
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </>
      )
    }


    {
      name === "arrow-down" && (
        <>
          <path d="M12 4v15" />
          <path d="m6 13 6 6 6-6" />
        </>
      )
    }


    {
      name === "arrow-left" && (
        <>
          <path d="M20 12H5" />
          <path d="m11 6-6 6 6 6" />
        </>
      )
    }


    {
      name === "external" && (
        <>
          <path d="M14 5h5v5" />
          <path d="M19 5 10 14" />
          <path d="M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
        </>
      )
    }


    {
      name === "github" && (
        <path
          d="M15 22v-3.9c.05-1.25-.42-2.2-1.3-2.7 4.3-.48 8.8-2.1 8.8-9.5 0-1.87-.66-3.4-1.75-4.6.18-.45.76-2.3-.18-4.55 0 0-1.43-.46-4.7 1.76A16.3 16.3 0 0 0 12 8c-1.45-.02-2.9.03-4.05.36C4.68 1.54 3.25 2 3.25 2c-.94 2.25-.36 4.1-.18 4.55A6.6 6.6 0 0 0 1.32 10.9c0 7.4 4.5 9.02 8.8 9.5-.55.34-.98.94-1.14 1.82V22"
        />
      )
    }


    {
      name === "linkedin" && (
        <>
          <rect
            x="4"
            y="4"
            width="16"
            height="16"
            rx="2"
          />
          <path d="M8 10v6" />
          <path d="M8 7.5v.01" />
          <path d="M12 16v-3.3a2.7 2.7 0 0 1 5.4 0V16" />
          <path d="M12 10v6" />
        </>
      )
    }


    {
      name === "mail" && (
        <>
          <rect
            x="3"
            y="5"
            width="18"
            height="14"
            rx="2"
          />
          <path d="m4 7 8 6 8-6" />
        </>
      )
    }


    {
      name === "download" && (
        <>
          <path d="M12 3v12" />
          <path d="m7 10 5 5 5-5" />
          <path d="M5 21h14" />
        </>
      )
    }


    {
      name === "menu" && (
        <>
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </>
      )
    }


    {
      name === "close" && (
        <>
          <path d="m6 6 12 12" />
          <path d="m18 6-12 12" />
        </>
      )
    }


    {
      name === "check" && (
        <path d="m5 12 4 4L19 6" />
      )
    }


    {
      name === "plus" && (
        <>
          <path d="M12 5v14" />
          <path d="M5 12h14" />
        </>
      )
    }


    {
      name === "minus" && (
        <path d="M5 12h14" />
      )
    }


    {
      name === "location" && (
        <>
          <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
          <circle cx="12" cy="10" r="2.5" />
        </>
      )
    }


    {
      name === "calendar" && (
        <>
          <rect
            x="4"
            y="5"
            width="16"
            height="15"
            rx="2"
          />
          <path d="M8 3v4" />
          <path d="M16 3v4" />
          <path d="M4 10h16" />
        </>
      )
    }


    {
      name === "terminal" && (
        <>
          <rect
            x="3"
            y="4"
            width="18"
            height="16"
            rx="2"
          />
          <path d="m7 9 3 3-3 3" />
          <path d="M13 15h4" />
        </>
      )
    }


    {
      name === "code" && (
        <>
          <path d="m8 9-4 3 4 3" />
          <path d="m16 9 4 3-4 3" />
          <path d="m14 5-4 14" />
        </>
      )
    }


    {
      name === "globe" && (
        <>
          <circle
            cx="12"
            cy="12"
            r="9"
          />
          <path d="M3 12h18" />
          <path d="M12 3a14 14 0 0 1 0 18" />
          <path d="M12 3a14 14 0 0 0 0 18" />
        </>
      )
    }


    {
      name === "file" && (
        <>
          <path d="M6 3h8l4 4v14H6z" />
          <path d="M14 3v5h5" />
          <path d="M9 13h6" />
          <path d="M9 17h6" />
        </>
      )
    }


    {
      name === "chevron-down" && (
        <path d="m6 9 6 6 6-6" />
      )
    }


    {
      name === "chevron-right" && (
        <path d="m9 6 6 6-6 6" />
      )
    }


    {
      name === "spark" && (
        <>
          <path d="m12 3 1.2 5.8L19 10l-5.8 1.2L12 17l-1.2-5.8L5 10l5.8-1.2Z" />
          <path d="m19 15 .6 2.4L22 18l-2.4.6L19 21l-.6-2.4L16 18l2.4-.6Z" />
        </>
      )
    }


    {
      name === "circle" && (
        <circle
          cx="12"
          cy="12"
          r="8"
        />
      )
    }

  </svg>
</span>


<style>
  .icon {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    flex: 0 0 auto;

    line-height: 0;
  }


  .icon svg {
    display: block;

    width: auto;
    height: auto;
  }
</style>
