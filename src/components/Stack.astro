---
/**
 * ============================================================
 * STACK
 * ============================================================
 *
 * Reusable vertical layout primitive.
 *
 * Controls spacing between direct children without requiring
 * individual margin rules on every child.
 *
 * ============================================================
 */

interface Props {
  gap?:
    | "xs"
    | "sm"
    | "md"
    | "lg"
    | "xl";

  align?:
    | "start"
    | "center"
    | "end"
    | "stretch";

  class?: string;
}

const {
  gap = "md",
  align = "stretch",
  class: className = ""
} = Astro.props;
---

<div
  class:list={[
    "stack",
    `stack--gap-${gap}`,
    `stack--align-${align}`,
    className
  ]}
>
  <slot />
</div>


<style>
  .stack {
    display: flex;

    flex-direction: column;
  }


  /* ========================================================
     GAPS
     ======================================================== */

  .stack--gap-xs {
    gap: 0.5rem;
  }


  .stack--gap-sm {
    gap: 0.75rem;
  }


  .stack--gap-md {
    gap: 1.25rem;
  }


  .stack--gap-lg {
    gap: 2rem;
  }


  .stack--gap-xl {
    gap: 3rem;
  }


  /* ========================================================
     ALIGNMENT
     ======================================================== */

  .stack--align-start {
    align-items: flex-start;
  }


  .stack--align-center {
    align-items: center;
  }


  .stack--align-end {
    align-items: flex-end;
  }


  .stack--align-stretch {
    align-items: stretch;
  }
</style>
