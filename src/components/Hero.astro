---
/**
 * ============================================================
 * HERO SECTION
 * ============================================================
 *
 * Main visual introduction to the portfolio.
 *
 * The hero deliberately combines:
 *
 * - Professional positioning
 * - Technology/automation visual language
 * - Animated nodes
 * - Connection lines
 * - Metrics
 * - Clear calls-to-action
 *
 * The 3D engine will be introduced separately later.
 * This component already provides the visual foundation
 * around which the future 3D scene can be placed.
 * ============================================================
 */

import { siteConfig } from "../data/site";
import { profile } from "../data/profile";
---

<section
  id="home"
  class="hero"
  aria-labelledby="hero-title"
>
  <!-- ======================================================
       BACKGROUND TECHNOLOGY LAYER
       ====================================================== -->

  <div
    class="hero-background"
    aria-hidden="true"
  >
    <div class="hero-grid tech-grid"></div>

    <div class="hero-glow hero-glow-one"></div>
    <div class="hero-glow hero-glow-two"></div>
    <div class="hero-glow hero-glow-three"></div>

    <div class="network">
      <span class="network-node node-one"></span>
      <span class="network-node node-two"></span>
      <span class="network-node node-three"></span>
      <span class="network-node node-four"></span>
      <span class="network-node node-five"></span>
      <span class="network-node node-six"></span>

      <span class="network-line line-one"></span>
      <span class="network-line line-two"></span>
      <span class="network-line line-three"></span>
      <span class="network-line line-four"></span>
      <span class="network-line line-five"></span>
    </div>
  </div>


  <!-- ======================================================
       MAIN HERO CONTENT
       ====================================================== -->

  <div class="container hero-container">

    <div class="hero-content">

      <!-- Professional status -->

      <div class="hero-status">
        <span
          class="status-indicator"
          aria-hidden="true"
        ></span>

        <span>
          Senior RPA Consultant · Automation · AI
        </span>
      </div>


      <!-- Main heading -->

      <h1
        id="hero-title"
        class="hero-title"
      >
        Engineering
        <span class="hero-title-gradient">
          intelligent
        </span>
        automation systems.
      </h1>


      <!-- Introduction -->

      <p class="hero-description">
        {profile.shortBio}
      </p>


      <!-- CTAs -->

      <div class="hero-actions">

        <a
          href="#projects"
          class="button button-primary hero-primary-button"
        >
          <span>
            Explore my work
          </span>

          <span
            class="button-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>

        <a
          href="#contact"
          class="button"
        >
          Let's connect
        </a>

      </div>


      <!-- Technical positioning -->

      <div class="hero-tags">
        <span class="badge badge-cyan">
          RPA
        </span>

        <span class="badge">
          Solution Architecture
        </span>

        <span class="badge">
          Process Automation
        </span>

        <span class="badge badge-violet">
          GenAI / LangChain
        </span>
      </div>

    </div>


    <!-- ====================================================
         HERO VISUAL
         ==================================================== -->

    <div
      class="hero-visual"
      aria-hidden="true"
    >

      <div class="visual-orbit orbit-one"></div>
      <div class="visual-orbit orbit-two"></div>
      <div class="visual-orbit orbit-three"></div>


      <!-- Central automation core -->

      <div class="automation-core">

        <div class="core-ring core-ring-one"></div>
        <div class="core-ring core-ring-two"></div>
        <div class="core-ring core-ring-three"></div>

        <div class="core-inner">
          <div class="core-symbol">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <div class="core-label">
            AUTOMATION
          </div>
        </div>

      </div>


      <!-- Floating technology nodes -->

      <div class="floating-node floating-node-one">
        <span class="floating-icon">RPA</span>
      </div>

      <div class="floating-node floating-node-two">
        <span class="floating-icon">AI</span>
      </div>

      <div class="floating-node floating-node-three">
        <span class="floating-icon">API</span>
      </div>

      <div class="floating-node floating-node-four">
        <span class="floating-icon">BOT</span>
      </div>


      <!-- Data particles -->

      <span class="particle particle-one"></span>
      <span class="particle particle-two"></span>
      <span class="particle particle-three"></span>
      <span class="particle particle-four"></span>
      <span class="particle particle-five"></span>
      <span class="particle particle-six"></span>
      <span class="particle particle-seven"></span>
      <span class="particle particle-eight"></span>

    </div>

  </div>


  <!-- ======================================================
       EXPERIENCE METRICS
       ====================================================== -->

  <div class="container hero-metrics">

    <div class="metric">

      <span class="metric-value">
        6+
      </span>

      <span class="metric-label">
        Years in IT
      </span>

    </div>


    <div class="metric-divider"></div>


    <div class="metric">

      <span class="metric-value">
        RPA
      </span>

      <span class="metric-label">
        Automation expertise
      </span>

    </div>


    <div class="metric-divider"></div>


    <div class="metric">

      <span class="metric-value">
        AI
      </span>

      <span class="metric-label">
        Next-generation focus
      </span>

    </div>


    <div class="metric-divider"></div>


    <div class="metric">

      <span class="metric-value">
        KSA
      </span>

      <span class="metric-label">
        Riyadh / Saudi Arabia
      </span>

    </div>

  </div>


  <!-- ======================================================
       SCROLL INDICATOR
       ====================================================== -->

  <a
    href="#about"
    class="scroll-indicator"
    aria-label="Scroll to about section"
  >
    <span class="scroll-line"></span>

    <span class="scroll-text">
      SCROLL TO EXPLORE
    </span>
  </a>

</section>


<style>
  /* ========================================================
     HERO FOUNDATION
     ======================================================== */

  .hero {
    position:
      relative;

    min-height:
      100svh;

    display:
      flex;

    flex-direction:
      column;

    justify-content:
      center;

    overflow:
      hidden;

    isolation:
      isolate;

    padding:
      9rem 0 5rem;
  }


  .hero-background {
    position:
      absolute;

    inset:
      0;

    z-index:
      -2;

    pointer-events:
      none;
  }


  .hero-grid {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.55;
  }


  .hero-glow {
    position:
      absolute;

    border-radius:
      50%;

    filter:
      blur(80px);

    pointer-events:
      none;
  }


  .hero-glow-one {
    top:
      15%;

    right:
      8%;

    width:
      28rem;

    height:
      28rem;

    background:
      rgba(34, 211, 238, 0.08);

    animation:
      glow-drift-one 12s ease-in-out infinite;
  }


  .hero-glow-two {
    bottom:
      5%;

    left:
      18%;

    width:
      32rem;

    height:
      32rem;

    background:
      rgba(59, 130, 246, 0.07);

    animation:
      glow-drift-two 15s ease-in-out infinite;
  }


  .hero-glow-three {
    top:
      35%;

    left:
      42%;

    width:
      18rem;

    height:
      18rem;

    background:
      rgba(139, 92, 246, 0.07);

    animation:
      glow-drift-three 10s ease-in-out infinite;
  }


  @keyframes glow-drift-one {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0);
    }

    50% {
      transform:
        translate3d(-3rem, 2rem, 0);
    }
  }


  @keyframes glow-drift-two {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0);
    }

    50% {
      transform:
        translate3d(3rem, -2rem, 0);
    }
  }


  @keyframes glow-drift-three {
    0%,
    100% {
      transform:
        scale(1);
    }

    50% {
      transform:
        scale(1.25);
    }
  }


  /* ========================================================
     BACKGROUND NETWORK
     ======================================================== */

  .network {
    position:
      absolute;

    inset:
      0;

    opacity:
      0.7;
  }


  .network-node {
    position:
      absolute;

    width:
      0.35rem;

    height:
      0.35rem;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 15px rgba(34, 211, 238, 0.75);

    animation:
      network-pulse 3.5s ease-in-out infinite;
  }


  .node-one {
    top:
      18%;

    left:
      11%;
  }


  .node-two {
    top:
      32%;

    left:
      24%;

    animation-delay:
      -1s;
  }


  .node-three {
    top:
      20%;

    right:
      22%;

    animation-delay:
      -2s;
  }


  .node-four {
    top:
      58%;

    right:
      11%;

    background:
      var(--color-violet);

    box-shadow:
      0 0 15px rgba(139, 92, 246, 0.75);

    animation-delay:
      -1.5s;
  }


  .node-five {
    bottom:
      19%;

    left:
      17%;

    background:
      var(--color-blue);

    box-shadow:
      0 0 15px rgba(59, 130, 246, 0.75);

    animation-delay:
      -2.5s;
  }


  .node-six {
    bottom:
      12%;

    right:
      29%;

    animation-delay:
      -0.5s;
  }


  @keyframes network-pulse {
    0%,
    100% {
      transform:
        scale(0.7);

      opacity:
        0.35;
    }

    50% {
      transform:
        scale(1.5);

      opacity:
        1;
    }
  }


  .network-line {
    position:
      absolute;

    height:
      1px;

    transform-origin:
      left center;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(34, 211, 238, 0.4),
        rgba(139, 92, 246, 0.25),
        transparent
      );

    animation:
      network-flow 5s ease-in-out infinite;
  }


  .line-one {
    top:
      21%;

    left:
      11%;

    width:
      17%;

    transform:
      rotate(21deg);
  }


  .line-two {
    top:
      32%;

    left:
      24%;

    width:
      22%;

    transform:
      rotate(-14deg);

    animation-delay:
      -2s;
  }


  .line-three {
    top:
      21%;

    right:
      21%;

    width:
      20%;

    transform:
      rotate(28deg);

    animation-delay:
      -1s;
  }


  .line-four {
    top:
      58%;

    right:
      11%;

    width:
      23%;

    transform:
      rotate(-18deg);

    animation-delay:
      -3s;
  }


  .line-five {
    bottom:
      19%;

    left:
      17%;

    width:
      24%;

    transform:
      rotate(-15deg);

    animation-delay:
      -1.5s;
  }


  @keyframes network-flow {
    0%,
    100% {
      opacity:
        0.15;
    }

    50% {
      opacity:
        0.55;
    }
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .hero-container {
    position:
      relative;

    z-index:
      2;

    display:
      grid;

    grid-template-columns:
      minmax(0, 1.05fr)
      minmax(360px, 0.95fr);

    align-items:
      center;

    gap:
      clamp(2rem, 6vw, 6rem);

    flex:
      1;
  }


  .hero-content {
    max-width:
      760px;
  }


  .hero-status {
    display:
      inline-flex;

    align-items:
      center;

    gap:
      0.6rem;

    margin-bottom:
      1.5rem;

    padding:
      0.45rem 0.75rem;

    border:
      1px solid rgba(34, 211, 238, 0.16);

    border-radius:
      var(--radius-pill);

    background:
      rgba(34, 211, 238, 0.045);

    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.66rem;

    letter-spacing:
      0.04em;
  }


  .status-indicator {
    width:
      0.4rem;

    height:
      0.4rem;

    border-radius:
      50%;

    background:
      var(--color-green);

    box-shadow:
      0 0 12px rgba(34, 197, 94, 0.65);

    animation:
      status-blink 2s ease-in-out infinite;
  }


  @keyframes status-blink {
    0%,
    100% {
      opacity:
        0.45;
    }

    50% {
      opacity:
        1;
    }
  }


  .hero-title {
    max-width:
      850px;

    margin-bottom:
      1.75rem;

    font-size:
      clamp(3.2rem, 7.2vw, 6.8rem);

    font-weight:
      600;

    letter-spacing:
      -0.055em;

    line-height:
      0.98;
  }


  .hero-title-gradient {
    display:
      inline-block;

    color:
      transparent;

    background:
      var(--gradient-brand);

    background-clip:
      text;

    -webkit-background-clip:
      text;

    filter:
      drop-shadow(
        0 0 24px
        rgba(34, 211, 238, 0.12)
      );
  }


  .hero-description {
    max-width:
      680px;

    margin-bottom:
      2rem;

    color:
      var(--color-text-secondary);

    font-size:
      clamp(1rem, 1.6vw, 1.15rem);

    line-height:
      1.8;
  }


  .hero-actions {
    display:
      flex;

    align-items:
      center;

    flex-wrap:
      wrap;

    gap:
      0.75rem;

    margin-bottom:
      1.75rem;
  }


  .hero-primary-button {
    padding-inline:
      1.25rem;
  }


  .button-arrow {
    transition:
      transform var(--duration-normal) var(--ease-standard);
  }


  .hero-primary-button:hover .button-arrow {
    transform:
      translateX(0.25rem);
  }


  .hero-tags {
    display:
      flex;

    flex-wrap:
      wrap;

    gap:
      0.5rem;
  }


  /* ========================================================
     HERO VISUAL
     ======================================================== */

  .hero-visual {
    position:
      relative;

    width:
      min(
        100%,
        600px
      );

    aspect-ratio:
      1;

    margin-inline:
      auto;

    display:
      grid;

    place-items:
      center;

    perspective:
      1000px;
  }


  .visual-orbit {
    position:
      absolute;

    border:
      1px solid rgba(148, 163, 184, 0.12);

    border-radius:
      50%;

    transform:
      rotateX(68deg)
      rotateY(-18deg);

    box-shadow:
      0 0 30px rgba(34, 211, 238, 0.025);

    animation:
      orbit-spin 18s linear infinite;
  }


  .orbit-one {
    width:
      68%;

    height:
      68%;
  }


  .orbit-two {
    width:
      82%;

    height:
      44%;

    border-color:
      rgba(59, 130, 246, 0.16);

    animation-duration:
      24s;

    animation-direction:
      reverse;
  }


  .orbit-three {
    width:
      52%;

    height:
      88%;

    border-color:
      rgba(139, 92, 246, 0.12);

    animation-duration:
      28s;
  }


  @keyframes orbit-spin {
    from {
      transform:
        rotateX(68deg)
        rotateY(-18deg)
        rotateZ(0);
    }

    to {
      transform:
        rotateX(68deg)
        rotateY(-18deg)
        rotateZ(360deg);
    }
  }


  /* ========================================================
     AUTOMATION CORE
     ======================================================== */

  .automation-core {
    position:
      relative;

    width:
      42%;

    aspect-ratio:
      1;

    display:
      grid;

    place-items:
      center;

    border-radius:
      50%;

    background:
      radial-gradient(
        circle,
        rgba(34, 211, 238, 0.13),
        rgba(59, 130, 246, 0.06) 42%,
        transparent 70%
      );

    filter:
      drop-shadow(
        0 0 45px
        rgba(34, 211, 238, 0.15)
      );
  }


  .core-ring {
    position:
      absolute;

    inset:
      0;

    border:
      1px solid rgba(34, 211, 238, 0.25);

    border-radius:
      50%;
  }


  .core-ring-one {
    animation:
      core-ring-one 4s ease-in-out infinite;
  }


  .core-ring-two {
    inset:
      9%;

    border-color:
      rgba(59, 130, 246, 0.25);

    animation:
      core-ring-two 5s ease-in-out infinite;
  }


  .core-ring-three {
    inset:
      18%;

    border-color:
      rgba(139, 92, 246, 0.3);

    animation:
      core-ring-three 3s ease-in-out infinite;
  }


  @keyframes core-ring-one {
    0%,
    100% {
      transform:
        scale(0.95)
        rotate(0deg);

      opacity:
        0.4;
    }

    50% {
      transform:
        scale(1.06)
        rotate(180deg);

      opacity:
        0.9;
    }
  }


  @keyframes core-ring-two {
    0%,
    100% {
      transform:
        rotate(0deg);
    }

    50% {
      transform:
        rotate(-180deg);
    }
  }


  @keyframes core-ring-three {
    0%,
    100% {
      transform:
        scale(0.9);
    }

    50% {
      transform:
        scale(1.1);
    }
  }


  .core-inner {
    position:
      relative;

    width:
      52%;

    aspect-ratio:
      1;

    display:
      flex;

    flex-direction:
      column;

    align-items:
      center;

    justify-content:
      center;

    gap:
      0.8rem;

    border:
      1px solid rgba(34, 211, 238, 0.25);

    border-radius:
      50%;

    background:
      radial-gradient(
        circle at 40% 35%,
        rgba(34, 211, 238, 0.16),
        rgba(5, 7, 13, 0.92) 68%
      );

    box-shadow:
      inset 0 0 35px rgba(34, 211, 238, 0.07),
      0 0 40px rgba(34, 211, 238, 0.1);
  }


  .core-symbol {
    position:
      relative;

    width:
      2.5rem;

    height:
      2.5rem;
  }


  .core-symbol span {
    position:
      absolute;

    width:
      0.7rem;

    height:
      0.7rem;

    border:
      1px solid var(--color-cyan);

    border-radius:
      0.2rem;

    background:
      rgba(34, 211, 238, 0.08);

    box-shadow:
      0 0 12px rgba(34, 211, 238, 0.2);
  }


  .core-symbol span:nth-child(1) {
    top:
      0;

    left:
      0;
  }


  .core-symbol span:nth-child(2) {
    top:
      50%;

    left:
      50%;

    transform:
      translate(-50%, -50%);

    border-color:
      var(--color-violet);
  }


  .core-symbol span:nth-child(3) {
    right:
      0;

    bottom:
      0;
  }


  .core-label {
    color:
      var(--color-text-muted);

    font-family:
      var(--font-mono);

    font-size:
      0.55rem;

    letter-spacing:
      0.16em;
  }


  /* ========================================================
     FLOATING NODES
     ======================================================== */

  .floating-node {
    position:
      absolute;

    display:
      grid;

    place-items:
      center;

    width:
      clamp(3.5rem, 8vw, 4.8rem);

    aspect-ratio:
      1;

    border:
      1px solid rgba(148, 163, 184, 0.18);

    border-radius:
      1.1rem;

    background:
      rgba(13, 18, 31, 0.65);

    box-shadow:
      0 15px 40px rgba(0, 0, 0, 0.22),
      0 0 25px rgba(34, 211, 238, 0.05);

    backdrop-filter:
      blur(12px);

    -webkit-backdrop-filter:
      blur(12px);

    transform:
      rotate(-4deg);

    animation:
      floating-node 6s ease-in-out infinite;
  }


  .floating-icon {
    color:
      var(--color-cyan);

    font-family:
      var(--font-mono);

    font-size:
      0.65rem;

    font-weight:
      600;

    letter-spacing:
      0.04em;
  }


  .floating-node-one {
    top:
      16%;

    left:
      8%;
  }


  .floating-node-two {
    top:
      10%;

    right:
      13%;

    border-color:
      rgba(139, 92, 246, 0.25);

    animation-delay:
      -1.5s;
  }


  .floating-node-two .floating-icon {
    color:
      var(--color-violet-bright);
  }


  .floating-node-three {
    right:
      4%;

    bottom:
      21%;

    border-color:
      rgba(59, 130, 246, 0.25);

    animation-delay:
      -3s;
  }


  .floating-node-three .floating-icon {
    color:
      var(--color-blue-bright);
  }


  .floating-node-four {
    bottom:
      10%;

    left:
      13%;

    border-color:
      rgba(34, 197, 94, 0.2);

    animation-delay:
      -4s;
  }


  .floating-node-four .floating-icon {
    color:
      #4ade80;
  }


  @keyframes floating-node {
    0%,
    100% {
      transform:
        translate3d(0, 0, 0)
        rotate(-4deg);
    }

    50% {
      transform:
        translate3d(0, -12px, 0)
        rotate(3deg);
    }
  }


  /* ========================================================
     PARTICLES
     ======================================================== */

  .particle {
    position:
      absolute;

    width:
      0.18rem;

    height:
      0.18rem;

    border-radius:
      50%;

    background:
      var(--color-cyan);

    box-shadow:
      0 0 12px rgba(34, 211, 238, 0.7);

    animation:
      particle-float 7s ease-in-out infinite;
  }


  .particle-one {
    top:
      17%;

    right:
      34%;
  }


  .particle-two {
    top:
      29%;

    left:
      20%;

    animation-delay:
      -2s;
  }


  .particle-three {
    top:
      42%;

    right:
      6%;

    background:
      var(--color-violet);

    animation-delay:
      -4s;
  }


  .particle-four {
    bottom:
      28%;

    left:
      8%;

    animation-delay:
      -1s;
  }


  .particle-five {
    bottom:
      15%;

    right:
      30%;

    background:
      var(--color-blue);

    animation-delay:
      -3s;
