---
/**
 * ============================================================
 * HERO
 * ============================================================
 *
 * Primary portfolio introduction section.
 *
 * ============================================================
 */

import Button from "./Button.astro";
import Link from "./Link.astro";
import StatusIndicator from "./StatusIndicator.astro";
import Stack from "./Stack.astro";

interface Props {
  eyebrow?: string;

  title: string;

  highlightedTitle?: string;

  description: string;

  primaryLabel?: string;

  primaryHref?: string;

  secondaryLabel?: string;

  secondaryHref?: string;

  status?: string;

  statusVariant?:
    | "online"
    | "available"
    | "current"
    | "progress"
    | "complete"
    | "offline"
    | "warning";

  terminalTitle?: string;

  terminalLines?: string[];

  class?: string;
}

const {
  eyebrow = "HELLO, I'M",
  title,
  highlightedTitle,
  description,
  primaryLabel = "VIEW PROJECTS",
  primaryHref = "#projects",
  secondaryLabel = "CONTACT ME",
  secondaryHref = "#contact",
  status,
  statusVariant = "available",
  terminalTitle = "SYSTEM.STATUS",
  terminalLines = [
    "initializing portfolio...",
    "loading experience...",
    "loading projects...",
    "status: ready"
  ],
  class: className = ""
} = Astro.props;
---

<section
  class:list={[
    "hero",
    className
  ]}
>
  <div class="hero__grid">

    <div class="hero__content">

      <Stack gap="lg">

        {
          status && (
            <StatusIndicator
              label={status}
              variant={statusVariant}
            />
          )
        }


        <div class="hero__eyebrow">
          <span class="hero__eyebrow-line" />
          <span>{eyebrow}</span>
        </div>


        <h1 class="hero__title">
          {title}

          {
            highlightedTitle && (
              <>
                <br />

                <span class="hero__title-highlight">
                  {highlightedTitle}
                </span>
              </>
            )
          }
        </h1>


        <p class="hero__description">
          {description}
        </p>


        <div class="hero__actions">

          <Button
            href={primaryHref}
            label={primaryLabel}
            variant="primary"
            icon="arrow-down"
          />

          <Link
            href={secondaryHref}
            label={secondaryLabel}
            icon="arrow-right"
            variant="muted"
          />

        </div>

      </Stack>

    </div>


    <div class="hero__visual">

      <div class="hero__terminal">

        <div class="hero__terminal-bar">

          <div class="hero__terminal-dots">
            <span />
            <span />
            <span />
          </div>

          <span class="hero__terminal-title">
            {terminalTitle}
          </span>

        </div>


        <div class="hero__terminal-body">

          {
            terminalLines.map(
              (line, index) => (
                <div
                  class="hero__terminal-line"
                >
                  <span class="hero__terminal-index">
                    {String(index + 1).padStart(
                      2,
                      "0"
                    )}
                  </span>

                  <span
                    class:list={[
                      "hero__terminal-text",
                      {
                        "hero__terminal-text--success":
                          line.includes(
                            "ready"
                          ),
                        "hero__terminal-text--muted":
                          line.includes(
                            "..."
                          )
                      }
                    ]}
                  >
                    {line}
                  </span>
                </div>
              )
            )
          }


          <span
            class="hero__terminal-cursor"
            aria-hidden="true"
          />
        </div>

      </div>

    </div>

  </div>
</section>


<style>
  .hero {
    position: relative;

    display: flex;

    align-items: center;

    min-height:
      min(48rem, 82vh);

    padding:
      5rem 0 4rem;
  }


  .hero::before {
    content: "";

    position: absolute;

    z-index: -1;

    top: 10%;
    right: 0;

    width: 40rem;
    height: 40rem;

    border-radius: 999px;

    background:
      radial-gradient(
        circle,
        rgba(34, 211, 238, 0.08),
        transparent 68%
      );

    filter:
      blur(10px);

    pointer-events: none;
  }


  .hero__grid {
    display: grid;

    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(20rem, 0.85fr);

    align-items: center;

    gap:
      clamp(3rem, 8vw, 7rem);

    width: 100%;
  }


  /* ========================================================
     CONTENT
     ======================================================== */

  .hero__content {
    min-width: 0;

    max-width: 48rem;
  }


  .hero__eyebrow {
    display: flex;

    align-items: center;

    gap: 0.65rem;

    color:
      rgba(148, 163, 184, 0.78);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.65rem;

    font-weight: 700;

    letter-spacing: 0.16em;

    line-height: 1;

    text-transform: uppercase;
  }


  .hero__eyebrow-line {
    display: block;

    width: 2rem;
    height: 1px;

    background:
      #67e8f9;

    box-shadow:
      0 0 12px
      rgba(34, 211, 238, 0.3);
  }


  .hero__title {
    max-width: 11ch;

    margin: 0;

    color:
      #f8fafc;

    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      sans-serif;

    font-size:
      clamp(3.2rem, 8vw, 7rem);

    font-weight: 800;

    letter-spacing: -0.075em;

    line-height: 0.91;
  }


  .hero__title-highlight {
    color:
      #67e8f9;

    text-shadow:
      0 0 45px
      rgba(34, 211, 238, 0.12);
  }


  .hero__description {
    max-width: 38rem;

    margin: 0;

    color:
      rgba(148, 163, 184, 0.92);

    font-size:
      clamp(0.95rem, 1.6vw, 1.08rem);

    line-height: 1.8;
  }


  /* ========================================================
     ACTIONS
     ======================================================== */

  .hero__actions {
    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 1.25rem;
  }


  /* ========================================================
     TERMINAL
     ======================================================== */

  .hero__visual {
    display: flex;

    justify-content: flex-end;

    min-width: 0;
  }


  .hero__terminal {
    width: min(100%, 30rem);

    border:
      1px solid
      rgba(103, 232, 249, 0.14);

    border-radius:
      0.5rem;

    background:
      rgba(2, 6, 23, 0.78);

    box-shadow:
      0 30px 90px
      rgba(0, 0, 0, 0.35),
      0 0 60px
      rgba(34, 211, 238, 0.035);

    overflow: hidden;

    transform:
      perspective(900px)
      rotateY(-4deg);
  }


  .hero__terminal-bar {
    display: flex;

    align-items: center;

    gap: 0.8rem;

    min-height: 2.8rem;

    padding:
      0 0.9rem;

    border-bottom:
      1px solid
      rgba(148, 163, 184, 0.09);

    background:
      rgba(15, 23, 42, 0.55);
  }


  .hero__terminal-dots {
    display: flex;

    gap: 0.3rem;
  }


  .hero__terminal-dots span {
    display: block;

    width: 0.42rem;
    height: 0.42rem;

    border-radius: 999px;

    background:
      rgba(148, 163, 184, 0.3);
  }


  .hero__terminal-dots span:first-child {
    background:
      rgba(248, 113, 113, 0.75);
  }


  .hero__terminal-dots span:nth-child(2) {
    background:
      rgba(250, 204, 21, 0.75);
  }


  .hero__terminal-dots span:nth-child(3) {
    background:
      rgba(74, 222, 128, 0.75);
  }


  .hero__terminal-title {
    color:
      rgba(148, 163, 184, 0.55);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.58rem;

    font-weight: 700;

    letter-spacing: 0.1em;
  }


  .hero__terminal-body {
    position: relative;

    min-height: 18rem;

    padding:
      1.25rem;
  }


  .hero__terminal-line {
    display: grid;

    grid-template-columns: 1.8rem minmax(0, 1fr);

    gap: 0.8rem;

    padding:
      0.45rem 0;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 0.68rem;

    line-height: 1.5;
  }


  .hero__terminal-index {
    color:
      rgba(100, 116, 139, 0.45);

    user-select: none;
  }


  .hero__terminal-text {
    color:
      rgba(148, 163, 184, 0.85);
  }


  .hero__terminal-text--muted {
    color:
      rgba(100, 116, 139, 0.72);
  }


  .hero__terminal-text--success {
    color:
      #67e8f9;
  }


  .hero__terminal-cursor {
    display: inline-block;

    width: 0.45rem;
    height: 0.85rem;

    margin-top: 0.75rem;

    background:
      #67e8f9;

    box-shadow:
      0 0 10px
      rgba(34, 211, 238, 0.4);

    animation:
      hero-cursor 1s steps(1)
      infinite;
  }


  @keyframes hero-cursor {
    50% {
      opacity: 0;
    }
  }


  /* ========================================================
     RESPONSIVE
     ======================================================== */

  @media (max-width: 900px) {
    .hero {
      min-height: auto;

      padding:
        4rem 0 3rem;
    }


    .hero__grid {
      grid-template-columns: 1fr;

      gap: 3rem;
    }


    .hero__visual {
      justify-content: flex-start;
    }


    .hero__terminal {
      transform: none;
    }
  }


  @media (max-width: 640px) {
    .hero {
      padding:
        3rem 0 2.5rem;
    }


    .hero__title {
      max-width: 10ch;

      font-size:
        clamp(2.8rem, 15vw, 4.5rem);
    }


    .hero__actions {
      align-items: flex-start;

      flex-direction: column;
    }


    .hero__terminal {
      width: 100%;
    }
  }


  @media (prefers-reduced-motion: reduce) {
    .hero__terminal-cursor {
      animation: none;
    }
  }
</style>
