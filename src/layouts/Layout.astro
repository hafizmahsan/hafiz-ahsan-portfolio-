---
/**
 * ============================================================
 * GLOBAL PAGE LAYOUT
 * ============================================================
 *
 * Reusable document shell for the portfolio.
 *
 * Provides:
 * - HTML document structure
 * - SEO metadata
 * - Theme initialization
 * - Global stylesheet
 * - Favicon support
 * - Slot-based page content
 *
 * ============================================================
 */

import "../styles/global.css";

import { site } from "../data/site";

interface Props {
  title?: string;

  description?: string;

  image?: string;

  canonical?: string;
}

const {
  title = site.title,

  description = site.description,

  image = site.social?.image,

  canonical = site.url
} = Astro.props;


/**
 * ============================================================
 * PAGE TITLE
 * ============================================================
 */

const pageTitle =
  title;


/**
 * ============================================================
 * SOCIAL IMAGE
 * ============================================================
 */

const socialImage =
  image;


/**
 * ============================================================
 * FAVICON
 * ============================================================
 *
 * The favicon remains in its existing repository location.
 *
 * We do not move it into a public folder.
 *
 * If the favicon path is changed later, update only this
 * reference.
 * ============================================================
 */

const faviconPath =
  "/favicon.ico";
---

<!doctype html>

<html
  lang={site.language}
  data-theme={site.defaultTheme === "light" ? "light" : "dark"}
>

  <head>

    <!-- ======================================================
         BASIC DOCUMENT METADATA
         ====================================================== -->

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="author"
      content={site.author}
    />

    <meta
      name="theme-color"
      content={site.themeColor}
    />

    <meta
      name="robots"
      content="index, follow"
    />


    <!-- ======================================================
         TITLE
         ====================================================== -->

    <title>
      {pageTitle}
    </title>


    <!-- ======================================================
         KEYWORDS
         ====================================================== -->

    <meta
      name="keywords"
      content={site.keywords.join(", ")}
    />


    <!-- ======================================================
         CANONICAL
         ====================================================== -->

    <link
      rel="canonical"
      href={canonical}
    />


    <!-- ======================================================
         FAVICON
         ====================================================== -->

    <link
      rel="icon"
      href={faviconPath}
    />

    <link
      rel="shortcut icon"
      href={faviconPath}
    />


    <!-- ======================================================
         OPEN GRAPH
         ====================================================== -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonical}
    />

    {
      socialImage && (
        <meta
          property="og:image"
          content={socialImage}
        />
      )
    }


    <!-- ======================================================
         TWITTER / SOCIAL CARD
         ====================================================== -->

    <meta
      name="twitter:card"
      content={
        site.social?.twitterCard ??
        "summary_large_image"
      }
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    {
      socialImage && (
        <meta
          name="twitter:image"
          content={socialImage}
        />
      )
    }


    <!-- ======================================================
         THEME INITIALIZATION
         ======================================================
         
         This runs before the page becomes visible so the
         stored theme can be applied without an unnecessary
         visual flash.
         ====================================================== -->

    <script is:inline>
      (() => {

        try {

          const storedTheme =
            localStorage.getItem(
              "portfolio-theme"
            );

          if (
            storedTheme === "light" ||
            storedTheme === "dark"
          ) {

            document.documentElement.setAttribute(
              "data-theme",
              storedTheme
            );

            return;
          }


          const prefersLight =
            window.matchMedia(
              "(prefers-color-scheme: light)"
            ).matches;


          document.documentElement.setAttribute(
            "data-theme",
            prefersLight
              ? "light"
              : "dark"
          );

        } catch {

          document.documentElement.setAttribute(
            "data-theme",
            "dark"
          );

        }

      })();
    </script>

  </head>


  <body id="top">

    <!-- ======================================================
         PAGE CONTENT
         ====================================================== -->

    <slot />


    <!-- ======================================================
         PAGE READY FLAG
         ====================================================== -->

    <script>
      document.documentElement.setAttribute(
        "data-page-ready",
        "true"
      );
    </script>

  </body>

</html>


<style>
  /**
   * ==========================================================
   * LAYOUT FOUNDATION
   * ==========================================================
   */

  :global(body) {
    min-height:
      100vh;

    background:
      var(--color-background);

    color:
      var(--color-text);
  }


  /**
   * Prevent accidental horizontal overflow from individual
   * components.
   */

  :global(#top) {
    overflow-x:
      hidden;
  }


  /**
   * Ensure the main content begins beneath the fixed header
   * without forcing every individual page section to manage
   * the offset.
   */

  :global(main) {
    position:
      relative;

    z-index:
      1;
  }
</style>
