---
/**
 * ============================================================
 * GLOBAL PORTFOLIO LAYOUT
 * ============================================================
 *
 * Shared HTML shell for the portfolio.
 *
 * Responsibilities:
 *
 * - SEO metadata
 * - Canonical URL
 * - Open Graph metadata
 * - Twitter / X metadata
 * - Favicon
 * - Theme initialization
 * - Accessibility foundation
 * - Global document structure
 * - Structured data
 *
 * DESIGN/CSS DOES NOT BELONG HERE.
 *
 * Visual styles are maintained separately.
 * ============================================================
 */

import { siteConfig } from "../data/site";
import { seoConfig } from "../data/seo";
import "../styles/global.css";

type Props = {
  /**
   * Page-specific title.
   *
   * If omitted, the global SEO title is used.
   */
  title?: string;

  /**
   * Page-specific description.
   */
  description?: string;

  /**
   * Allows individual pages to override
   * the canonical URL.
   */
  canonical?: string;

  /**
   * Optional Open Graph image.
   */
  image?: string;

  /**
   * Optional Open Graph image description.
   */
  imageAlt?: string;

  /**
   * Allows a page to explicitly request
   * a different document type.
   */
  ogType?: "website" | "profile";
};


const {
  title = seoConfig.title,

  description =
    seoConfig.description,

  canonical =
    seoConfig.canonicalUrl,

  image =
    seoConfig.openGraph.image,

  imageAlt =
    seoConfig.openGraph.imageAlt,

  ogType =
    seoConfig.openGraph.type
} = Astro.props;


/**
 * ============================================================
 * ABSOLUTE IMAGE URL
 * ============================================================
 *
 * Convert relative asset paths into absolute URLs.
 *
 * This is particularly useful for Open Graph images.
 * ============================================================
 */

const absoluteImageUrl =
  image.startsWith("http")
    ? image
    : new URL(
        image,
        seoConfig.canonicalUrl
      ).toString();


/**
 * ============================================================
 * PAGE TITLE
 * ============================================================
 */

const pageTitle =
  title === seoConfig.title
    ? title
    : seoConfig.titleTemplate.replace(
        "%s",
        title
      );


/**
 * ============================================================
 * TWITTER IMAGE
 * ============================================================
 */

const absoluteTwitterImage =
  seoConfig.twitter.image.startsWith(
    "http"
  )
    ? seoConfig.twitter.image
    : new URL(
        seoConfig.twitter.image,
        seoConfig.canonicalUrl
      ).toString();
---


<!doctype html>

<html
  lang={seoConfig.language}
  data-theme={
    siteConfig.appearance.defaultTheme
  }
>

  <head>

    <!-- ======================================================
         CHARACTER ENCODING
         ====================================================== -->

    <meta charset="UTF-8" />


    <!-- ======================================================
         VIEWPORT
         ====================================================== -->

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />


    <!-- ======================================================
         PRIMARY SEO
         ====================================================== -->

    <title>
      {pageTitle}
    </title>


    <meta
      name="description"
      content={description}
    />


    <meta
      name="author"
      content={seoConfig.author}
    />


    <meta
      name="keywords"
      content={seoConfig.keywords.join(", ")}
    />


    <meta
      name="robots"
      content={seoConfig.robots}
    />


    <meta
      name="theme-color"
      content="#020617"
    />


    <meta
      name="color-scheme"
      content="dark light"
    />


    <!-- ======================================================
         CANONICAL URL
         ====================================================== -->

    <link
      rel="canonical"
      href={canonical}
    />


    <!-- ======================================================
         FAVICON
         ====================================================== -->

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />


    <link
      rel="apple-touch-icon"
      href="/favicon.svg"
    />


    <!-- ======================================================
         OPEN GRAPH
         ====================================================== -->

    <meta
      property="og:type"
      content={ogType}
    />


    <meta
      property="og:title"
      content={pageTitle}
    />


    <meta
      property="og:description"
      content={description}
    />


    <meta
      property="og:url"
      content={canonical}
    />


    <meta
      property="og:site_name"
      content={siteConfig.siteName}
    />


    <meta
      property="og:image"
      content={absoluteImageUrl}
    />


    <meta
      property="og:image:alt"
      content={imageAlt}
    />


    <!-- ======================================================
         TWITTER / X CARD
         ====================================================== -->

    <meta
      name="twitter:card"
      content={seoConfig.twitter.card}
    />


    <meta
      name="twitter:title"
      content={pageTitle}
    />


    <meta
      name="twitter:description"
      content={description}
    />


    <meta
      name="twitter:image"
      content={absoluteTwitterImage}
    />


    <!-- ======================================================
         PERFORMANCE / CONNECTION HINTS
         ====================================================== -->

    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />


    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />


    <!-- ======================================================
         STRUCTURED DATA
         ====================================================== -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",

        "@type": "Person",

        name:
          seoConfig.structuredData.personName,

        jobTitle:
          seoConfig.structuredData.jobTitle,

        description:
          seoConfig.structuredData.description,

        url:
          seoConfig.structuredData.url,

        areaServed:
          seoConfig.structuredData.areaServed,

        knowsAbout:
          seoConfig.structuredData.knowsAbout,

        worksFor: {
          "@type":
            seoConfig
              .structuredData
              .worksFor
              .type,

          name:
            seoConfig
              .structuredData
              .worksFor
              .name
        },

        sameAs: [
          "https://github.com/hafizmahsan"
        ]
      })}
    />


    <!-- ======================================================
         THEME INITIALIZATION
         ======================================================

         Executes before the page becomes visible.

         This prevents a flash of the wrong theme when a
         previously selected theme exists in localStorage.

         ====================================================== -->

    <script is:inline>
      (() => {
        try {
          const savedTheme =
            localStorage.getItem(
              "hafiz-portfolio-theme"
            );

          const systemPrefersLight =
            window.matchMedia(
              "(prefers-color-scheme: light)"
            ).matches;

          const theme =
            savedTheme === "light" ||
            savedTheme === "dark"
              ? savedTheme
              : systemPrefersLight
                ? "light"
                : "dark";

          document.documentElement.dataset.theme =
            theme;

        } catch {
          document.documentElement.dataset.theme =
            "dark";
        }
      })();
    </script>


    <!-- ======================================================
         PAGE-SPECIFIC HEAD CONTENT
         ====================================================== -->

    <slot name="head" />

  </head>


  <body>

    <!-- ======================================================
         ACCESSIBILITY
         ====================================================== -->

    <a
      class="skip-link"
      href="#main-content"
    >
      Skip to main content
    </a>


    <!-- ======================================================
         GLOBAL PAGE CONTAINER
         ====================================================== -->

    <div id="site-root">
      <slot />
    </div>


    <!-- ======================================================
         GLOBAL JAVASCRIPT HOOK
         ====================================================== -->

    <slot name="scripts" />

  </body>

</html>
