---
/**
 * ============================================================
 * HOMEPAGE
 * ============================================================
 *
 * Main portfolio composition.
 *
 * ============================================================
 */

import AboutSection from "../components/AboutSection.astro";
import ContactSection from "../components/ContactSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Hero from "../components/Hero.astro";
import PageShell from "../components/PageShell.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import SkillsSection from "../components/SkillsSection.astro";

import { portfolio } from "../data/portfolio";
---

<PageShell>

  <Hero
    eyebrow={portfolio.hero.eyebrow}
    title={portfolio.hero.title}
    highlightedTitle={
      portfolio.hero.highlightedTitle
    }
    description={portfolio.hero.description}
    primaryAction={{
      label: "VIEW MY WORK",
      href: "#projects"
    }}
    secondaryAction={{
      label: "GET IN TOUCH",
      href: "#contact"
    }}
  />


  <AboutSection
    number={portfolio.about.number}
    eyebrow={portfolio.about.eyebrow}
    title={portfolio.about.title}
    description={portfolio.about.description}
  />


  <ProjectsSection
    projects={portfolio.projects}
  />


  <ExperienceSection
    entries={portfolio.experience}
  />


  <SkillsSection
    groups={portfolio.skills}
  />


  <ContactSection
    number={portfolio.contact.number}
    eyebrow={portfolio.contact.eyebrow}
    title={portfolio.contact.title}
    description={portfolio.contact.description}
    email={portfolio.contact.email}
    availability={
      portfolio.contact.availability
    }
    links={portfolio.contact.links}
  />

</PageShell>
